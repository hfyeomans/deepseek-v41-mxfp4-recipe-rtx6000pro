index 00000000..aa3f3902
--- /dev/null
+++ b/python/sglang/srt/layers/attention/dsv4/step_fingerprint.py
@@ -0,0 +1,148 @@
+"""Per-step, per-layer decode fingerprints for localising run-to-run drift (recipe T3.15e).
+
+Opt-in with ``SGLANG_DSV41_STEP_FINGERPRINT_DIR=<dir>``; off, every hook is one
+``is None`` test. When on, each decode step records, for every attention layer,
+order-independent integer fingerprints (bit-pattern sum and sum of squares, so the
+value does not depend on the reduction order of the fingerprint itself) of the
+attention query and output, the sparse KV slot list, the indexer logits (row 0,
+masked to its sequence length), the selected logical positions and the indexer
+input. All records are device ops into a fixed buffer indexed by a device step
+counter, so they replay inside the decode CUDA graphs; the counter advances once
+per decode step outside the graph. A background thread snapshots the buffer to
+``<dir>/rank<r>.pt`` every few seconds. ``scripts/fingerprint-diff.py`` in the
+recipe aligns repeats of one prompt and names the first (step, layer, stage)
+that differs.
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+import threading
+import time
+from typing import Optional
+
+import torch
+
+from sglang.srt.environ import envs
+
+logger = logging.getLogger(__name__)
+
+COLUMNS = (
+    "q_sum", "q_sq",            # attention query, this rank's heads
+    "o_sum", "o_sq",            # attention output, this rank's heads
+    "slots_sum", "slots_sq",    # sparse KV slot list fed to attention (allocator-dependent)
+    "logits_sum", "logits_sq",  # indexer logits row 0 after two_level_decode_logits, masked to seq_len
+    "sel_sum", "sel_sq",        # selected logical positions (sorted), row 0
+    "x_sum", "x_sq",            # indexer input hidden state
+    "seq_len", "bs",            # row 0 c4 seq_len (request boundary marker), batch size
+)
+_COL = {name: i for i, name in enumerate(COLUMNS)}
+MAX_STEPS = 8192
+MAX_LAYERS = 64
+_INT_OF_SIZE = {1: torch.int8, 2: torch.int16, 4: torch.int32, 8: torch.int64}
+
+
+def _bits(t: torch.Tensor) -> torch.Tensor:
+    t = t.detach()
+    if not t.is_contiguous():
+        t = t.contiguous()
+    return t.view(_INT_OF_SIZE[t.element_size()]).reshape(-1).to(torch.int64)
+
+
+def _pair(v: torch.Tensor) -> torch.Tensor:
+    # int64 wraps on overflow; the sum stays exact modulo 2^64 and order-independent.
+    return torch.stack([v.sum(), (v * v).sum()])
+
+
+class StepFingerprints:
+    def __init__(self, out_dir: str, device: torch.device):
+        self.out_dir = out_dir
+        self.buf = torch.zeros((MAX_STEPS, MAX_LAYERS, len(COLUMNS)), dtype=torch.int64, device=device)
+        self.step = torch.zeros((), dtype=torch.int64, device=device)
+        self._flat = self.buf.view(-1)
+        self._stride_step = MAX_LAYERS * len(COLUMNS)
+        self._host_step = 0
+        self._dumped_step = -1
+        self._lock = threading.Lock()
+        try:
+            self.rank = torch.distributed.get_rank() if torch.distributed.is_initialized() else 0
+        except Exception:
+            self.rank = 0
+        os.makedirs(out_dir, exist_ok=True)
+        self._stop = False
+        self._thread = threading.Thread(target=self._dump_loop, name="dsv41-fingerprint-dump", daemon=True)
+        self._thread.start()
+        logger.info("step fingerprints on: %s rank %d (%d steps x %d layers x %d columns)",
+                    out_dir, self.rank, MAX_STEPS, MAX_LAYERS, len(COLUMNS))
+
+    # ---- out-of-graph, once per decode step ------------------------------------------
+    def advance(self) -> None:
+        if self._host_step + 1 >= MAX_STEPS:
+            return
+        self._host_step += 1
+        self.step.fill_(self._host_step)
+
+    # ---- in-graph records -------------------------------------------------------------
+    def _put(self, layer_id: int, col: str, pair: torch.Tensor) -> None:
+        if layer_id >= MAX_LAYERS:
+            return
+        base = self.step * self._stride_step + (layer_id * len(COLUMNS) + _COL[col])
+        idx = base + torch.arange(2, device=pair.device, dtype=torch.int64)
+        self._flat.index_copy_(0, idx, pair)
+
+    def record(self, layer_id: int, col: str, t: Optional[torch.Tensor]) -> None:
+        if t is None:
+            return
+        self._put(layer_id, col, _pair(_bits(t)))
+
+    def record_row0_masked(self, layer_id: int, col: str, t: torch.Tensor, seq_lens: torch.Tensor) -> None:
+        """Row 0 of a [bs, L] tensor, positions >= seq_lens[0] zeroed (padding may be garbage)."""
+        v = _bits(t[0])
+        pos = torch.arange(v.numel(), device=v.device, dtype=torch.int64)
+        v = torch.where(pos < seq_lens[0].to(torch.int64), v, torch.zeros_like(v))
+        self._put(layer_id, col, _pair(v))
+
+    def record_scalar(self, layer_id: int, col: str, value: torch.Tensor | int) -> None:
+        if layer_id >= MAX_LAYERS:
+            return
+        v = torch.as_tensor(value, device=self.buf.device, dtype=torch.int64).reshape(1)
+        idx = (self.step * self._stride_step + (layer_id * len(COLUMNS) + _COL[col])).reshape(1)
+        self._flat.index_copy_(0, idx, v)
+
+    # ---- background snapshot ------------------------------------------------------------
+    def _dump_loop(self) -> None:
+        stream = torch.cuda.Stream(device=self.buf.device)
+        path = os.path.join(self.out_dir, f"rank{self.rank}.pt")
+        tmp = path + ".tmp"
+        while not self._stop:
+            time.sleep(3.0)
+            n = self._host_step
+            if n == self._dumped_step:
+                continue
+            try:
+                with torch.cuda.stream(stream):
+                    snap = self.buf[: n + 1].to("cpu", copy=True)
+                stream.synchronize()
+                torch.save({"columns": COLUMNS, "steps": n + 1, "rank": self.rank, "buf": snap}, tmp)
+                os.replace(tmp, path)
+                self._dumped_step = n
+            except Exception as e:  # diagnostic only: never take the server down
+                logger.warning("step fingerprint dump failed: %r", e)
+
+
+_FP: Optional[StepFingerprints] = None
+_RESOLVED = False
+
+
+def get_step_fingerprints(device: Optional[torch.device] = None) -> Optional[StepFingerprints]:
+    global _FP, _RESOLVED
+    if _RESOLVED:
+        return _FP
+    out_dir = envs.SGLANG_DSV41_STEP_FINGERPRINT_DIR.get()
+    if out_dir and device is not None:
+        _FP = StepFingerprints(out_dir, device)
+        _RESOLVED = True
+    elif not out_dir:
+        _RESOLVED = True
+    return _FP
