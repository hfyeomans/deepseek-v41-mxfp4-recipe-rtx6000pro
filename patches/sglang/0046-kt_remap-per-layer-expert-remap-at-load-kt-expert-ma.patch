diff --git a/python/sglang/srt/layers/moe/kt_remap.py b/python/sglang/srt/layers/moe/kt_remap.py
new file mode 100644
index 00000000..640e382d
--- /dev/null
+++ b/python/sglang/srt/layers/moe/kt_remap.py
@@ -0,0 +1,199 @@
+"""Per-layer routed-expert remap at load for the hybrid's expert placement (recipe T3.8b).
+
+The hybrid splits each MoE layer's routed experts positionally: physical ids
+``[0, num_gpu_experts)`` live on the GPUs, the rest run on the CPU through
+kt-kernel (``kt_ep_wrapper.py``). Routing is skewed (T3.8: half of a layer's
+routes land in 20-32 of its 384 experts), so *which* checkpoint experts hold
+the low ids decides how many routes the CPU tier serves per token. An
+``ExpertRemap`` permutes each layer's experts at load so that a chosen hot
+set takes the GPU ids:
+
+  * physical slot ``p`` holds checkpoint expert ``perm[layer][p]``: the
+    FusedMoE weight loader sees ``experts.<inv[e]>`` for checkpoint tensor
+    ``experts.<e>`` (``remap_weight``), and the compact kt loader is handed the
+    checkpoint ids of the CPU slots in physical order (``cpu_checkpoint_ids``);
+  * the gate's logit columns and both correction biases are permuted the same
+    way, so logit column ``p`` scores the expert that slot ``p`` holds.
+
+Everything downstream (``topk_ids >= num_gpu_experts``, the streamed prefill,
+the deferral ledger, the expert-distribution recorder) keeps its positional
+contract and simply sees a model whose experts are numbered differently. The
+routing decision itself is unchanged up to top-k tie order (no expert
+grouping in DeepSeek-V4.1: ``noaux_tc`` with a plain top-k over 384 scores),
+so the permutation is exact; what moves is which experts run on which tier.
+
+Map file (JSON)::
+
+    {"num_experts": 384, "num_gpu_experts": 219, "source": "...",
+     "gpu": {"0": [219 checkpoint ids], ..., "39": [...]}}
+
+``gpu[layer]`` lists the checkpoint experts that take the GPU slots of that
+layer; they are placed in ascending id order, followed by the remaining
+experts in ascending id order. A layer absent from the file keeps the
+identity order. ``num_experts`` and ``num_gpu_experts`` must match the served
+configuration; the file is refused otherwise, as is any duplicate or
+out-of-range id.
+"""
+
+from __future__ import annotations
+
+import functools
+import json
+import re
+from dataclasses import dataclass
+from typing import Dict, Optional, Tuple
+
+import torch
+
+from sglang.srt.layers.moe.kt_contract import KTContractError
+
+# Names as produced by DeepseekV4ForCausalLM.remap_weight_name_to_dpsk_hf_format.
+_EXPERT_RE = re.compile(r"^model\.layers\.(\d+)\.mlp\.experts\.(\d+)\.(.+)$")
+_GATE_RE = re.compile(
+    r"^model\.layers\.(\d+)\.mlp\.gate\."
+    r"(weight|e_score_correction_bias|e_score_correction_bias_vl)$"
+)
+_HASH_GATE_RE = re.compile(r"^model\.layers\.(\d+)\.mlp\.(gate|topk)\.tid2eid$")
+
+
+@dataclass(frozen=True)
+class ExpertRemap:
+    num_experts: int
+    num_gpu_experts: int
+    source: str
+    # layer -> (perm, inv): perm[p] = checkpoint id held by physical slot p,
+    # inv[e] = physical slot of checkpoint expert e.
+    layers: Dict[int, Tuple[Tuple[int, ...], Tuple[int, ...]]]
+
+    @classmethod
+    def from_gpu_sets(
+        cls,
+        gpu_sets: Dict[int, list],
+        num_experts: int,
+        num_gpu_experts: int,
+        source: str = "",
+    ) -> "ExpertRemap":
+        layers = {}
+        for layer, hot in gpu_sets.items():
+            hot = [int(e) for e in hot]
+            if len(hot) != num_gpu_experts:
+                raise KTContractError(
+                    f"expert map {source!r}: layer {layer} lists {len(hot)} GPU experts, "
+                    f"num_gpu_experts is {num_gpu_experts}"
+                )
+            if len(set(hot)) != len(hot) or min(hot) < 0 or max(hot) >= num_experts:
+                raise KTContractError(
+                    f"expert map {source!r}: layer {layer} has duplicate or out-of-range "
+                    f"expert ids (num_experts {num_experts})"
+                )
+            hot_set = set(hot)
+            perm = tuple(sorted(hot)) + tuple(
+                e for e in range(num_experts) if e not in hot_set
+            )
+            inv = [0] * num_experts
+            for p, e in enumerate(perm):
+                inv[e] = p
+            layers[int(layer)] = (perm, tuple(inv))
+        return cls(
+            num_experts=num_experts,
+            num_gpu_experts=num_gpu_experts,
+            source=source,
+            layers=layers,
+        )
+
+    @classmethod
+    def from_file(
+        cls, path: str, num_experts: int, num_gpu_experts: int
+    ) -> "ExpertRemap":
+        with open(path) as f:
+            doc = json.load(f)
+        for key, want in (("num_experts", num_experts), ("num_gpu_experts", num_gpu_experts)):
+            if int(doc.get(key, -1)) != want:
+                raise KTContractError(
+                    f"expert map {path}: {key} is {doc.get(key)!r}, the server runs {want}"
+                )
+        gpu = doc.get("gpu")
+        if not isinstance(gpu, dict) or not gpu:
+            raise KTContractError(f"expert map {path}: no 'gpu' layer -> ids table")
+        return cls.from_gpu_sets(
+            {int(k): v for k, v in gpu.items()},
+            num_experts,
+            num_gpu_experts,
+            source=str(doc.get("source", path)),
+        )
+
+    def is_remapped(self, layer: int) -> bool:
+        return layer in self.layers
+
+    def perm(self, layer: int) -> Tuple[int, ...]:
+        """Checkpoint id held by each physical slot (identity if not remapped)."""
+        if layer in self.layers:
+            return self.layers[layer][0]
+        return tuple(range(self.num_experts))
+
+    def cpu_checkpoint_ids(self, layer: int) -> Tuple[int, ...]:
+        """Checkpoint ids of the CPU slots, in physical (compact kt) order."""
+        return self.perm(layer)[self.num_gpu_experts :]
+
+    def remap_weight(
+        self, name: str, loaded_weight: torch.Tensor
+    ) -> Tuple[str, torch.Tensor]:
+        """Rename an expert tensor / permute a gate tensor of a remapped layer.
+
+        Call on every checkpoint tensor after the HF-name remap and before any
+        other renaming (the fused shared expert is renamed to
+        ``experts.<num_experts>`` later and must not pass through here).
+        """
+        m = _EXPERT_RE.match(name)
+        if m is not None:
+            layer, ckpt_id = int(m.group(1)), int(m.group(2))
+            if layer not in self.layers:
+                return name, loaded_weight
+            if ckpt_id >= self.num_experts:
+                raise KTContractError(
+                    f"{name}: expert id {ckpt_id} outside the {self.num_experts} routed "
+                    "experts the map covers (fused shared expert renamed too early?)"
+                )
+            slot = self.layers[layer][1][ckpt_id]
+            return f"model.layers.{layer}.mlp.experts.{slot}.{m.group(3)}", loaded_weight
+        m = _GATE_RE.match(name)
+        if m is not None:
+            layer = int(m.group(1))
+            if layer not in self.layers:
+                return name, loaded_weight
+            if loaded_weight.shape[0] != self.num_experts:
+                raise KTContractError(
+                    f"{name}: dim 0 is {loaded_weight.shape[0]}, expected {self.num_experts}"
+                )
+            idx = torch.tensor(self.layers[layer][0], dtype=torch.long)
+            return name, loaded_weight[idx].contiguous()
+        m = _HASH_GATE_RE.match(name)
+        if m is not None and int(m.group(1)) in self.layers:
+            raise KTContractError(
+                f"{name}: hash-routed layer cannot be remapped (tid2eid maps tokens to "
+                "checkpoint expert ids)"
+            )
+        return name, loaded_weight
+
+
+@functools.lru_cache(maxsize=None)
+def load_cached(
+    path: Optional[str], num_experts: int, num_gpu_experts: int
+) -> Optional[ExpertRemap]:
+    """The server's remap (None when no map is configured); one parse per process."""
+    if not path:
+        return None
+    return ExpertRemap.from_file(path, num_experts, num_gpu_experts)
+
+
+def current(num_experts: int) -> Optional[ExpertRemap]:
+    """The remap for the served configuration, from the exec config."""
+    from sglang.srt.runtime_context import get_exec
+
+    moe = get_exec().moe
+    path = getattr(moe, "kt_expert_map", None)
+    if not path:
+        return None
+    if moe.kt_weight_path is None or moe.kt_num_gpu_experts is None:
+        raise KTContractError("--kt-expert-map needs --kt-weight-path and --kt-num-gpu-experts")
+    return load_cached(path, num_experts, int(moe.kt_num_gpu_experts))
