MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

capture_cuda_graphs registers kt-kernel buffer sizes before EagerRunner runs the
FlashInfer-autotune dummy forward at max_bs, so that allocation is graph-owned from
the start instead of living in the temp slot and being promoted later (E23 R3 FIX 1).
The no-capture early-outs of capture_decode_graph move to a shared helper so both
agree. DecodeCudaGraphRunner.capture() logs captured/registered/cached and asserts
coverage on the target rank.

Amp-Thread-ID: https://ampcode.com/threads/T-01a0c10b-a5f8-77fc-b238-7147d12ccf29
Co-authored-by: Amp <amp@ampcode.com>
---
 .../cuda_graph_setup.py                       | 85 +++++++++++++++----
 .../runner/decode_cuda_graph_runner.py        | 36 ++++++++
 2 files changed, 103 insertions(+), 18 deletions(-)

diff --git a/python/sglang/srt/model_executor/model_runner_components/cuda_graph_setup.py b/python/sglang/srt/model_executor/model_runner_components/cuda_graph_setup.py
index 56d51d7d..b94c351b 100644
--- a/python/sglang/srt/model_executor/model_runner_components/cuda_graph_setup.py
+++ b/python/sglang/srt/model_executor/model_runner_components/cuda_graph_setup.py
@@ -168,6 +168,16 @@ def capture_cuda_graphs(
         model_runner
     )
 
+    # kt-kernel keys its pinned CPU-expert buffers on the token count and only
+    # gives a size a permanent owner once it is registered. The EagerRunner
+    # below runs the FlashInfer-autotune dummy forward at max_bs BEFORE the
+    # decode graph runner exists, so without this call that forward lands in
+    # the single temp slot and the decode runner later has to promote it
+    # ("KT_BUF promote temp buffer", E23 R3 FIX 1). Registering first makes
+    # the autotune allocation the graph-owned tuple from the start.
+    if capture_decode_cuda_graph:
+        register_kt_capture_sizes(model_runner)
+
     # The eager (no-cuda-graph) phase runner, built AFTER the attention
     # backend so its __init__ can warm up kernels (run-once) and allocate the
     # fixed-max static buffer — both before the cuda-graph runners, so that
@@ -488,6 +498,58 @@ def capture_prefill_graph(
     return result(prefill_runner, mem_usage, capture_time)
 
 
+def _decode_graph_capture_disabled(model_runner: ModelRunner) -> bool:
+    """The no-capture early-outs of capture_decode_graph, shared with the
+    kt-kernel pre-registration so both agree on whether a decode graph exists."""
+    if (
+        model_runner.spec_algorithm.is_speculative()
+        and not model_runner.is_draft_worker
+        and get_disagg().disaggregation_mode == "prefill"
+    ):
+        return True
+    if not model_runner.is_generation:
+        return True
+    if model_runner.server_args.model_impl.lower() == ModelImpl.MINDSPORE:
+        return True
+    if model_runner.device != "cpu" and check_cuda_graph_backend(
+        Phase.DECODE, Backend.DISABLED
+    ):
+        return True
+    if model_runner.device == "cpu" and not get_flags().capture.enable_torch_compile:
+        return True
+    return False
+
+
+def kt_capture_token_sizes(model_runner: ModelRunner) -> list[int]:
+    """Token counts (bs * tokens-per-request) the decode/verify graph runner will
+    capture; the key space of kt-kernel's pinned CPU-expert buffers."""
+    if model_runner.spec_algorithm.is_speculative():
+        num_tokens_per_req = model_runner.decode_num_tokens_per_req()
+    else:
+        num_tokens_per_req = 1
+    capture_bs, _ = get_batch_sizes_to_capture(model_runner, num_tokens_per_req)
+    return sorted({bs * num_tokens_per_req for bs in capture_bs})
+
+
+def register_kt_capture_sizes(model_runner: ModelRunner) -> None:
+    """Register the decode-graph token counts with kt-kernel before any warmup
+    or autotune forward runs (recipe T3.16c).
+
+    Registration merges (kt-kernel patch 0002), so the DecodeCudaGraphRunner
+    registering the same sizes again in its __init__ is a no-op; a runner that
+    resolves a different width (adaptive speculation) adds to the set.
+    """
+    if model_runner.is_draft_worker or model_runner.device != "cuda":
+        return
+    try:
+        from kt_kernel import KTMoEWrapper
+    except ImportError:
+        return
+    if _decode_graph_capture_disabled(model_runner):
+        return
+    KTMoEWrapper.set_capture_batch_sizes(kt_capture_token_sizes(model_runner))
+
+
 def capture_decode_graph(*, model_runner: ModelRunner) -> GraphCapture:
     """Capture device graphs."""
     if model_runner.is_draft_worker:
@@ -503,24 +565,11 @@ def capture_decode_graph(*, model_runner: ModelRunner) -> GraphCapture:
