--- a/python/sglang/srt/model_executor/runner/decode_cuda_graph_runner.py
+++ b/python/sglang/srt/model_executor/runner/decode_cuda_graph_runner.py
@@ -1206,6 +1206,42 @@ class DecodeCudaGraphRunner(BaseCudaGraphRunner):
                                 bs, forward, stream_idx, variant_label, dsa_variant
                             )
         _set_capture_dsa_variant(None)
+        self._check_kt_capture_buffers()
+
+    def _check_kt_capture_buffers(self) -> None:
+        """T3.16c: after capture, every token count this runner captured must be
+        registered with kt-kernel and, when the CPU-expert path is active on this
+        rank, owned by kt-kernel's permanent capture cache (never the temp slot).
+        Draft runners reuse capture() without __init__, so they are skipped."""
+        if not KTRANSFORMERS_AVAILABLE or self.model_runner.is_draft_worker:
+            return
+        if getattr(self, "captured_req_width", None) is None:
+            return
+        from kt_kernel.experts_base import KExpertsCPUBuffer
+
+        expected = sorted({bs * self.captured_req_width for bs in self.capture_bs})
+        registered = sorted(KTMoEWrapper.get_capture_batch_sizes())
+        cached = sorted(KExpertsCPUBuffer.capture_buffers)
+        logger.info(
+            "KT_BUF post-capture: captured=%s registered=%s cached=%s temp_bs=%s",
+            expected,
+            registered,
+            cached,
+            KExpertsCPUBuffer.temp_bs,
+        )
+        missing = sorted(set(expected) - set(registered))
+        assert not missing, (
+            f"KT_BUF captured token counts {missing} were never registered with "
+            f"kt-kernel (registered={registered})"
+        )
+        if cached:
+            # kt CPU experts ran on this rank during capture, so each captured
+            # size must have been allocated straight into the capture cache.
+            uncached = sorted(set(expected) - set(cached))
+            assert not uncached, (
+                f"KT_BUF captured token counts {uncached} have no graph-owned kt "
+                f"buffer (cached={cached}); a graph baked the temp slot"
+            )
 
     def capture_one_shape(
