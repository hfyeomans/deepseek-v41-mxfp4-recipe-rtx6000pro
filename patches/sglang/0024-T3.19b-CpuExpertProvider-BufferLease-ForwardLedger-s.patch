@@ -144,3 +150,46 @@ def check_moe_boundary(
             raise KTContractError(
                 f"{where}{name} on {t.device} but hidden_states on {hidden_states.device}."
             )
+
+
+def check_deferral_adjacency(*, outstanding_for_layer: Optional[int], layer_idx: int) -> None:
+    """Refuse a submission that would skip or re-consume an outstanding deferred slot.
+
+    ``outstanding_for_layer`` is the layer that must consume the slot the previous
+    layer's deferred task is filling (previous layer + 1), or None when no deferred
+    task is outstanding. Submitting any other layer means the slot would be
+    accumulated into the wrong layer's output (kt's slot is keyed by layer parity,
+    not layer index) or consumed twice.
+    """
+    if outstanding_for_layer is not None and outstanding_for_layer != layer_idx:
+        raise KTContractError(
+            f"layer {layer_idx}: submitted while layer {outstanding_for_layer} must consume the "
+            f"deferred slot written by layer {outstanding_for_layer - 1}; deferred experts are only "
+            "valid across adjacent MoE layers of one forward."
+        )
+
+
+def check_forward_boundary(
+    *,
+    outstanding_for_layer: Optional[int],
+    pending_flags: Mapping[int, bool],
+    last_layer_idx: int,
+) -> None:
+    """Refuse to end a forward with a deferred slot still outstanding.
+
+    Two views must agree: the orchestration's ledger (``outstanding_for_layer``) and
+    kt-kernel's own per-layer flag dict (``pending_flags``). A pending flag on the
+    last MoE layer means its deferred experts would be added into the first MoE
+    layer of the *next* forward (the slot parity wraps), which is the D=0 rule for
+    the last layer being violated.
+    """
+    if outstanding_for_layer is not None:
+        raise KTContractError(
+            f"forward ended with layer {outstanding_for_layer - 1}'s deferred slot outstanding "
+            f"(consumer layer {outstanding_for_layer} never submitted)."
+        )
+    if bool(pending_flags.get(last_layer_idx, False)):
+        raise KTContractError(
+            f"forward ended with kt reporting a pending deferred task on the last MoE layer "
+            f"{last_layer_idx}; the last layer must run with max_deferred_experts_per_token=0."
+        )
