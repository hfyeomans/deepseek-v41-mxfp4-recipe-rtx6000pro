diff --git a/python/sglang/srt/layers/moe/kt_provider.py b/python/sglang/srt/layers/moe/kt_provider.py
new file mode 100644
index 00000000..982af347
--- /dev/null
+++ b/python/sglang/srt/layers/moe/kt_provider.py
@@ -0,0 +1,410 @@
+"""The seam between SGLang's MoE orchestration and the CPU expert tier (recipe T3.19b).
+
+Today the CPU tier is kt-kernel's ``KTMoEWrapper`` on TP rank 0, driven from
+``KTEPWrapperMethod`` through four calls that carry the whole hybrid's implicit
+state: ``submit_forward`` / ``sync_forward`` (per layer), the class-wide pinned
+buffer cache keyed by token count (``KExpertsCPUBuffer``), and the class-wide
+deferred-expert flag per layer (``BaseMoEWrapper._layer_has_pending_deferred``).
+Everything the migration roadmap wants to move - ownership to other ranks, a
+native coordinator, a different expert engine - has to replace exactly those
+calls, so this module names them:
+
+  CpuExpertProvider  what a CPU expert engine must offer per MoE layer:
+                     reserve(contract) / validate(shape) / submit(...) / wait(...).
+  KtKernelProvider   the adapter around today's KTMoEWrapper. Behaviour-preserving:
+                     the plain decode path calls the very same kt methods in the
+                     same order with the same arguments as before; what is added is
+                     metadata-only bookkeeping (no device sync, no allocation, so
+                     it is safe under CUDA-graph capture).
+  BufferLease        the identity (data_ptr tuple) of the pinned/device buffer set
+                     kt handed out for one token count, recorded when a graph
+                     captures that size and asserted equal at every later
+                     Python-side submit of the same size. Graph replays run no
+                     Python, so the check guards the registry the replays were
+                     captured against, not the replay itself.
+  ForwardLedger      the cross-layer deferral bookkeeping (review C3): a slot
+                     written by layer L's deferred task is consumed by layer L+1
+                     and nothing else, and no slot is outstanding when a forward
+                     ends. Checked in Python from the submissions, independently
+                     of kt's own flag dict, and both must agree at the forward end.
+
+Not in this module: streamed-prefill (every rank, no kt), the B2 side path (off by
+default, removed at T3.19c), and the SGLang-side tensor contract
+(``kt_contract.check_moe_boundary``) which runs on every rank before any provider
+is consulted.
+"""
+
+from __future__ import annotations
+
+import os
+from dataclasses import dataclass
+from typing import Any, Callable, Dict, List, Mapping, Optional, Protocol, Sequence, Tuple
+
+import torch
+
+from sglang.srt.layers.moe.kt_contract import (
+    KTContractError,
+    check_deferral_adjacency,
+    check_forward_boundary,
+)
+
+
+# --------------------------------------------------------------------------- values
+
+
+@dataclass(frozen=True)
+class ExpertBatchShape:
+    """The one thing kt keys its buffers on: (tokens, hidden); top_k for the id tensors."""
+
+    tokens: int
+    hidden: int
+    top_k: int
+
+    @classmethod
+    def of(cls, hidden_states: torch.Tensor, topk_ids: torch.Tensor) -> "ExpertBatchShape":
+        return cls(int(hidden_states.shape[0]), int(hidden_states.shape[-1]), int(topk_ids.shape[-1]))
+
+
+@dataclass(frozen=True)
+class CaptureContract:
+    """Token counts the graph runners will capture, as the CPU tier must pre-size them."""
+
+    batch_sizes: Tuple[int, ...]
+    hidden: int
+    top_k: int
+
+    def __post_init__(self) -> None:
+        if any(int(b) < 1 for b in self.batch_sizes):
+            raise KTContractError(f"CaptureContract batch_sizes must be >= 1: {self.batch_sizes}")
+        object.__setattr__(self, "batch_sizes", tuple(sorted({int(b) for b in self.batch_sizes})))
+
+
+@dataclass(frozen=True)
+class ExpertSubmission:
+    """Handle returned by submit(); the only thing wait() needs besides the stream.
+
+    ``deferred_for_layer`` is the layer whose output absorbs this layer's deferred
+    experts (layer_idx + 1), or None when nothing was deferred. ``hidden_states`` is
+    the submitted input (kt keys its buffers on it; the graph-static buffer under
+    capture, the live tensor eagerly).
+    """
+
+    layer_idx: int
+    shape: ExpertBatchShape
+    deferred_for_layer: Optional[int]
+    stream: int
+    hidden_states: torch.Tensor
+
+
+@dataclass(frozen=True)
+class BufferLease:
+    """Identity of the buffer set kt serves for one token count (14 data_ptrs: 7 kinds x 2 slots)."""
+
+    tokens: int
+    hidden: int
+    ptrs: Tuple[int, ...]
+
+    @classmethod
+    def of(cls, buffers: Sequence[Sequence[torch.Tensor]], tokens: int, hidden: int) -> "BufferLease":
+        ptrs = tuple(int(t.data_ptr()) for kind in buffers for t in kind)
+        return cls(tokens, hidden, ptrs)
+
+    def check_same(self, other: "BufferLease", *, where: str = "") -> None:
+        if (self.tokens, self.hidden) != (other.tokens, other.hidden):
+            raise KTContractError(
+                f"{where}buffer lease for ({self.tokens}, {self.hidden}) compared with "
+                f"({other.tokens}, {other.hidden})."
+            )
+        if self.ptrs != other.ptrs:
+            moved = [i for i, (a, b) in enumerate(zip(self.ptrs, other.ptrs)) if a != b]
+            raise KTContractError(
+                f"{where}kt buffer set for bs={self.tokens} is not the one a CUDA graph captured: "
+                f"{len(moved)} of {len(self.ptrs)} tensors moved (indices {moved[:6]}). A replay would "
+                "read or write the old addresses (kt-kernel bug C, E23 R3)."
+            )
+
+
+# --------------------------------------------------------------------------- ledger
+
+
+class ForwardLedger:
+    """Cross-layer deferral bookkeeping for one process (one CPU tier).
+
+    ``outstanding_for_layer`` is the layer that must consume the last deferred
+    slot, or None. Pure Python; raises KTContractError.
+    """
+
+    def __init__(self) -> None:
+        self.outstanding_for_layer: Optional[int] = None
+        self.last_submission: Optional[ExpertSubmission] = None
+
+    def before_submit(self, layer_idx: int) -> None:
+        check_deferral_adjacency(
+            outstanding_for_layer=self.outstanding_for_layer, layer_idx=layer_idx
+        )
+
+    def after_submit(self, submission: ExpertSubmission) -> None:
+        self.outstanding_for_layer = submission.deferred_for_layer
+        self.last_submission = submission
+
+    def check_forward_end(self, *, pending_flags: Mapping[int, bool], last_layer_idx: int) -> None:
+        check_forward_boundary(
+            outstanding_for_layer=self.outstanding_for_layer,
+            pending_flags=pending_flags,
+            last_layer_idx=last_layer_idx,
+        )
+
+    def reset(self) -> None:
+        self.outstanding_for_layer = None
+        self.last_submission = None
+
+
+# --------------------------------------------------------------------------- protocol
+
+
+class CpuExpertProvider(Protocol):
+    """Per-MoE-layer CPU expert engine as the orchestration sees it."""
+
+    layer_idx: int
+    hidden: int
+    top_k: int
+    max_deferred: int
+
+    def reserve(self, contract: CaptureContract) -> None: ...
+
+    def validate(self, shape: ExpertBatchShape) -> None: ...
+
+    def submit(
+        self,
+        shape: ExpertBatchShape,
+        hidden_states: torch.Tensor,
+        compact_ids: torch.Tensor,
+        weights: torch.Tensor,
+        stream: int,
+    ) -> ExpertSubmission: ...
+
+    def wait(
+        self,
+        submission: ExpertSubmission,
+        stream: int,
+        mark: Optional[Callable[[str], None]] = None,
+    ) -> torch.Tensor: ...
+
+
+def _capturing() -> bool:
+    try:
+        return bool(torch.cuda.is_current_stream_capturing())
+    except Exception:  # noqa: BLE001 - no CUDA in the CPU-only test image
+        return False
+
+
+# --------------------------------------------------------------------------- registry
+
+_PROVIDERS: List["KtKernelProvider"] = []
+_LEASES: Dict[int, BufferLease] = {}
+_LEDGER = ForwardLedger()
+
+
+def ledger() -> ForwardLedger:
+    return _LEDGER
+
+
+def providers() -> List["KtKernelProvider"]:
+    return list(_PROVIDERS)
+
+
+def reset_registry() -> None:
+    """Tests only: forget providers, leases and the ledger."""
+    _PROVIDERS.clear()
+    _LEASES.clear()
+    _LEDGER.reset()
+
+
+def reserve_capture_sizes(batch_sizes: Sequence[int]) -> None:
+    """Runner entry point: register the token counts the graphs will capture.
+
+    Calls kt's own registration (accumulating, T3.16a) exactly as the runner did
+    before, then hands every provider its contract. Safe to call when kt is not
+    installed (no-op) and before any provider exists (kt registration only).
+    """
+    try:
+        from kt_kernel import KTMoEWrapper
+    except ImportError:
+        return
+    KTMoEWrapper.set_capture_batch_sizes(list(batch_sizes))
+    registered = tuple(KTMoEWrapper.get_capture_batch_sizes())
+    for p in _PROVIDERS:
+        p.reserve(CaptureContract(registered, p.hidden, p.top_k))
+
+
+# --------------------------------------------------------------------------- adapter
+
+
+class KtKernelProvider:
+    """CpuExpertProvider over one kt-kernel ``KTMoEWrapper`` (TP rank 0 only)."""
+
+    def __init__(
+        self,
+        wrapper: Any,
+        *,
+        layer_idx: int,
+        hidden: int,
+        top_k: int,
+        max_deferred: int,
+        ledger: Optional[ForwardLedger] = None,
+        leases: Optional[Dict[int, BufferLease]] = None,
+        register: bool = True,
+    ) -> None:
+        self.wrapper = wrapper
+        self.layer_idx = int(layer_idx)
+        self.hidden = int(hidden)
+        self.top_k = int(top_k)
+        self.max_deferred = int(max_deferred)
+        self.contract: Optional[CaptureContract] = None
+        self._ledger = ledger if ledger is not None else _LEDGER
+        self._leases = leases if leases is not None else _LEASES
+        if int(getattr(wrapper, "layer_idx", layer_idx)) != self.layer_idx:
+            raise KTContractError(
+                f"provider for layer {self.layer_idx} given a kt wrapper for layer {wrapper.layer_idx}"
+            )
+        if int(getattr(wrapper, "hidden_size", hidden)) != self.hidden:
+            raise KTContractError(
+                f"layer {self.layer_idx}: kt wrapper hidden_size={wrapper.hidden_size} != {self.hidden}"
+            )
+        if int(getattr(wrapper, "num_experts_per_tok", top_k)) != self.top_k:
+            raise KTContractError(
+                f"layer {self.layer_idx}: kt wrapper num_experts_per_tok={wrapper.num_experts_per_tok} != {self.top_k}"
+            )
+        if int(getattr(wrapper, "max_deferred_experts_per_token", max_deferred)) != self.max_deferred:
+            raise KTContractError(
+                f"layer {self.layer_idx}: kt wrapper max_deferred_experts_per_token="
+                f"{wrapper.max_deferred_experts_per_token} != {self.max_deferred}"
+            )
+        if register:
+            _PROVIDERS.append(self)
+
+    # -- protocol ----------------------------------------------------------------
+
+    def reserve(self, contract: CaptureContract) -> None:
+        if contract.hidden != self.hidden or contract.top_k != self.top_k:
+            raise KTContractError(
+                f"layer {self.layer_idx}: capture contract ({contract.hidden}, top_k {contract.top_k}) "
+                f"does not match the layer ({self.hidden}, top_k {self.top_k})."
+            )
+        if self.contract is not None and not set(self.contract.batch_sizes) <= set(contract.batch_sizes):
+            raise KTContractError(
+                f"layer {self.layer_idx}: capture contract shrank from {self.contract.batch_sizes} to "
+                f"{contract.batch_sizes}; registration only accumulates (T3.16a)."
+            )
+        self.contract = contract
+
+    def validate(self, shape: ExpertBatchShape) -> None:
+        where = f"layer {self.layer_idx}: "
+        if shape.tokens < 1:
+            raise KTContractError(f"{where}empty submission (0 tokens).")
+        if shape.hidden != self.hidden:
+            raise KTContractError(f"{where}hidden {shape.hidden} != {self.hidden}.")
+        if shape.top_k != self.top_k:
+            raise KTContractError(f"{where}top_k {shape.top_k} != {self.top_k}.")
+        if _capturing():
+            sizes = self.contract.batch_sizes if self.contract is not None else self._kt_capture_sizes()
+            if shape.tokens not in sizes:
+                raise KTContractError(
+                    f"{where}capturing bs={shape.tokens} which no contract reserved ({sizes}); the graph "
+                    "would bake kt's temporary buffer (bug C)."
+                )
+
+    def submit(
+        self,
+        shape: ExpertBatchShape,
+        hidden_states: torch.Tensor,
+        compact_ids: torch.Tensor,
+        weights: torch.Tensor,
+        stream: int,
+    ) -> ExpertSubmission:
+        self.validate(shape)
+        self._ledger.before_submit(self.layer_idx)
+        # The call the hybrid has always made, unchanged.
+        self.wrapper.submit_forward(hidden_states, compact_ids, weights, stream)
+        deferred = bool(self._pending_flags().get(self.layer_idx, False))
+        if deferred and self.max_deferred == 0:
+            raise KTContractError(
+                f"layer {self.layer_idx}: kt reports a deferred task but the layer is configured D=0."
+            )
+        submission = ExpertSubmission(
+            layer_idx=self.layer_idx,
+            shape=shape,
+            deferred_for_layer=self.layer_idx + 1 if deferred else None,
+            stream=int(stream),
+            hidden_states=hidden_states,
+        )
+        self._ledger.after_submit(submission)
+        self._check_lease(shape, hidden_states)
+        return submission
+
+    def wait(
+        self,
+        submission: ExpertSubmission,
+        stream: int,
+        mark: Optional[Callable[[str], None]] = None,
+    ) -> torch.Tensor:
+        if submission.layer_idx != self.layer_idx:
+            raise KTContractError(
+                f"layer {self.layer_idx}: asked to wait for layer {submission.layer_idx}'s submission."
+            )
+        w = self.wrapper
+        x = submission.hidden_states
+        if mark is None:
+            return w.sync_forward(x, stream)
+        # Timeline-instrumented wait (KT_TIMELINE=1, T3.19a): the same two kt
+        # steps sync_forward performs on the CUDA path, with a mark between.
+        if os.environ.get("KT_FORCE_SYNC_SUBMIT", "") == "1":
+            out = w.sync_forward(x, stream)
+            mark("sync")
+            mark("h2d")
+            return out
+        allow_pending = 1 if self._pending_flags().get(self.layer_idx, False) else 0
+        w.cpu_infer.sync_with_cuda_stream(stream, allow_pending)
+        mark("sync")
+        out = w.copy_forward_output_to_device(x)
+        mark("h2d")
+        return out
+
+    # -- forward boundary ------------------------------------------------------
+
+    def check_forward_end(self) -> None:
+        """Call once per forward after the last MoE layer's wait (D=0 rule layer)."""
+        self._ledger.check_forward_end(
+            pending_flags=self._pending_flags(), last_layer_idx=self.layer_idx
+        )
+
+    # -- internals -------------------------------------------------------------
+
+    def _pending_flags(self) -> Mapping[int, bool]:
+        return type(self.wrapper)._layer_has_pending_deferred
+
+    @staticmethod
+    def _kt_capture_sizes() -> Tuple[int, ...]:
+        from kt_kernel.experts_base import KExpertsCPUBuffer
+
+        return tuple(KExpertsCPUBuffer.capture_bs)
+
+    @staticmethod
+    def _kt_captured_buffers(tokens: int):
+        from kt_kernel.experts_base import KExpertsCPUBuffer
+
+        if tokens not in KExpertsCPUBuffer.capture_bs:
+            return None
+        return KExpertsCPUBuffer.capture_buffers.get(tokens)
+
+    def _check_lease(self, shape: ExpertBatchShape, hidden_states: torch.Tensor) -> None:
+        buffers = self._kt_captured_buffers(shape.tokens)
+        if buffers is None:
+            return  # unregistered size (temp buffer) or registered but not yet allocated
+        lease = BufferLease.of(buffers, shape.tokens, shape.hidden)
+        held = self._leases.get(shape.tokens)
+        if held is None:
+            if _capturing():
+                self._leases[shape.tokens] = lease
+            return
+        held.check_same(lease, where=f"layer {self.layer_idx}: ")
