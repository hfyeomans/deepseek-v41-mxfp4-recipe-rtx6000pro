+# SPDX-License-Identifier: Apache-2.0
+"""Decode-shape (M <= 4) block-[32, 32] W8A8 FP8 GEMV for SM120 (recipe T3.41).
+
+DeepSeek-V4.1-Flash's dense projections are FP8 weights with FP32 [32, 32] block scales. At
+decode M the tuned tensor-core tiles (`_w8a8_block_fp8_matmul_hopper`, SPLIT_K + reduce) move
+the weights at ~780 GB/s on the RTX PRO 6000 against a ~1,470 GB/s GDDR7 roof. This kernel is
+a plain FP32-FMA row-dot: one CTA per BLOCK_N (<= 32, so the tile shares one block-scale row)
+output columns, K streamed in BLOCK_K-wide contiguous slices, both scales folded into the
+activation slice, M a constexpr loop over the same weight slice. Deterministic (no atomics).
+
+It is enabled by ``SGLANG_DSV41_FP8_GEMV`` and used only for (N, K, M) entries present in the
+per-device table ``configs/gemv,device_name=<dev>,dtype=fp8_w8a8,block_shape=[32, 32].json``
+(written by the recipe's ``kernels/t341/fp8_gemv_block32.py`` sweep); every other call keeps
+the tuned Triton GEMM path.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import os
+from functools import lru_cache
+from typing import Any, Dict, Optional
+
+import torch
+import triton
+import triton.language as tl
+
+from sglang.srt.utils import get_device_name
+
+logger = logging.getLogger(__name__)
+
+GEMV_MAX_M = 4
+
+
+@triton.jit
+def _fp8_gemv_block32(
+    a_ptr, b_ptr, c_ptr, as_ptr, bs_ptr,
+    N, K,
+    stride_am, stride_ak,
+    stride_bn, stride_bk,
+    stride_cm, stride_cn,
+    stride_asm, stride_ask,
+    stride_bsn, stride_bsk,
+    M: tl.constexpr,
+    BLOCK_N: tl.constexpr,
+    BLOCK_K: tl.constexpr,
+    SPLIT_K: tl.constexpr,
+    OUT_FP32: tl.constexpr,
+):
+    """C[m, n] = sum_k (A[m, k] * As[m, k//32]) * (B[n, k] * Bs[n//32, k//32]), M <= 4 rows.
+
+    grid = (cdiv(N, BLOCK_N), SPLIT_K). BLOCK_N must divide 32 so every row of the CTA's
+    weight tile shares the same block-scale row. With SPLIT_K > 1 the CTA writes FP32 partials
+    at c_ptr + pid_k * M * N (reduced by ``_reduce_block_fp8_split_k``).
+    """
+    pid_n = tl.program_id(0)
+    pid_k = tl.program_id(1)
+    n0 = pid_n * BLOCK_N
+    offs_n = n0 + tl.arange(0, BLOCK_N)
+    mask_n = offs_n < N
+    nb = n0 // 32
+
+    k_per_split = tl.cdiv(tl.cdiv(K, BLOCK_K), SPLIT_K) * BLOCK_K
+    k_begin = pid_k * k_per_split
+    k_end = tl.minimum(k_begin + k_per_split, K)
+
+    acc0 = tl.zeros((BLOCK_N,), dtype=tl.float32)
+    acc1 = tl.zeros((BLOCK_N,), dtype=tl.float32)
+    acc2 = tl.zeros((BLOCK_N,), dtype=tl.float32)
+    acc3 = tl.zeros((BLOCK_N,), dtype=tl.float32)
+
+    for k0 in range(k_begin, k_end, BLOCK_K):
+        offs_k = k0 + tl.arange(0, BLOCK_K)
+        mask_k = offs_k < k_end
+        kb = offs_k // 32
+        w = tl.load(
+            b_ptr + offs_n[:, None] * stride_bn + offs_k[None, :] * stride_bk,
+            mask=mask_n[:, None] & mask_k[None, :], other=0.0,
+        ).to(tl.float32)
+        bs = tl.load(bs_ptr + nb * stride_bsn + kb * stride_bsk, mask=mask_k, other=0.0)
+        a = tl.load(a_ptr + 0 * stride_am + offs_k * stride_ak, mask=mask_k, other=0.0).to(tl.float32)
+        s = tl.load(as_ptr + 0 * stride_asm + kb * stride_ask, mask=mask_k, other=0.0)
+        acc0 += tl.sum(w * (a * s * bs)[None, :], axis=1)
+        if M > 1:
+            a = tl.load(a_ptr + 1 * stride_am + offs_k * stride_ak, mask=mask_k, other=0.0).to(tl.float32)
+            s = tl.load(as_ptr + 1 * stride_asm + kb * stride_ask, mask=mask_k, other=0.0)
+            acc1 += tl.sum(w * (a * s * bs)[None, :], axis=1)
+        if M > 2:
+            a = tl.load(a_ptr + 2 * stride_am + offs_k * stride_ak, mask=mask_k, other=0.0).to(tl.float32)
+            s = tl.load(as_ptr + 2 * stride_asm + kb * stride_ask, mask=mask_k, other=0.0)
+            acc2 += tl.sum(w * (a * s * bs)[None, :], axis=1)
+        if M > 3:
+            a = tl.load(a_ptr + 3 * stride_am + offs_k * stride_ak, mask=mask_k, other=0.0).to(tl.float32)
+            s = tl.load(as_ptr + 3 * stride_asm + kb * stride_ask, mask=mask_k, other=0.0)
+            acc3 += tl.sum(w * (a * s * bs)[None, :], axis=1)
+
+    if SPLIT_K > 1:
+        base = c_ptr + pid_k * M * N
+        tl.store(base + 0 * N + offs_n, acc0, mask=mask_n)
+        if M > 1:
+            tl.store(base + 1 * N + offs_n, acc1, mask=mask_n)
+        if M > 2:
+            tl.store(base + 2 * N + offs_n, acc2, mask=mask_n)
+        if M > 3:
+            tl.store(base + 3 * N + offs_n, acc3, mask=mask_n)
+    else:
+        if OUT_FP32:
+            tl.store(c_ptr + 0 * stride_cm + offs_n * stride_cn, acc0, mask=mask_n)
+            if M > 1:
+                tl.store(c_ptr + 1 * stride_cm + offs_n * stride_cn, acc1, mask=mask_n)
+            if M > 2:
+                tl.store(c_ptr + 2 * stride_cm + offs_n * stride_cn, acc2, mask=mask_n)
+            if M > 3:
+                tl.store(c_ptr + 3 * stride_cm + offs_n * stride_cn, acc3, mask=mask_n)
+        else:
+            tl.store(c_ptr + 0 * stride_cm + offs_n * stride_cn, acc0.to(c_ptr.dtype.element_ty), mask=mask_n)
+            if M > 1:
+                tl.store(c_ptr + 1 * stride_cm + offs_n * stride_cn, acc1.to(c_ptr.dtype.element_ty), mask=mask_n)
+            if M > 2:
+                tl.store(c_ptr + 2 * stride_cm + offs_n * stride_cn, acc2.to(c_ptr.dtype.element_ty), mask=mask_n)
+            if M > 3:
+                tl.store(c_ptr + 3 * stride_cm + offs_n * stride_cn, acc3.to(c_ptr.dtype.element_ty), mask=mask_n)
+
+
+@lru_cache(maxsize=None)
+def get_fp8_gemv_configs(block_n: int, block_k: int) -> Dict[str, Dict[int, Dict[str, Any]]]:
+    """``{"N=..,K=..": {M: config}}`` for this device, or ``{}`` when no table is shipped."""
+    device_name = get_device_name().replace(" ", "_")
+    name = f"gemv,device_name={device_name},dtype=fp8_w8a8,block_shape=[{block_n}, {block_k}].json"
+    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "configs", name)
+    if not os.path.exists(path):
+        logger.warning("SGLANG_DSV41_FP8_GEMV=1 but no GEMV table at %s; Triton GEMM path kept", path)
+        return {}
+    with open(path) as f:
+        table = json.load(f)
+    shapes = table.get("shapes", {})
+    out = {k: {int(m): cfg for m, cfg in v.items()} for k, v in shapes.items()}
+    logger.info("Using FP8 GEMV table %s (%d shapes)", path, len(out))
+    return out
+
+
+def fp8_gemv_config(N: int, K: int, M: int, block_n: int, block_k: int) -> Optional[Dict[str, Any]]:
+    if M > GEMV_MAX_M:
+        return None
+    return get_fp8_gemv_configs(block_n, block_k).get(f"N={N},K={K}", {}).get(M)
+
+
+def fp8_gemv_block32(
+    A: torch.Tensor, B: torch.Tensor, As: torch.Tensor, Bs: torch.Tensor, C: torch.Tensor,
+    config: Dict[str, Any],
+) -> torch.Tensor:
+    """A [..., K] fp8, B [N, K] fp8, As [..., K/32] fp32, Bs [N/32, K/32] fp32 -> C [..., N].
+
+    ``C`` is the tensor allocated by ``prepare_block_fp8_matmul_inputs`` (returned filled);
+    the leading dims of A/C are flattened to M <= GEMV_MAX_M rows.
+    """
+    K = A.shape[-1]
+    N = B.shape[0]
+    A = A.reshape(-1, K)
+    As = As.reshape(A.shape[0], -1)
+    out_full = C
+    C = C.view(-1, N)
+    M = A.shape[0]
+    bn, bk, split_k = config["BLOCK_N"], config["BLOCK_K"], config.get("SPLIT_K", 1)
+    if split_k > 1:
+        out = torch.empty((split_k, M, N), device=A.device, dtype=torch.float32)
+    else:
+        out = C
+    grid = (triton.cdiv(N, bn), split_k)
+    _fp8_gemv_block32[grid](
+        A, B, out, As, Bs, N, K,
+        A.stride(0), A.stride(1), B.stride(0), B.stride(1), C.stride(0), C.stride(1),
+        As.stride(0), As.stride(1), Bs.stride(0), Bs.stride(1),
+        M=M, BLOCK_N=bn, BLOCK_K=bk, SPLIT_K=split_k, OUT_FP32=(C.dtype == torch.float32),
+        num_warps=config["num_warps"], num_stages=config["num_stages"],
+    )
+    if split_k > 1:
+        from sglang.kernels.ops.quantization.fp8_kernel import _reduce_block_fp8_split_k
+
+        _reduce_block_fp8_split_k[(triton.cdiv(M * N, 256),)](out, C, M * N, split_k, 256)
+    return out_full
