+def _t_summary(name: str, t) -> str:
+    if t is None:
+        return f"{name}=None"
+    if not torch.is_tensor(t):
+        return f"{name}={t!r}"
+    if t.numel() == 0:
+        return f"{name}=[] shape={tuple(t.shape)}"
+    if t.numel() <= 24:
+        return f"{name}={t.flatten().tolist()}"
+    return (
+        f"{name}=shape{tuple(t.shape)} min={t.min().item()} max={t.max().item()}"
+    )
