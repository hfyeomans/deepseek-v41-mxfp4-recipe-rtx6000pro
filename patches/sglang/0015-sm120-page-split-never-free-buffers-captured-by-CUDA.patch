+                    "(min %d, max %d, pool bound %d, %d attention calls)",
+                    layer_id,
+                    count,
+                    lo,
+                    hi,
+                    bound,
+                    calls,
+                )
+            stats.zero_()
+            stats[1] = 2**31 - 1
+        return hidden_states.clone()
