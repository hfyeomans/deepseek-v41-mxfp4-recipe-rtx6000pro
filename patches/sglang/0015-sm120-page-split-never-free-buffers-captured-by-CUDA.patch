+_IDX_GUARD_ENV = "SGLANG_SM120_IDX_GUARD"
+_IDX_STATS_KEY = "flash_mla_sm120_idx_oob_stats"
+_INT32_MAX = 2**31 - 1
+
+
+def _idx_guard_enabled() -> bool:
+    import os
+
+    return os.environ.get(_IDX_GUARD_ENV, "0") not in ("", "0", "false", "False")
+
+
+def idx_oob_stats_buffer(device) -> torch.Tensor:
+    """Persistent int64[5] per device: [oob_count, oob_min, oob_max, bound, calls].
+
+    Written in-graph by ``_guard_indices`` (so replays update it), read and
+    reset eagerly by the BCG debug layer breaks (``SGLANG_BCG_DEBUG_LAYER_BREAKS``).
+    """
+    from sglang.srt.runtime_context import get_resources
+
+    buffers = get_resources().buffers
+    key = f"{_IDX_STATS_KEY}:{device}"
+    buf = buffers.get(key)
+    if buf is None:
+        with torch.inference_mode(False):
+            buf = torch.zeros(5, dtype=torch.int64, device=device)
+            buf[1] = _INT32_MAX
+        buffers[key] = buf
+    return buf
+
+
+def _guard_indices(idx: torch.Tensor, bound: int) -> torch.Tensor:
+    """Mask token indices outside ``[0, bound)`` to -1 and record OOB stats.
+
+    Only active when ``SGLANG_SM120_IDX_GUARD=1``. Every op is graph-safe (no
+    host sync); stats accumulate in ``idx_oob_stats_buffer``.
+    """
+    if not _idx_guard_enabled():
+        return idx
+    stats = idx_oob_stats_buffer(idx.device)
+    idx64 = idx.to(torch.int64)
+    bad = idx64 >= bound
+    stats[0] += bad.sum()
+    stats[1] = torch.minimum(
+        stats[1], torch.where(bad, idx64, _INT32_MAX).min()
+    )
+    stats[2] = torch.maximum(stats[2], torch.where(bad, idx64, -1).max())
+    stats[3].fill_(bound)  # fill_ is a device kernel (graph-safe); `= int` is a H2D copy
+    stats[4] += 1
+    return torch.where(bad, torch.full_like(idx, -1), idx)
+
+
+_RETIRED_KEY = "flash_mla_sm120_retired"
+
+
+def _dev_key(dev) -> str:
+    # torch.device("cuda") and torch.device("cuda:0") are the same device but
+    # stringify differently; key on the resolved index so a reservation made
+    # with the backend's un-indexed device is found by the kernels' tensors.
+    dev = torch.device(dev)
+    if dev.type == "cuda" and dev.index is None:
+        dev = torch.device("cuda", torch.cuda.current_device())
+    return str(dev)
+
+
+def _split_buffer_key(dev, buffer_tag: str) -> str:
+    return f"flash_mla_sm120_split{buffer_tag}:{_dev_key(dev)}"
+
+
+def _mask_key(dev) -> str:
+    return f"flash_mla_sm120_mask:{_dev_key(dev)}"
+
+
+def _grow_persistent(buffers: dict, key: str, prev, make, what: str):
+    """Replace ``buffers[key]`` with a bigger tensor without freeing the old one.
+
+    CUDA graphs captured earlier hold the *old* data pointer for their memsets,
+    ``_page_mark_kernel`` and ``_page_split_kernel`` launches and keep writing
+    it on every replay. Dropping the old tensor hands that block back to the
+    caching allocator: whatever is placed there next is silently overwritten
+    (E23 R1 run H: verify ``positions``/``out_cache_loc`` read back as int8
+    page marks), and once the allocator releases the segment the captured
+    write hits unmapped memory -- cudaErrorIllegalAddress / Xid 31 in the first
+    attention layer of the step. Retired tensors are therefore kept alive for
+    the process lifetime; a graph stays self-consistent with the buffer it
+    captured because a pool's page count never changes after init.
+    ``reserve_split_buffers`` sizes these up-front so a grow after capture is a
+    bug worth shouting about rather than the normal path.
+    """
+    capturing = torch.cuda.is_current_stream_capturing()
+    # The first allocation can happen under inference mode (autotune), but the
+    # buffer is written again during CUDA graph capture outside inference mode,
+    # where an inference tensor cannot be mutated.
+    with torch.inference_mode(False):
+        new = make()
+    buffers[key] = new
+    if prev is not None:
+        buffers.setdefault(_RETIRED_KEY, []).append(prev)
+    logger.log(
+        logging.ERROR if (prev is not None and not capturing) else logging.WARNING,
+        "[sm120-split] %s %s: %s ptr=0x%x capturing=%s%s",
+        what,
+        "grown (old buffer retired, not freed)" if prev is not None else "allocated",
+        key,
+        new.data_ptr(),
+        capturing,
+        (
+            " -- grow after CUDA graph capture: call reserve_split_buffers() "
+            "with the full pool geometry before capture"
+            if prev is not None and not capturing
+            else ""
+        ),
+    )
+    return new
+
+
+def _ensure_split_buffer(dev, buffer_tag: str, num_dst_pages: int) -> torch.Tensor:
+    from sglang.srt.runtime_context import get_resources
+
+    buffers = get_resources().buffers
+    key = _split_buffer_key(dev, buffer_tag)
+    buf = buffers.get(key)
+    if buf is None or buf.shape[0] < num_dst_pages:
+        # Zero-filled, not torch.empty: dst pages the mask never marks keep
+        # whatever bytes were in that VRAM, and in FP8 e4m3 0x7F/0xFF decode
+        # to NaN. A kernel read of an unmarked page (padding rows of a mixed
+        # batch, a -1 index) then poisons the logits non-deterministically.
+        # Zero bytes decode to 0.0 with scale 0 -- finite. (T3.6d2 probe.)
+        buf = _grow_persistent(
+            buffers,
+            key,
+            buf,
+            lambda: torch.zeros(
+                num_dst_pages, _BYTES_PER_DST_PAGE_PADDED, dtype=torch.uint8, device=dev
+            ),
+            f"split buffer pages={num_dst_pages}",
+        )
+    return buf
+
+
+def _ensure_mask(dev, num_src_pages: int) -> torch.Tensor:
+    from sglang.srt.runtime_context import get_resources
+
+    buffers = get_resources().buffers
+    key = _mask_key(dev)
+    mbuf = buffers.get(key)
+    if mbuf is None or mbuf.shape[0] < num_src_pages:
+        mbuf = _grow_persistent(
+            buffers,
+            key,
+            mbuf,
+            lambda: torch.zeros(num_src_pages, dtype=torch.int8, device=dev),
+            f"page mask N={num_src_pages}",
+        )
+    return mbuf
+
+
+def reserve_split_buffers(pools, device) -> None:
+    """Pre-size the persistent page-split buffers before any CUDA graph capture.
+
+    ``pools`` is an iterable of ``(num_src_pages, src_page_size, buffer_tag)``
+    for every KV pool that ``_split_kv_pages_to_64`` may be asked to re-page
+    (SWA pool with tag "", compressed pools with tag "extra"). Pools whose page
+    size is already 64 (or 2) are ignored. Sizing from the largest pool means
+    no later call can grow (and retire) a buffer that a captured graph uses.
+    """
+    max_mask = 0
+    max_dst = {}
+    for num_src_pages, src_pbs, tag in pools:
+        if src_pbs == _PBS_DST or src_pbs % _PBS_DST != 0:
+            continue
+        max_mask = max(max_mask, num_src_pages)
+        max_dst[tag] = max(max_dst.get(tag, 0), num_src_pages * (src_pbs // _PBS_DST))
+    if max_mask:
+        _ensure_mask(device, max_mask)
+    for tag, pages in max_dst.items():
+        _ensure_split_buffer(device, tag, pages)
+
