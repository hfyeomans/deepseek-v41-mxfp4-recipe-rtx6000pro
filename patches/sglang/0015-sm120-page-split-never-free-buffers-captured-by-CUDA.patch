+def _debug_layer_break_ids(spec: str, num_layers: int) -> set:
+    """Parse SGLANG_BCG_DEBUG_LAYER_BREAKS: "all", "3", "0-9", "0,4,9-12"."""
+    spec = spec.strip()
+    if not spec:
+        return set()
+    if spec == "all":
+        return set(range(num_layers))
+    ids = set()
+    for part in spec.split(","):
+        part = part.strip()
+        if not part:
+            continue
+        if "-" in part:
+            lo, hi = part.split("-", 1)
+            ids.update(range(int(lo), int(hi) + 1))
+        else:
+            ids.add(int(part))
+    return {i for i in ids if 0 <= i < num_layers}
+
