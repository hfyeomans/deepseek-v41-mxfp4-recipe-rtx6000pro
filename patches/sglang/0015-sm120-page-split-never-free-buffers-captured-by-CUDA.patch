+        # inputs this replay consumes (the captured ForwardBatch's tensors are
+        # the static buffers, so their contents are current at replay), plus
+        # the SWA write/read targets derived from them. Eager: syncs are fine.
+        if (
+            forward_batch is not None
+            and layer_id == 0
+            and os.environ.get("SGLANG_BCG_DEBUG_INPUTS", "0") not in ("", "0")
+        ):
+            _debug_dump_graph_inputs(forward_batch)
+        # With SGLANG_SM120_IDX_GUARD=1 the SM120 attention path accumulates
+        # out-of-pool KV index stats in-graph; drain them here (eager, so a
+        # host sync is fine) and attribute them to the layers since the
+        # previous break. [count, min, max, bound, calls]
+        if os.environ.get("SGLANG_SM120_IDX_GUARD", "0") not in ("", "0"):
