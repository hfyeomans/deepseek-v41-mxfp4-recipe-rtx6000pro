+    def _reserve_sm120_split_buffers(self) -> None:
+        """Size the SM120 page-split scratch from the real pool geometry.
+
+        The FlashInfer SM120 sparse MLA kernels take pbs=64 pages, so the SWA
+        pool (pbs 256) and the c1/c2 compressed pools (pbs 256/128) are re-paged
+        through persistent buffers in flash_mla_sm120. Those buffers used to be
+        sized lazily by the first caller: the warmup only touches the SWA pool,
+        CUDA graphs are captured against that small allocation, and the first
+        real prefill then grows the shared page mask for the compressed pools
+        -- freeing the tensor the captured graphs still write on every replay
+        (E23 R1 bug B, Xid 31 in layer 0 on the second request). Reserving the
+        maximum over all pools here, before capture, removes the grow.
+        """
+        from sglang.kernels.ops.attention.flash_mla_sm120 import (
+            reserve_split_buffers,
+        )
+
+        pools = []
+        device = self.device
+        swa_pool = getattr(self.token_to_kv_pool, "swa_kv_pool", None)
+        if swa_pool is not None and getattr(swa_pool, "kv_buffer", None):
+            pools.append((swa_pool.kv_buffer[0].shape[0], swa_pool.page_size, ""))
+            device = swa_pool.kv_buffer[0].device
+        for pool in self.token_to_kv_pool.kv_pools.values():
+            if getattr(pool, "kv_buffer", None):
+                pools.append((pool.kv_buffer[0].shape[0], pool.page_size, "extra"))
+                device = pool.kv_buffer[0].device
+        # Key on the pool tensors' (indexed) device, the same one the kernels
+        # will see, not the backend's possibly un-indexed torch.device("cuda").
+        reserve_split_buffers(pools, device)
+        logger.info(
+            "[sm120-split] reserved page-split buffers from pools "
+            "(num_pages, page_size, tag): %s",
+            pools,
+        )
+
     def _move_to_device(self, x: List[int]) -> torch.Tensor:
         pin_tensor = torch.tensor(x, dtype=torch.int32, pin_memory=True)
