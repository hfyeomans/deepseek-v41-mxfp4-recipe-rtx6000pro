+def _make_debug_layer_break(layer_id: int):
+    """Diagnostic eager break in front of one layer: a captured graph is split
+    here so a replay fault is attributed to the segment (= layer range) that
+    raised it. Costs one hidden_states copy per layer per step; debug only."""
+
