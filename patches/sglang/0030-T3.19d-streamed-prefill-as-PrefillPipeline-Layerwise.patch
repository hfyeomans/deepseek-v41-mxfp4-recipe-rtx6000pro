-class _StreamedExpertSlots:
-    """Per-rank GPU staging for one layer's CPU experts, in SGLang's layout.
-
-    w13 = [up; gate] rows (FlashInfer CUTLASS order), scales E8M0 uint8 after
-    flashinfer.block_scale_interleave -- exactly what
-    Mxfp4FlashinferCutlassMoEMethod.process_weights_after_loading leaves in
-    the resident layer tensors.
-    """
-
-    def __init__(self, n: int, hidden: int, inter_tp: int, device: torch.device):
-        self.inter_tp = inter_tp
-        self.w13 = torch.empty((n, 2 * inter_tp, hidden // 2), dtype=torch.int8, device=device)
-        self.s13 = torch.empty((n, 2 * inter_tp, hidden // 32), dtype=torch.uint8, device=device)
-        self.w2 = torch.empty((n, hidden, inter_tp // 2), dtype=torch.int8, device=device)
-        self.s2 = torch.empty((n, hidden, inter_tp // 32), dtype=torch.uint8, device=device)
-        # bf16 landing zone for kt-kernel's scales (bits = e8m0 << 7).
-        self.s13_raw = torch.empty((n, 2 * inter_tp, hidden // 32), dtype=torch.bfloat16, device=device)
-        self.s2_raw = torch.empty((n, hidden, inter_tp // 32), dtype=torch.bfloat16, device=device)
-        # scratch for the on-device gate/up half swap (one half of w13 / s13)
-        self._half_w = torch.empty((n, inter_tp, hidden // 2), dtype=torch.int8, device=device)
-        self._half_s = torch.empty((n, inter_tp, hidden // 32), dtype=torch.bfloat16, device=device)
-        self.tensors = (self.w13, self.s13, self.w2, self.s2, self.s13_raw, self.s2_raw, self._half_w, self._half_s)
-
-    @property
-    def nbytes(self) -> int:
-        return sum(t.numel() * t.element_size() for t in self.tensors)
-
-    def load(self, host: "_HostSlice") -> None:
-        """H2D on the current stream (4 bulk copies), then fix the layout up."""
-        from flashinfer import block_scale_interleave
-
-        it = self.inter_tp
-        self.w13.view(torch.uint8).copy_(host.w13, non_blocking=True)
-        self.s13_raw.copy_(host.s13, non_blocking=True)
-        self.w2.view(torch.uint8).copy_(host.w2, non_blocking=True)
-        self.s2_raw.copy_(host.s2, non_blocking=True)
-        # kt-kernel writes [gate; up]; the kernel wants [up; gate].
-        for t, tmp in ((self.w13, self._half_w), (self.s13_raw, self._half_s)):
-            tmp.copy_(t[:, :it])
-            t[:, :it].copy_(t[:, it:])
-            t[:, it:].copy_(tmp)
-        # bf16 (e8m0 << 7) -> E8M0 uint8, then FlashInfer's SM120 interleave,
-        # applied to the whole [E, N, K/32] tensor like the resident loader does.
-        for raw, dst in ((self.s13_raw, self.s13), (self.s2_raw, self.s2)):
-            dst.copy_((raw.view(torch.int16).to(torch.int32) >> 7).to(torch.uint8))
-            dst.copy_(block_scale_interleave(dst).reshape_as(dst))
