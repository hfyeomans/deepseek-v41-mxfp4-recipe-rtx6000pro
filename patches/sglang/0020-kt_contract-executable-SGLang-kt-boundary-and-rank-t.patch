+++ b/python/sglang/srt/layers/moe/kt_contract.py
@@ -0,0 +1,146 @@
+"""Executable contract at the SGLang -> kt-kernel / streamed-prefill boundary.
+
+Two pure functions, torch-only, no device syncs, no allocation, so they are safe
+to run under CUDA-graph capture and cheap enough to run on every MoE layer:
+
+  check_moe_topology  - once per layer at create_weights: the parallel layout the
+                        hybrid's rank-0 ownership and contiguous expert split assume.
+  check_moe_boundary  - once per forward in KTEPWrapperMethod.apply: the tensor
+                        shapes/dtypes/layout kt-kernel's pinned D2H copies and the
+                        FlashInfer runner rely on.
+
+Why these and not more (recipe review MAINTAINABILITY-REVIEW-2026-09 section 7.1, C9):
+kt-kernel's _prepare_forward_cpu_buffers does `copy_(..., non_blocking=True)` into
+fixed pinned tuples keyed by (tokens, hidden); a wrong hidden size or a topk tensor
+of another row count either asserts deep in kt with no layer context or, for the
+cached capture tuple, silently reads stale rows. Every rank other than 0 returns
+zeros for the CPU tier and relies on the layer's TP all-reduce to sum rank 0's
+result in - that is only true when the MoE's TP group is the full TP group and
+there is no expert parallelism. Value-range checks on topk_ids need a device sync
+and are left to the opt-in NaN probe (KT_NAN_PROBE_MIN_TOKENS).
+"""
+
+from __future__ import annotations
+
+from typing import Optional
+
+import torch
+
+
+class KTContractError(AssertionError):
+    """A boundary or topology precondition of the kt hybrid was violated."""
+
+
+def check_moe_topology(
+    *,
+    tp_rank: int,
+    tp_size: int,
+    moe_tp_rank: int,
+    moe_tp_size: int,
+    moe_ep_size: int,
+    has_kt_wrapper: bool,
+    num_gpu_experts: int,
+    num_experts: int,
+    max_deferred: int,
+    top_k: int,
+    b2_experts: int = 0,
+    has_streamer: bool = True,
+    layer_idx: Optional[int] = None,
+) -> None:
+    """Refuse parallel layouts the rank-0 hybrid does not implement.
+
+    Raises KTContractError with the offending values; never returns a value.
+    """
+    where = f"layer {layer_idx}: " if layer_idx is not None else ""
+    if moe_ep_size != 1:
+        raise KTContractError(
+            f"{where}moe_ep_size={moe_ep_size}: the contiguous GPU/CPU expert split "
+            "(experts [0, num_gpu_experts) on GPU, the rest on rank 0's CPU) needs every "
+            "rank to see the full routing id space; expert parallelism partitions it."
+        )
+    if moe_tp_size != tp_size or moe_tp_rank != tp_rank:
+        raise KTContractError(
+            f"{where}MoE TP group (rank {moe_tp_rank}/{moe_tp_size}) differs from the model "
+            f"TP group (rank {tp_rank}/{tp_size}); ranks != 0 return zeros for the CPU tier "
+            "and rely on the layer's TP all-reduce to add rank 0's result."
+        )
+    if has_kt_wrapper != (tp_rank == 0):
+        raise KTContractError(
+            f"{where}kt wrapper present={has_kt_wrapper} on tp_rank={tp_rank}; exactly rank 0 "
+            "owns the CPU experts (rank-0 kt-kernel path)."
+        )
+    if not 0 <= num_gpu_experts < num_experts:
+        raise KTContractError(
+            f"{where}num_gpu_experts={num_gpu_experts} must be in [0, {num_experts}) for a "
+            "layer with CPU experts (an all-GPU layer must not build the hybrid)."
+        )
+    if not 0 <= max_deferred < top_k:
+        raise KTContractError(
+            f"{where}max_deferred_experts_per_token={max_deferred} must be in [0, top_k={top_k}); "
+            "kt-kernel protects top_k - D experts per token and D >= top_k protects none."
+        )
+    if b2_experts:
+        num_cpu = num_experts - num_gpu_experts
+        if not 0 < b2_experts < num_cpu:
+            raise KTContractError(
+                f"{where}KT_B2_UVA_EXPERTS={b2_experts} must be in (0, {num_cpu}) at this placement."
+            )
+        if not has_streamer:
+            raise KTContractError(
+                f"{where}KT_B2_UVA_EXPERTS={b2_experts} needs the streamed-prefill export path "
+                "(KT_GPU_PREFILL_MIN_TOKENS > 0)."
+            )
+
+
+def check_moe_boundary(
+    hidden_states: torch.Tensor,
+    topk_ids: torch.Tensor,
+    topk_weights: torch.Tensor,
+    *,
+    hidden_size: int,
+    top_k: int,
+    layer_idx: Optional[int] = None,
+) -> None:
+    """Refuse tensors kt-kernel's pinned copies would mis-copy or silently cast.
+
+    Metadata-only: reads shapes, dtypes, strides and devices; never touches values.
+    """
+    where = f"layer {layer_idx}: " if layer_idx is not None else ""
+    if hidden_states.dim() != 2 or hidden_states.shape[1] != hidden_size:
+        raise KTContractError(
+            f"{where}hidden_states {tuple(hidden_states.shape)} must be [tokens, {hidden_size}]; "
+            "kt-kernel keys its pinned buffers on (tokens, hidden)."
+        )
+    tokens = hidden_states.shape[0]
+    if tokens < 1:
+        raise KTContractError(f"{where}empty forward (0 tokens) reached the MoE boundary.")
+    if tuple(topk_ids.shape) != (tokens, top_k):
+        raise KTContractError(
+            f"{where}topk_ids {tuple(topk_ids.shape)} must be [{tokens}, {top_k}]."
+        )
+    if tuple(topk_weights.shape) != (tokens, top_k):
+        raise KTContractError(
+            f"{where}topk_weights {tuple(topk_weights.shape)} must be [{tokens}, {top_k}]."
+        )
+    if topk_ids.dtype not in (torch.int32, torch.int64):
+        raise KTContractError(
+            f"{where}topk_ids dtype {topk_ids.dtype} must be int32 or int64 (kt casts to long; "
+            "the GPU runner and the -1 masks assume a signed integer)."
+        )
+    if not topk_weights.dtype.is_floating_point:
+        raise KTContractError(f"{where}topk_weights dtype {topk_weights.dtype} must be floating point.")
+    if hidden_states.dtype != torch.bfloat16:
+        raise KTContractError(
+            f"{where}hidden_states dtype {hidden_states.dtype} must be bfloat16; kt-kernel's "
+            "input_tensor_cpu is bf16 and copy_ would cast silently."
+        )
+    for name, t in (("hidden_states", hidden_states), ("topk_ids", topk_ids), ("topk_weights", topk_weights)):
+        if not t.is_contiguous():
+            raise KTContractError(
+                f"{where}{name} is not contiguous; non_blocking pinned copies of a strided "
+                "tensor go through a temporary and serialize the stream."
+            )
+        if t.device != hidden_states.device:
+            raise KTContractError(
+                f"{where}{name} on {t.device} but hidden_states on {hidden_states.device}."
+            )
