diff --git a/test/registered/kernels/ops/attention/test_topk_v2.py b/test/registered/kernels/ops/attention/test_topk_v2.py
index 5a7e5e96d..01d6ba8dd 100644
--- a/test/registered/kernels/ops/attention/test_topk_v2.py
+++ b/test/registered/kernels/ops/attention/test_topk_v2.py
@@ -453,5 +453,74 @@ def test_topk_v2_ragged_no_row_starts(k: int) -> None:
         assert sorted(explicit[i]) == sorted(implicit[i]), f"row {i} differs"
 
 
+# The reference for these cases is a stable sort by (value desc, index asc):
+# the selected SET must be a function of the scores alone. A row with fewer than
+# k positive scores (the ReLU'd indexer at short context) puts the k-th score
+# inside the zero tie; a coarse fp16 bin with more than kMaxNumTie (2,048)
+# members is the #35257 overflow. Each (batch, seq) lands on a different
+# dispatch template; the seq > 65536 rows take the cluster path where it is
+# compiled (SM90 / SM100) and the streaming path elsewhere.
+
+TIE_CONFIGS = [
+    (1, 700),  # Register2
+    (4, 14884),  # Register4
+    (2, 20000),  # Streaming below the cluster floor
+    (1, 65537),  # cluster (SM90/SM100) / streaming (others), just over floor
+    (3, 262147),  # ragged tail
+]
+
+
+def _reference_exact(scores, seq_lens, k):
+    """(value desc, index asc) top-k per row -- the unique exact answer."""
+    ref = []
+    for i in range(scores.shape[0]):
+        L = int(seq_lens[i])
+        s = scores[i, :L]
+        order = torch.argsort(-s, stable=True)
+        ref.append(sorted(order[: min(k, L)].tolist()))
+    return ref
+
+
+def _tie_rows(kind, batch, seq, k, device):
+    width = (seq + 3) & ~3
+    scores = torch.zeros((batch, width), device=device, dtype=torch.float32)
+    for i in range(batch):
+        if kind == "zero_tie":
+            # fewer than k positive scores: the k-th score is an exact 0.0 tie
+            n_pos = (i * 97 + 100) % k
+            pos = torch.randperm(seq, device=device)[:n_pos]
+            scores[i, pos] = torch.rand(n_pos, device=device) + 0.01
+        elif kind == "shared_value":
+            # one value shared by more than k positions straddling slot k
+            scores[i, :seq] = torch.rand(seq, device=device) * 0.5
+            pos = torch.randperm(seq, device=device)[: min(seq, 2049 + 1000 * i)]
+            scores[i, pos] = 1.5
+        else:  # "dense_bin": > 2,048 distinct values inside one fp16 bin
+            scores[i, :seq] = 1.0 + torch.rand(seq, device=device) * 5e-4
+    return scores
+
+
+@pytest.mark.parametrize("kind", ["zero_tie", "shared_value", "dense_bin"])
+@pytest.mark.parametrize("batch,seq", TIE_CONFIGS)
+@torch.inference_mode()
+def test_topk_v2_exact_under_ties(kind: str, batch: int, seq: int) -> None:
+    """Tied k-th scores and overfull coarse bins must give the exact
+    (value desc, index asc) set, identical on every call."""
+    k = 512
+    torch.manual_seed(35257 + seq)
+    device = "cuda"
+    if kind == "dense_bin" and seq <= 2048:
+        pytest.skip("needs more than kMaxNumTie members in one bin")
+    scores = _tie_rows(kind, batch, seq, k, device)
+    seq_lens = torch.full((batch,), seq, dtype=torch.int32, device=device)
+    ref = _reference_exact(scores, seq_lens, k)
+    first = [sorted(r) for r in _run_raw(scores, seq_lens, k)]
+    for i in range(batch):
+        assert first[i] == ref[i], f"{kind} b={i} L={seq}: set is not the exact top-{k}"
+    for rep in range(4):
+        again = [sorted(r) for r in _run_raw(scores, seq_lens, k)]
+        assert again == first, f"{kind} L={seq}: selected set moved on repeat {rep + 1}"
+
+
 if __name__ == "__main__":
     sys.exit(pytest.main([__file__, "-v"]))
