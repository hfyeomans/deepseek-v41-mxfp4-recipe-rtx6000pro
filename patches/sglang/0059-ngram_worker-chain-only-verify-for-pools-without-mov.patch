+def chainify_drafts(
+    req_drafts: np.ndarray, mask: np.ndarray, bs: int, draft_token_num: int
+) -> tuple[np.ndarray, np.ndarray]:
+    """Rewrite each request's draft into a pure front chain.
+
+    The corpus emits a BFS tree (``fillResult``): node 0 is the anchor, a
+    chain node i has parent i-1, and zero padding is appended as token-0
+    siblings under the root. A pool without ``move_kv_cache`` (DeepSeek-V4)
+    cannot compact a branched accept path, and the DSV4 attention backend
+    ignores ``custom_mask`` (verify rows attend causally), so the draft must
+    be the chain the attention actually computed: keep the leading run of
+    nodes whose parent is the previous node and whose token is non-zero,
+    zero everything after it, and give every row the causal mask. Accepted
+    rows are then always the leading rows of the window, which is exactly
+    where their KV was written.
+    """
+    d = draft_token_num
+    drafts = np.array(req_drafts, copy=True).reshape(bs, d)
+    tree = np.asarray(mask).reshape(bs, d, d)
+    if d > 1:
+        idx = np.arange(1, d)
+        linked = (tree[:, idx, idx - 1] != 0) & (drafts[:, 1:] != 0)
+        chain_len = np.cumprod(linked, axis=1).sum(axis=1)
+        drafts[:, 1:] = np.where(idx[None, :] <= chain_len[:, None], drafts[:, 1:], 0)
+    causal = np.tril(np.ones((d, d), dtype=tree.dtype))
+    chain_mask = np.broadcast_to(causal, (bs, d, d)).reshape(-1).copy()
+    return drafts.reshape(-1), chain_mask
+
+
