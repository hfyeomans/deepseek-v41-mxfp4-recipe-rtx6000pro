+    def _assert_leading_accept(
+        self, accept_index: torch.Tensor, accept_lens: torch.Tensor, bs: int
+    ) -> None:
+        """Async check that every accepted path is the leading rows of its
+        window (the only layout the chain-only KV protocol can commit)."""
+        d = self.draft_token_num
+        cols = torch.arange(d, device=accept_lens.device)[None, :]
+        rows = torch.arange(bs, device=accept_lens.device)[:, None] * d
+        expected = torch.where(cols < accept_lens[:, None], rows + cols, -1)
+        torch._assert_async(
+            (accept_index == expected).all(),
+            "NGRAM chain-only verify accepted a non-leading row",
+        )
+
