From cd55166ab1ddb455f4c5ed669896bd4869ce6c85 Mon Sep 17 00:00:00 2001
From: Hank Yeomans <hank@quorra.ah.local>
Date: Mon, 21 Sep 2026 20:31:50 -0400
Subject: [PATCH 03/61] SM120 V4.1 hybrid: BCG dataclass outputs; re-page c1/c2
 extra pools to 64 for FlashInfer sparse-MLA prefill

- breakable_cuda_graph_backend: recurse into dataclass outputs
  (LogitsProcessorOutput) in _output_rows/_alloc_full_buffer/_slice_output/
  _copy_output_to_buffer; non-tensor leaves pass through.
- flash_mla_sm120: FlashInfer 0.6.18 dual-cache prefill only compiles
  extra_page_block_size in {64, 2}. V4.1 compressed pools are paged at
  full_page_size // compress_ratio, so c1 (256) and c2 (128) fail with
  'Unsupported sparse-MLA prefill configuration'. Split them to 64-token
  pages like the SWA pool, in a separate persistent buffer (buffer_tag).

Amp-Thread-ID: https://ampcode.com/threads/T-01a0c10b-a5f8-77fc-b238-7147d12ccf29
Co-authored-by: Amp <amp@ampcode.com>
---
 .../kernels/ops/attention/flash_mla_sm120.py  | 21 +++++++-
 .../breakable_cuda_graph_backend.py           | 48 +++++++++++++++++++
 2 files changed, 68 insertions(+), 1 deletion(-)

diff --git a/python/sglang/kernels/ops/attention/flash_mla_sm120.py b/python/sglang/kernels/ops/attention/flash_mla_sm120.py
index 906d4aa22..77015515f 100644
--- a/python/sglang/kernels/ops/attention/flash_mla_sm120.py
+++ b/python/sglang/kernels/ops/attention/flash_mla_sm120.py
@@ -246,6 +246,20 @@ def _flash_mla_sm120_prefill(
         if extra_indices is not None and extra_indices.dim() == 3
         else extra_indices
     )
+    if extra_kv_u8 is not None and extra_kv_u8.ndim >= 3:
+        # The FlashInfer SM120 dual-cache prefill kernel only compiles
+        # extra_page_block_size in {64, 2}. DSV4.1's compressed pools are paged
+        # at full_page_size // compress_ratio, so c4 (64) and c128 (2) fit but
+        # c1 (256) and c2 (128) do not. Re-page those to 64 exactly like the
+        # SWA pool above; token indices are invariant under the split.
+        extra_pbs = extra_kv_u8.shape[1]
+        if extra_pbs not in (_PBS_DST, 2) and extra_pbs % _PBS_DST == 0:
+            extra_kv_u8 = _split_kv_pages_to_64(
+                extra_kv_u8,
+                extra_pbs,
+                touched_indices=extra_idx,
+                buffer_tag="extra",
+            )
     output = q2.new_empty((num_tokens, num_heads, head_dim_v), dtype=torch.bfloat16)
     out_lse = torch.empty((num_tokens, num_heads), dtype=torch.float32, device=dev)
     _sparse_mla_sm120_paged_attention(
@@ -449,6 +463,7 @@ def _split_kv_pages_to_64(
     kv_u8: torch.Tensor,
     src_pbs: int,
     touched_indices: Optional[torch.Tensor] = None,
+    buffer_tag: str = "",
 ) -> torch.Tensor:
     """Split pbs=N footer-format pages into pbs=64 footer-format pages.
 
@@ -458,6 +473,10 @@ def _split_kv_pages_to_64(
     pool on every decode step (only ~2*batch pages are touched vs the full
     pool). The output buffer is persistent and reused across steps; untouched
     dst pages simply retain their (unreferenced) stale data.
+
+    ``buffer_tag`` selects a separate persistent output buffer so two pools
+    split within the same forward (SWA + compressed extra pool) do not
+    overwrite each other.
     """
     assert src_pbs % _PBS_DST == 0 and src_pbs >= _PBS_DST
     if src_pbs == _PBS_DST:
@@ -472,7 +491,7 @@ def _split_kv_pages_to_64(
     # Pre-allocated grow-only buffer for page-split output per device.
     dev = kv_u8.device
     buffers = get_resources().buffers
-    key = f"flash_mla_sm120_split:{dev}"
+    key = f"flash_mla_sm120_split{buffer_tag}:{dev}"
     buf = buffers.get(key)
     if buf is None or buf.shape[0] < num_dst_pages:
         # The first allocation can happen under inference mode (autotune), but
diff --git a/python/sglang/srt/model_executor/runner_backend/breakable_cuda_graph_backend.py b/python/sglang/srt/model_executor/runner_backend/breakable_cuda_graph_backend.py
index 368db2ebc..64c821313 100644
--- a/python/sglang/srt/model_executor/runner_backend/breakable_cuda_graph_backend.py
+++ b/python/sglang/srt/model_executor/runner_backend/breakable_cuda_graph_backend.py
@@ -18,6 +18,7 @@ No torch.compile.
 
 from __future__ import annotations
 
+import dataclasses
 from contextlib import contextmanager
 from typing import TYPE_CHECKING, Any, Callable, Dict, Optional
 
@@ -56,6 +57,21 @@ if TYPE_CHECKING:
     from sglang.srt.model_executor.runner.shape_key import ShapeKey
 
 
+def _is_dataclass_instance(obj: Any) -> bool:
+    return dataclasses.is_dataclass(obj) and not isinstance(obj, type)
+
+
+def _dataclass_values(obj: Any):
+    return (getattr(obj, f.name) for f in dataclasses.fields(obj))
+
+
+def _map_dataclass(obj: Any, fn: Callable[[Any], Any]) -> Any:
+    """Same dataclass type with ``fn`` applied to every field value."""
+    return dataclasses.replace(
+        obj, **{f.name: fn(getattr(obj, f.name)) for f in dataclasses.fields(obj)}
+    )
+
+
 class BreakableCudaGraphBackend(DedupedCudaGraphMixin, BaseCudaGraphBackend):
     """Segmented capture: graphs break at attention / mamba boundaries;
     attention metadata is recomputed at replay outside captured segments.
@@ -164,6 +180,13 @@ class BreakableCudaGraphBackend(DedupedCudaGraphMixin, BaseCudaGraphBackend):
             return min([cap, *rows])
         if isinstance(output, (list, tuple)) and output:
             return min(self._output_rows(o, cap) for o in output if o is not None)
+        if _is_dataclass_instance(output):
+            rows = [
+                self._output_rows(v, cap)
+                for v in _dataclass_values(output)
+                if torch.is_tensor(v)
+            ]
+            return min(rows) if rows else cap
         return cap
 
     def _alloc_full_buffer(self, output: Any, size: int) -> Any:
@@ -183,6 +206,15 @@ class BreakableCudaGraphBackend(DedupedCudaGraphMixin, BaseCudaGraphBackend):
             return tuple(self._alloc_full_buffer(o, size) for o in output)
         if isinstance(output, list):
             return [self._alloc_full_buffer(o, size) for o in output]
+        if _is_dataclass_instance(output):
+            # Model outputs such as LogitsProcessorOutput: tensor fields get a
+            # same-shape buffer with ``size`` rows; None and plain-Python fields
+            # (lists of logprobs, dicts) are carried through unchanged.
+            return _map_dataclass(
+                output, lambda v: self._alloc_full_buffer(v, size)
+            )
+        if not torch.is_tensor(output):
+            return output
         raise TypeError(f"Unsupported BCG output type: {type(output)}")
 
     def _slice_output(self, output: Any, num_tokens: int) -> Any:
@@ -196,6 +228,12 @@ class BreakableCudaGraphBackend(DedupedCudaGraphMixin, BaseCudaGraphBackend):
             return tuple(self._slice_output(item, num_tokens) for item in output)
         if isinstance(output, list):
             return [self._slice_output(item, num_tokens) for item in output]
+        if _is_dataclass_instance(output):
+            return _map_dataclass(
+                output, lambda v: self._slice_output(v, num_tokens)
+            )
+        if not torch.is_tensor(output):
+            return output
         raise TypeError(f"Unsupported BCG output type: {type(output)}")
 
     def _copy_output_to_buffer(
@@ -235,6 +273,16 @@ class BreakableCudaGraphBackend(DedupedCudaGraphMixin, BaseCudaGraphBackend):
             for item, buffer in zip(output, output_buffer):
                 self._copy_output_to_buffer(item, buffer, num_tokens)
             return
+        if _is_dataclass_instance(output) and type(output) is type(output_buffer):
+            for f in dataclasses.fields(output):
+                self._copy_output_to_buffer(
+                    getattr(output, f.name), getattr(output_buffer, f.name), num_tokens
+                )
+            return
+        if not torch.is_tensor(output) and not torch.is_tensor(output_buffer):
+            # Plain-Python leaves (e.g. logprob lists) are not row-shaped; the
+            # replay path returns the captured value as-is.
+            return
         raise TypeError(
             "Unsupported BCG output buffer pair: "
             f"{type(output)} vs {type(output_buffer)}"
