-class _B2UvaExperts:
-    """One layer's B2 experts: the last `n` CPU experts, host-resident in the
-    GPU kernel's layout and computed by the GPU straight out of host memory.
-
-    Built on every TP rank at load time by reusing the layerwise-prefill export
-    once (rank 0 exports the experts, every rank stages its TP slice, fixes
-    the layout up on the device and copies it back into its own pinned
-    tensors). At forward time `run()` is the same FlashInfer call the streamed
-    prefill makes, with weight tensors whose storage is host memory: the
-    grouped GEMM reads only the routed experts' rows, so the bytes moved are
-    data-dependent while the graph-captured work is not (T3.18 microbench:
-    39-41 GiB/s effective per link, bit-equal to device weights, replays).
-    """
-
-    def __init__(self, method: "KTEPWrapperMethod", streamer: _LayerwisePrefillCoordinator, n: int):
-        n_cpu = method.num_cpu_experts
-        if not 0 < n < n_cpu:
-            raise ValueError(f"KT_B2_UVA_EXPERTS={n} must be in (0, {n_cpu}) at this placement")
-        self.n = n
-        self.layer_idx = method.kt_config.layer_idx
-        # Original ids [first, global_num_experts) -> local [0, n); compact kt ids n_cpu-n .. n_cpu-1.
-        self.first = method.global_num_experts - n
-        self.device = streamer.device
-        rank = streamer.tp_rank
-
-        # 1. rank 0 exports the n experts into rows [0, n) of host buffer 0.
-        streamer.dma_done[0].synchronize()
-        streamer._barrier()
-        if rank == 0:
-            for i in range(n):
-                w13, s13, w2, s2 = streamer._ptrs[0][i]
-                method.wrapper.submit_write_weight_scale_to_buffer(
-                    streamer.tp_size, n_cpu - n + i, w13, s13, w2, s2
-                )
-            method.wrapper.sync_write_weight_scale_to_buffer()
-        streamer._barrier()
-
-        # 2. every rank stages its slice and fixes the layout up on the device
-        #    (rows >= n hold stale bytes and are ignored), then copies rows
-        #    [0, n) back into pinned host tensors it owns.
-        slots = streamer.slots
-        slots.load(streamer.host[0][rank])
-        self.host: Dict[str, torch.Tensor] = {}
-        self.w: Dict[str, torch.Tensor] = {}
-        for name, src in (("w13", slots.w13), ("s13", slots.s13), ("w2", slots.w2), ("s2", slots.s2)):
-            h = _B2HostPool.take(method, n, (n,) + tuple(src.shape[1:]), src.dtype)
-            h.copy_(src[:n], non_blocking=True)
-            self.host[name] = h
-        torch.cuda.current_stream(self.device).synchronize()
-        streamer.dma_done[0].record()
-        streamer._barrier()
-        for name, h in self.host.items():
-            self.w[name] = _uva_view(h, self.device)
-        self.global_scale = torch.ones(n, dtype=torch.float32, device=self.device)
-        self.nbytes = sum(h.numel() * h.element_size() for h in self.host.values())
-        if self.layer_idx == min(streamer.layers) or KT_GPU_PREFILL_LOG:
-            logger.info(
-                "[KT B2] layer %d: %d experts (ids %d..%d) host-resident for direct-UVA compute, "
-                "%.1f MiB pinned per layer per rank (%.2f GiB for %d layers); kt-kernel keeps %d",
-                self.layer_idx, n, self.first, method.global_num_experts - 1,
-                self.nbytes / 2**20, self.nbytes * (method.kt_config.num_layers or 1) / 2**30,
-                method.kt_config.num_layers or 1, n_cpu - n,
-            )
