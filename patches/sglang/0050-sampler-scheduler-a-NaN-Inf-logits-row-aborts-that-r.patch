 import logging
 from dataclasses import dataclass
+from http import HTTPStatus
 from typing import (
     TYPE_CHECKING,
     Callable,
@@ -78,6 +79,47 @@ if TYPE_CHECKING:
 logger = logging.getLogger(__name__)
 
 
+def _non_finite_rows(
+    batch: ScheduleBatch, logits_output: Optional[LogitsProcessorOutput]
+) -> Optional[List[bool]]:
+    """Per-request non-finite-logits flags (recipe T3.13 / C10), or None.
+
+    None when the check is off, when the batch has no sampled logits, or when
+    the rows do not map 1:1 onto ``batch.reqs`` (speculative verify layouts),
+    in which case nothing is rejected rather than guessing a mapping.
+    """
+    if logits_output is None or logits_output.nan_rows is None:
+        return None
+    if not batch.spec_algorithm.is_none():
+        return None
+    nan_rows = logits_output.nan_rows
+    if nan_rows.shape[0] != len(batch.reqs):
+        return None
+    return nan_rows.tolist()
+
+
+def _reject_non_finite_row(req: Req, row: int, mode: str) -> None:
+    """Fail one request whose logits were not finite; the batch keeps running.
+
+    Sets ``to_finish`` so the next ``update_finish_state`` finishes the request
+    with an abort the tokenizer manager turns into HTTP 500 (non-stream) or an
+    error chunk (stream). Its KV is released like any finished request.
+    """
+    if req.finished() or req.to_finish is not None:
+        return
+    logger.error(
+        "[non-finite-logits] rid=%s row=%d mode=%s: NaN/Inf in next-token logits; "
+        "aborting this request only (err_type=NonFiniteLogits)",
+        req.rid, row, mode,
+    )
+    req.to_finish = FINISH_ABORT(
+        "non-finite logits (NaN/Inf) were produced for this request; it was aborted, "
+        "the server keeps serving",
+        HTTPStatus.INTERNAL_SERVER_ERROR,
+        "NonFiniteLogits",
+    )
+
+
 def _get_speculative_output_stride(result: GenerationBatchResult) -> int:
     """Return the padded per-request width in flattened speculative output."""
     stride = result.speculative_output_stride
@@ -287,6 +329,7 @@ class SchedulerBatchResultProcessor:
             # Move next_token_ids and logprobs to cpu
             next_token_ids = next_token_ids.tolist()
             self.move_logprobs_to_cpu(batch=batch, logits_output=logits_output)
+            non_finite = _non_finite_rows(batch, logits_output)
 
             self._validate_pp_skip_output_comm(batch, result)
 
@@ -340,6 +383,8 @@ class SchedulerBatchResultProcessor:
 
                         self._maybe_update_reasoning_tokens(req, next_token_id)
 
+                        if non_finite is not None and non_finite[i]:
+                            _reject_non_finite_row(req, i, "prefill")
                         req.update_finish_state()
                     # A mixed spec tail committed its pending bonus token; advance
                     # so the next spec prepare_for_decode reserves from the right base.
@@ -938,6 +983,7 @@ class SchedulerBatchResultProcessor:
         newly_finished_beam_groups = set()
         if batch.spec_algorithm.is_none() and logits_output is not None:
             newly_finished_beam_groups = self.beam_coordinator.commit_decode(batch)
+        non_finite = _non_finite_rows(batch, logits_output)
 
         for i, req in enumerate(batch.reqs):
             req: Req
@@ -972,6 +1018,8 @@ class SchedulerBatchResultProcessor:
 
             self._maybe_update_reasoning_tokens(req, next_token_id)
             req.time_stats.set_last_decode_finish_time()
+            if non_finite is not None and non_finite[i]:
+                _reject_non_finite_row(req, i, "decode")
             req.update_finish_state(new_accept_len)
 
             self._handle_finish_state_updated_req(req, batch, result, i, logits_output)
