diff --git a/python/sglang/srt/layers/sampler.py b/python/sglang/srt/layers/sampler.py
index dd9d6c5ae..48c18803b 100644
--- a/python/sglang/srt/layers/sampler.py
+++ b/python/sglang/srt/layers/sampler.py
@@ -153,6 +153,20 @@ class Sampler(nn.Module):
         if _is_hip and logits.shape[0] == 0:
             return torch.empty((0,), dtype=torch.int64, device=logits.device)
 
+        # Recipe T3.13 / C10: flag rows whose logits are already broken before
+        # any sanitizing, then sanitize so the sampling kernels see finite
+        # values; the scheduler fails exactly the flagged requests. NaN and
+        # +Inf only: -Inf is what grammar / logit-bias masks legitimately write,
+        # and it is kept, so a well-formed row is left bit-identical.
+        # Device-side, no host sync, so it captures into the decode graph.
+        if envs.SGLANG_DSV41_REJECT_NAN_ROWS.get():
+            logits_output.nan_rows = torch.isnan(logits).any(dim=-1) | torch.isposinf(
+                logits
+            ).any(dim=-1)
+            torch.nan_to_num_(logits, nan=-1e30, posinf=1e30, neginf=float("-inf"))
+        else:
+            logits_output.nan_rows = None
+
         # Preprocess logits (custom processors and NaN handling)
         _trace_e2e_sampler("preprocess_enter")
         logits = self._preprocess_logits(logits, sampling_info)
