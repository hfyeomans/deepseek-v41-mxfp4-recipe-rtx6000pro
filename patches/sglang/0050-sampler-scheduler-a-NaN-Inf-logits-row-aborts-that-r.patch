diff --git a/python/sglang/srt/layers/moe/kt_nan_inject.py b/python/sglang/srt/layers/moe/kt_nan_inject.py
new file mode 100644
index 000000000..5fbb302bc
--- /dev/null
+++ b/python/sglang/srt/layers/moe/kt_nan_inject.py
@@ -0,0 +1,91 @@
+"""Debug-only NaN injection into one MoE layer's output (recipe T3.13 / C10).
+
+Off unless ``KT_NAN_INJECT`` is set; the default serve has no object and no
+extra graph node. The test it exists for: a NaN that appears in one request's
+hidden state mid-decode must fail *that* request (HTTP 500, ``NonFiniteLogits``)
+while the other rows of the batch keep decoding and the server stays up.
+
+Spec (``KT_NAN_INJECT``): ``row=<r>,bs=<b>,step=<n>,layer=<l>`` -- on the
+``n``-th replayed decode graph of batch size ``b`` (rank 0 counts replays),
+add NaN to element 0 of row ``r``'s hidden state after MoE layer ``l``. The
+add is captured into the decode graph as ``output + buf[:rows]`` against a
+zero buffer allocated once (one bf16 row per possible batch row); the host
+writes the NaN into that buffer right before the target replay and zeroes it
+again before the next one, so exactly one step of one row is poisoned. The TP
+all-reduce after the layer carries the NaN to rank 1 element-wise, which is the
+same path a real NaN from the CPU tier would take.
+
+Forwards with more rows than the buffer (prefill chunks) are left untouched.
+"""
+
+from __future__ import annotations
+
+import logging
+import math
+import os
+from typing import Optional
+
+import torch
+
+logger = logging.getLogger(__name__)
+
+KT_NAN_INJECT = os.environ.get("KT_NAN_INJECT", "").strip()
+# Decode rows the injector can reach; prefill chunks are larger and skipped.
+_CAPACITY = 64
+
+
+class NanInjector:
+    def __init__(self, *, row: int, bs: int, step: int, layer: int) -> None:
+        if not (0 <= row < bs <= _CAPACITY) or step < 1 or layer < 0:
+            raise ValueError(f"KT_NAN_INJECT: bad spec row={row} bs={bs} step={step} layer={layer}")
+        self.row, self.bs, self.step, self.layer = row, bs, step, layer
+        self.buf: Optional[torch.Tensor] = None
+        self.replays_at_bs = 0
+        self.fired = False
+        self.armed = False
+
+    @classmethod
+    def from_env(cls, spec: str = KT_NAN_INJECT) -> Optional["NanInjector"]:
+        if not spec:
+            return None
+        fields = {}
+        for part in spec.split(","):
+            k, _, v = part.partition("=")
+            fields[k.strip()] = int(v)
+        return cls(
+            row=fields.get("row", 0),
+            bs=fields.get("bs", 1),
+            step=fields.get("step", 1),
+            layer=fields.get("layer", 0),
+        )
+
+    # -- inside the forward (captured) -------------------------------------------
+
+    def add_to(self, layer_idx: int, output: torch.Tensor) -> torch.Tensor:
+        """``output + buf[:rows]`` at the target layer; identity elsewhere."""
+        if layer_idx != self.layer or output.shape[0] > _CAPACITY:
+            return output
+        if self.buf is None:
+            self.buf = torch.zeros(
+                _CAPACITY, output.shape[1], dtype=output.dtype, device=output.device
+            )
+        return output + self.buf[: output.shape[0]]
+
+    # -- host side, once per decode graph replay ---------------------------------
+
+    def before_replay(self, batch_size: int) -> None:
+        if self.armed:
+            # The previous replay carried the NaN; this one must not.
+            self.buf.zero_()
+            self.armed = False
+        if self.fired or batch_size != self.bs or self.buf is None:
+            return
+        self.replays_at_bs += 1
+        if self.replays_at_bs == self.step:
+            self.buf[self.row, 0] = math.nan
+            self.armed = True
+            self.fired = True
+            logger.error(
+                "[KT_NAN_INJECT] poisoning row %d of the bs=%d decode replay #%d after MoE layer %d",
+                self.row, self.bs, self.replays_at_bs, self.layer,
+            )
