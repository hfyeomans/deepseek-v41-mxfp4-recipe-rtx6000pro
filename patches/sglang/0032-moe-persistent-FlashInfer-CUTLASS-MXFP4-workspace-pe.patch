+@dataclass
+class _MoeWorkspace:
+    """One persistent ``cutlass_fused_moe`` scratch buffer for a device.
+
+    Without ``workspace_buffer=`` FlashInfer allocates and frees a ~1 GiB
+    scratch tensor on every call (``getWorkspaceInfo``). Across a long prefill
+    that churn, interleaved with the prefix-proportional attention and indexer
+    transients, fragments the caching allocator until no contiguous block of
+    that size is left: 1M x 1 died at a ~306K prefix and 262K x 4 at ~190K
+    with >1.8 GiB reserved-but-free (recipe E34d-v (i)). FlashInfer sizes the
+    workspace monotonically in rows, so one buffer sized for the largest
+    forward serves every smaller call; the binding checks the buffer is 1-D,
+    contiguous, 128-byte aligned and large enough before using it.
+    """
+
+    buffer: torch.Tensor
+    max_rows: int
+    # Kernel configuration -> whether it fits in ``buffer`` at ``max_rows``.
+    fits: dict = field(default_factory=dict)
+    warned_overflow: bool = False
+
+
+_MOE_WORKSPACES: dict[torch.device, _MoeWorkspace] = {}
+
+
+def _moe_workspace_row_ceiling(rows: int) -> int:
+    override = envs.SGLANG_FLASHINFER_MOE_WORKSPACE_MAX_ROWS.get()
+    if override is not None:
+        return max(int(override), rows)
+    try:
+        from sglang.srt.runtime_context import get_schedule, max_prefill_buffer_tokens
+
+        ceiling = max_prefill_buffer_tokens() or get_schedule().max_prefill_tokens
+        # Decode forwards carry one row per running request (times the draft
+        # length under speculation); n_gram_embedding sizes its buffer the
+        # same way.
+        ceiling = max(ceiling or 0, get_schedule().max_running_requests or 0)
+    except Exception:  # no published runtime context (unit tests)
+        ceiling = 0
+    return max(int(ceiling), rows)
+
+
+def _moe_workspace(
+    *,
+    x: torch.Tensor,
+    rows: int,
+    hidden_size: int,
+    intermediate_size: int,
+    num_experts_total: int,
+    top_k: int,
+    weight_dtype: torch.dtype,
+    output_dtype: torch.dtype,
+    activation_type,
+    tp_size: int,
+    tp_rank: int,
+    ep_size: int,
+    ep_rank: int,
+    use_w4_group_scaling: bool,
+    use_mxfp8_act_scaling: bool,
+    use_fused_finalize: bool,
+    use_wfp4afp8_humming: bool,
+) -> Optional[torch.Tensor]:
+    """Return the device's persistent workspace, or ``None`` to let FlashInfer
+    allocate per call (feature off, or a forward larger than the buffer)."""
+    if not envs.SGLANG_FLASHINFER_MOE_PERSISTENT_WORKSPACE.get():
+        return None
+    from flashinfer.fused_moe import cutlass_fused_moe_workspace_size
+
+    device = x.device
+    config_key = (
+        hidden_size,
+        intermediate_size,
+        num_experts_total,
+        top_k,
+        x.dtype,
+        weight_dtype,
+        output_dtype,
+        int(activation_type),
+        tp_size,
+        tp_rank,
+        ep_size,
+        ep_rank,
+        use_w4_group_scaling,
+        use_mxfp8_act_scaling,
+        use_fused_finalize,
+        use_wfp4afp8_humming,
+    )
+
+    def size_for(max_rows: int) -> int:
+        return int(
+            cutlass_fused_moe_workspace_size(
+                max_rows,
+                hidden_size,
+                intermediate_size,
+                num_experts_total,
+                top_k,
+                x_dtype=x.dtype,
+                weight_dtype=weight_dtype,
+                output_dtype=output_dtype,
+                activation_type=activation_type,
+                tp_size=tp_size,
+                tp_rank=tp_rank,
+                ep_size=ep_size,
+                ep_rank=ep_rank,
+                use_w4_group_scaling=use_w4_group_scaling,
+                use_mxfp8_act_scaling=use_mxfp8_act_scaling,
+                use_fused_finalize=use_fused_finalize,
+                use_wfp4afp8_humming=use_wfp4afp8_humming,
+                device=device,
+            )
+        )
+
+    ws = _MOE_WORKSPACES.get(device)
+    if ws is None:
+        if torch.cuda.is_current_stream_capturing():
+            raise RuntimeError(
+                "FlashInfer MoE workspace must be allocated before CUDA graph "
+                "capture (an allocation inside capture would live in the graph "
+                "pool); warm up the model first or set "
+                "SGLANG_FLASHINFER_MOE_PERSISTENT_WORKSPACE=0."
+            )
+        max_rows = _moe_workspace_row_ceiling(rows)
+        nbytes = size_for(max_rows)
+        buffer = torch.empty(nbytes, dtype=torch.uint8, device=device)
+        ws = _MoeWorkspace(buffer=buffer, max_rows=max_rows)
+        ws.fits[config_key] = True
+        _MOE_WORKSPACES[device] = ws
+        logger.info(
+            "FlashInfer MoE workspace: %.1f MiB persistent on %s for up to %d rows "
+            "(hidden=%d inter=%d experts=%d top_k=%d)",
+            nbytes / 2**20,
+            device,
+            max_rows,
+            hidden_size,
+            intermediate_size,
+            num_experts_total,
+            top_k,
+        )
+    elif config_key not in ws.fits:
+        # Another MoE shape on the same device: the buffer is never resized
+        # once a graph may have captured its address, so a configuration that
+        # does not fit at the buffer's row ceiling keeps per-call allocation.
+        fits = size_for(ws.max_rows) <= ws.buffer.numel()
+        ws.fits[config_key] = fits
+        if not fits:
+            logger.warning(
+                "FlashInfer MoE workspace on %s (%d rows) is too small for MoE "
+                "configuration %r; that configuration allocates per call (raise "
+                "SGLANG_FLASHINFER_MOE_WORKSPACE_MAX_ROWS to cover it).",
+                device,
+                ws.max_rows,
+                config_key,
+            )
+    if not ws.fits[config_key]:
+        return None
+
+    if rows > ws.max_rows:
+        if not ws.warned_overflow:
+            ws.warned_overflow = True
+            logger.warning(
+                "FlashInfer MoE forward of %d rows exceeds the persistent workspace "
+                "ceiling of %d rows on %s; falling back to per-call allocation for "
+                "such forwards (set SGLANG_FLASHINFER_MOE_WORKSPACE_MAX_ROWS).",
+                rows,
+                ws.max_rows,
+                device,
+            )
+        return None
+    return ws.buffer
+
+
 def _activation_type(runner_config: MoeRunnerConfig):
     from sglang.srt.layers.moe.moe_runner.flashinfer_trtllm import get_activation_type
 
@@ -409,6 +584,34 @@ def fused_experts_none_to_flashinfer_mxfp4(
