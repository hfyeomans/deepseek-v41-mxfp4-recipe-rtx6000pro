+def _uva_view(pinned: torch.Tensor, device: torch.device) -> torch.Tensor:
+    """A CUDA tensor aliasing a pinned host tensor (the GPU reads it over PCIe).
+
+    Wraps the host allocation's device pointer via the CUDA array interface;
+    no copy. On UVA hosts cudaHostAlloc'd memory is mapped into the device
+    address space, so the pointer is the same; the runtime is still asked.
+    The pinned tensor is kept alive by the view.
+    """
+    assert pinned.is_pinned()
+    nbytes = pinned.numel() * pinned.element_size()
+    try:
+        import cuda.bindings.runtime as cuda_rt
+
+        err, dptr = cuda_rt.cudaHostGetDevicePointer(pinned.data_ptr(), 0)
+        if int(err) != 0:
+            raise RuntimeError(f"cudaHostGetDevicePointer failed: {err}")
+        dptr = int(dptr)
+    except ImportError:
+        dptr = pinned.data_ptr()
+
+    class _CAI:
+        __cuda_array_interface__ = {
+            "shape": (nbytes,),
+            "typestr": "|u1",
+            "data": (dptr, False),
+            "version": 3,
+            "strides": None,
+        }
+
+    view = torch.as_tensor(_CAI(), device=device).view(pinned.dtype).view(pinned.shape)
+    view._kt_host_owner = pinned  # type: ignore[attr-defined]
+    return view
+
+
+class _B2HostPool:
+    """One flat pinned allocation per process for every layer's B2 experts.
+
+    torch's caching host allocator rounds each pinned block up to a power of
+    two, so per-tensor allocations would waste ~35 % of RAM; one flat buffer
+    sized for all layers keeps the overhead to the final rounding only.
+    """
+
+    _buf: Optional[torch.Tensor] = None
+    _off = 0
+
+    @classmethod
+    def take(cls, method: "KTEPWrapperMethod", n: int, shape: Tuple[int, ...], dtype: torch.dtype) -> torch.Tensor:
+        nbytes = int(np.prod(shape)) * torch.empty(0, dtype=dtype).element_size()
+        if cls._buf is None:
+            layers = method.kt_config.num_layers or 1
+            per_layer = _HostSlice.nbytes(n, method.hidden_size, method.intermediate_size_per_partition)
+            # GPU layout is smaller than the export layout (uint8 vs bf16 scales); use it as the bound
+            total = layers * per_layer
+            cls._buf = torch.empty(total, dtype=torch.uint8, pin_memory=True)
+            logger.info("[KT B2] pinned host pool %.2f GiB for up to %d layers", total / 2**30, layers)
+        end = cls._off + nbytes
+        if end > cls._buf.numel():
+            raise RuntimeError("[KT B2] host pool exhausted (more MoE layers than kt_config.num_layers?)")
+        t = cls._buf[cls._off : end].view(dtype).view(*shape)
+        cls._off = end
+        return t
+
+
+class _B2UvaExperts:
+    """One layer's B2 experts: the last `n` CPU experts, host-resident in the
+    GPU kernel's layout and computed by the GPU straight out of host memory.
+
+    Built on every TP rank at load time by reusing the layerwise-prefill export
+    once (rank 0 exports the experts, every rank stages its TP slice, fixes
+    the layout up on the device and copies it back into its own pinned
+    tensors). At forward time `run()` is the same FlashInfer call the streamed
+    prefill makes, with weight tensors whose storage is host memory: the
+    grouped GEMM reads only the routed experts' rows, so the bytes moved are
+    data-dependent while the graph-captured work is not (T3.18 microbench:
+    39-41 GiB/s effective per link, bit-equal to device weights, replays).
+    """
+
+    def __init__(self, method: "KTEPWrapperMethod", streamer: _LayerwisePrefillCoordinator, n: int):
+        n_cpu = method.num_cpu_experts
+        if not 0 < n < n_cpu:
+            raise ValueError(f"KT_B2_UVA_EXPERTS={n} must be in (0, {n_cpu}) at this placement")
+        self.n = n
+        self.layer_idx = method.kt_config.layer_idx
+        # Original ids [first, global_num_experts) -> local [0, n); compact kt ids n_cpu-n .. n_cpu-1.
+        self.first = method.global_num_experts - n
+        self.device = streamer.device
+        rank = streamer.tp_rank
+
+        # 1. rank 0 exports the n experts into rows [0, n) of host buffer 0.
+        streamer.dma_done[0].synchronize()
+        streamer._barrier()
+        if rank == 0:
+            for i in range(n):
+                w13, s13, w2, s2 = streamer._ptrs[0][i]
+                method.wrapper.submit_write_weight_scale_to_buffer(
+                    streamer.tp_size, n_cpu - n + i, w13, s13, w2, s2
+                )
+            method.wrapper.sync_write_weight_scale_to_buffer()
+        streamer._barrier()
+
+        # 2. every rank stages its slice and fixes the layout up on the device
+        #    (rows >= n hold stale bytes and are ignored), then copies rows
+        #    [0, n) back into pinned host tensors it owns.
+        slots = streamer.slots
+        slots.load(streamer.host[0][rank])
+        self.host: Dict[str, torch.Tensor] = {}
+        self.w: Dict[str, torch.Tensor] = {}
+        for name, src in (("w13", slots.w13), ("s13", slots.s13), ("w2", slots.w2), ("s2", slots.s2)):
+            h = _B2HostPool.take(method, n, (n,) + tuple(src.shape[1:]), src.dtype)
+            h.copy_(src[:n], non_blocking=True)
+            self.host[name] = h
+        torch.cuda.current_stream(self.device).synchronize()
+        streamer.dma_done[0].record()
+        streamer._barrier()
+        for name, h in self.host.items():
+            self.w[name] = _uva_view(h, self.device)
+        self.global_scale = torch.ones(n, dtype=torch.float32, device=self.device)
+        self.nbytes = sum(h.numel() * h.element_size() for h in self.host.values())
+        if self.layer_idx == min(streamer.layers) or KT_GPU_PREFILL_LOG:
+            logger.info(
+                "[KT B2] layer %d: %d experts (ids %d..%d) host-resident for direct-UVA compute, "
+                "%.1f MiB pinned per layer per rank (%.2f GiB for %d layers); kt-kernel keeps %d",
+                self.layer_idx, n, self.first, method.global_num_experts - 1,
+                self.nbytes / 2**20, self.nbytes * (method.kt_config.num_layers or 1) / 2**30,
+                method.kt_config.num_layers or 1, n_cpu - n,
+            )
+
+    def run(
+        self,
+        method: "KTEPWrapperMethod",
+        layer: torch.nn.Module,
+        dispatch_output: "StandardDispatchOutput",
+        b2_topk_ids: torch.Tensor,
+    ) -> torch.Tensor:
+        """This rank's TP slice of the B2 experts' output (summed by the layer's all-reduce)."""
+        from sglang.srt.layers.moe.moe_runner.flashinfer_cutlass import (
+            FlashInferCutlassMxfp4MoeQuantInfo,
+        )
+
+        gm = method.gpu_method
+        lim = method.streamer._swiglu_limit_for(gm)
+        quant_info = FlashInferCutlassMxfp4MoeQuantInfo(
+            w13_weight=self.w["w13"],
+            w2_weight=self.w["w2"],
+            w13_weight_scale=self.w["s13"],
+            w2_weight_scale=self.w["s2"],
+            mxfp4_weight_global_scale=self.global_scale,
+            w13_bias=None,
+            w2_bias=None,
+            swiglu_alpha=None,
+            swiglu_beta=None,
+            swiglu_limit=None if lim is None else lim[: self.n],
+            use_swiglu_step=gm._use_swiglu_step,
+            moe_tp_size=layer.moe_tp_size,
+            moe_tp_rank=layer.moe_tp_rank,
+            moe_ep_size=layer.moe_ep_size,
+            moe_ep_rank=layer.moe_ep_rank,
+            padded_hidden=None,
+        )
+        topk_output = dispatch_output.topk_output._replace(topk_ids=b2_topk_ids)
+        return gm.runner.run(dispatch_output._replace(topk_output=topk_output), quant_info).hidden_states
+
+    def fork(
+        self,
+        method: "KTEPWrapperMethod",
+        layer: torch.nn.Module,
+        dispatch_output: "StandardDispatchOutput",
+        b2_topk_ids: torch.Tensor,
+    ) -> torch.Tensor:
+        """Enqueue run() on the B2 side stream, ordered after the current stream.
+
+        The result must go through join() before the current stream reads it.
+        Off the main stream the host-memory GEMM overlaps the resident-expert
+        tier *and* the kt-kernel wait instead of serialising in front of them
+        (T3.18 S=40 on the main stream: GPU busy 15 -> 25-30 ms/step).
+
+        FlashInfer's cutlass_fused_moe allocates its workspace per call on the
+        current stream and only sets tactics host-side under a mutex, so a
+        concurrent call on another stream shares no device state with the
+        resident tier's call.
+        """
+        side = _b2_stream(self.device)
+        side.wait_stream(torch.cuda.current_stream(self.device))
+        with torch.cuda.stream(side):
+            return self.run(method, layer, dispatch_output, b2_topk_ids)
+
+    def join(self, out: torch.Tensor) -> torch.Tensor:
+        """Make the current stream wait for fork()'s work before using ``out``.
+
+        Allocator safety without record_stream(): ``out`` lives in the side
+        stream's pool. It is dropped after the main stream's add, and the next
+        side-stream allocation (next layer's fork) happens only after that
+        fork's wait_stream(main), which is enqueued after the add -- so no
+        side-stream kernel can overwrite the block while main still reads it.
+        The same ordering holds inside a CUDA graph's private pool.
+        """
+        torch.cuda.current_stream(self.device).wait_stream(_b2_stream(self.device))
+        return out
+
+
+_B2_STREAMS: Dict[int, torch.cuda.Stream] = {}
+
+
+def _b2_stream(device: torch.device) -> torch.cuda.Stream:
+    """One side stream per device for B2 (layers run sequentially, so shared)."""
+    s = _B2_STREAMS.get(device.index)
+    if s is None:
+        s = torch.cuda.Stream(device=device)
+        _B2_STREAMS[device.index] = s
+    return s
+
+
