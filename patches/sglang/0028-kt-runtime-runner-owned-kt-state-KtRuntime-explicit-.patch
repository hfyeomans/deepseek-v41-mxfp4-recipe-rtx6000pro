diff --git a/python/sglang/srt/layers/moe/kt_loader.py b/python/sglang/srt/layers/moe/kt_loader.py
new file mode 100644
index 000000000..8f53d3d87
--- /dev/null
+++ b/python/sglang/srt/layers/moe/kt_loader.py
@@ -0,0 +1,67 @@
+"""Compact MXFP4 expert loader for the hybrid's CPU tier (recipe T3.19c).
+
+The hybrid shows kt-kernel a *compact* MoE: only the CPU-resident experts, as
+ids 0..num_cpu-1. kt's own ``MXFP4SafeTensorLoader.load_experts`` loads every
+expert of the layer (GPU ones included, ~2x the host RAM and load time), so
+this subclass loads the complement of ``gpu_experts_mask`` and nothing else.
+The mask is a constructor argument; ``KtRuntime.load_cpu_experts`` builds one
+loader per layer and hands it to kt explicitly (no class-wide patching).
+"""
+
+from __future__ import annotations
+
+import torch
+from kt_kernel.utils.loader import MXFP4SafeTensorLoader
+
+class CompactMXFP4Loader(MXFP4SafeTensorLoader):
+    def __init__(self, file_path: str, gpu_experts_mask: torch.Tensor):
+        super().__init__(file_path)
+        if gpu_experts_mask.dtype != torch.bool or gpu_experts_mask.dim() != 1:
+            raise ValueError(f"gpu_experts_mask must be a 1-D bool tensor, got {gpu_experts_mask.dtype} {tuple(gpu_experts_mask.shape)}")
+        self.gpu_experts_mask = gpu_experts_mask.cpu()
+        self.loaded_cpu_experts = 0
+
+    def load_experts(self, base_key: str, device: str = "cpu"):
+        mask = self.gpu_experts_mask
+        if not bool(mask.any()):
+            out = super().load_experts(base_key, device)
+            self.loaded_cpu_experts = len(out["gate"])
+            return out
+
+        gate_name, up_name, down_name = self.PROJ_NAMES
+        prefix = None
+        expert_count = 0
+        for cand in self._experts_prefix_candidates(base_key):
+            expert_count = 0
+            while self.has_tensor(f"{cand}.{expert_count}.{gate_name}.weight"):
+                expert_count += 1
+            if expert_count > 0:
+                prefix = cand
+                break
+        if prefix is None:
+            raise ValueError(
+                f"No MXFP4 experts found under any of: {self._experts_prefix_candidates(base_key)}"
+            )
+        if mask.numel() != expert_count:
+            raise ValueError(
+                f"gpu_experts_mask has {mask.numel()} entries but {prefix} holds {expert_count} experts"
+            )
+
+        cpu_ids = torch.nonzero(~mask, as_tuple=False).flatten().tolist()
+        out = {k: [] for k in ("gate", "up", "down", "gate_scale", "up_scale", "down_scale")}
+        for exp_id in cpu_ids:
+            for proj, dst in ((gate_name, "gate"), (up_name, "up"), (down_name, "down")):
+                w = self.load_tensor(f"{prefix}.{exp_id}.{proj}.weight", device).contiguous()
+                if w.dtype != torch.uint8:
+                    w = w.view(torch.uint8)
+                out[dst].append(w)
+                out[dst + "_scale"].append(
+                    self._ue8m0_to_bf16(self.load_tensor(f"{prefix}.{exp_id}.{proj}.scale", device))
+                )
+        self.loaded_cpu_experts = len(cpu_ids)
+        # print, like kt's own loaders: the launch log is the record (evidence READMEs).
+        print(
+            f"[MXFP4SafeTensorLoader] Loaded {len(cpu_ids)} CPU experts from {prefix} as compact "
+            f"ids 0..{len(cpu_ids) - 1} ({expert_count - len(cpu_ids)} GPU experts not loaded)"
+        )
+        return out
