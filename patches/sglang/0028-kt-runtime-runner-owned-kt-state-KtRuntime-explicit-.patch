diff --git a/python/sglang/srt/layers/moe/kt_runtime.py b/python/sglang/srt/layers/moe/kt_runtime.py
new file mode 100644
index 000000000..81573374a
--- /dev/null
+++ b/python/sglang/srt/layers/moe/kt_runtime.py
@@ -0,0 +1,199 @@
+"""Runner-owned state of the CPU expert tier (recipe T3.19c).
+
+Everything the hybrid used to keep in module or class globals lives on one
+``KtRuntime`` per ``ModelRunner``:
+
+  providers / leases / ledger   the CpuExpertProvider registry (kt_provider.py)
+  prefill_coordinator           the layerwise streamed-prefill coordinator
+                                (kt_ep_wrapper.py), one per TP-rank process
+  timeline                      the opt-in KT_TIMELINE recorder (kt_timeline.py)
+  side streams                  one per device, for work forked off the
+                                forward stream (B2; retired by T3.16j)
+  load_cpu_experts()            the compact MXFP4 load: an explicit
+                                CompactMXFP4Loader handed to kt-kernel per
+                                layer instead of a class-wide monkey-patch
+
+Two runtimes in one process share nothing (``test_kt_runtime.py``).
+
+How a layer gets its runtime
+----------------------------
+SGLang builds the MoE layers deep inside ``ModelRunner.load_model`` through
+the model's constructor, which has no runner parameter; the layers resolve
+``get_server_args()`` from the process the same way. ``ModelRunner`` therefore
+``activate()``s its runtime for the duration of ``load_model`` and
+``create_kt_config_from_server_args`` copies ``current()`` into ``KTConfig``.
+That one scoped handle is the only process-level state left; after
+``load_model`` returns it is gone and every layer, graph runner and backend
+reaches the runtime through the object that owns it (``kt_config.runtime``,
+``model_runner.kt_runtime``).
+"""
+
+from __future__ import annotations
+
+import contextlib
+import logging
+from typing import TYPE_CHECKING, Any, Dict, Iterator, List, Optional, Sequence
+
+import torch
+
+from sglang.srt.layers.moe.kt_contract import KTContractError
+from sglang.srt.layers.moe.kt_provider import (
+    BufferLease,
+    CaptureContract,
+    ForwardLedger,
+    KtKernelProvider,
+)
+
+if TYPE_CHECKING:
+    from sglang.srt.layers.moe.kt_timeline import StepTimeline
+    from sglang.srt.model_executor.model_runner import ModelRunner
+
+logger = logging.getLogger(__name__)
+
+
+class KtRuntime:
+    def __init__(self, *, tp_rank: int, timeline: Optional["StepTimeline"] = None) -> None:
+        self.tp_rank = int(tp_rank)
+        self.providers: List[KtKernelProvider] = []
+        self.leases: Dict[int, BufferLease] = {}
+        self.ledger = ForwardLedger()
+        # Set by the first KTEPWrapperMethod that wants streamed prefill
+        # (KT_GPU_PREFILL_MIN_TOKENS > 0); every later layer registers with it.
+        self.prefill_coordinator: Optional[Any] = None
+        self.timeline = timeline
+        self._side_streams: Dict[int, torch.cuda.Stream] = {}
+
+    # -- construction --------------------------------------------------------------
+
+    @classmethod
+    def for_runner(cls, model_runner: "ModelRunner") -> Optional["KtRuntime"]:
+        """The runner's runtime, or None when this runner has no CPU expert tier."""
+        from sglang.srt.runtime_context import get_exec
+
+        if model_runner.device != "cuda" or get_exec().moe.kt_weight_path is None:
+            return None
+        from sglang.srt.layers.moe.kt_timeline import KT_TIMELINE, StepTimeline
+
+        tp_rank = model_runner.ps.tp_rank
+        timeline = StepTimeline(tp_rank) if KT_TIMELINE else None
+        return cls(tp_rank=tp_rank, timeline=timeline)
+
+    # -- providers -----------------------------------------------------------------
+
+    def new_provider(
+        self, wrapper: Any, *, layer_idx: int, hidden: int, top_k: int, max_deferred: int
+    ) -> KtKernelProvider:
+        p = KtKernelProvider(
+            wrapper,
+            layer_idx=layer_idx,
+            hidden=hidden,
+            top_k=top_k,
+            max_deferred=max_deferred,
+            ledger=self.ledger,
+            leases=self.leases,
+        )
+        self.providers.append(p)
+        return p
+
+    def reserve_capture_sizes(self, batch_sizes: Sequence[int]) -> None:
+        """Runner entry point: register the token counts the graphs will capture.
+
+        Calls kt's own registration (accumulating, T3.16a) exactly as the runner
+        did before, then hands every provider its contract. Safe before any
+        provider exists (kt registration only) and when kt is not installed.
+        """
+        try:
+            from kt_kernel import KTMoEWrapper
+        except ImportError:
+            return
+        KTMoEWrapper.set_capture_batch_sizes(list(batch_sizes))
+        registered = tuple(KTMoEWrapper.get_capture_batch_sizes())
+        for p in self.providers:
+            p.reserve(CaptureContract(registered, p.hidden, p.top_k))
+
+    # -- streams -------------------------------------------------------------------
+
+    def side_stream(self, device: torch.device) -> torch.cuda.Stream:
+        """One side stream per device (layers run sequentially, so shared)."""
+        s = self._side_streams.get(device.index)
+        if s is None:
+            s = torch.cuda.Stream(device=device)
+            self._side_streams[device.index] = s
+        return s
+
+    # -- weights -------------------------------------------------------------------
+
+    def load_cpu_experts(
+        self, wrapper: Any, cpu_ids: torch.Tensor, gpu_experts_mask: torch.Tensor
+    ) -> None:
+        """Load one layer's CPU experts into kt-kernel as a compact MoE.
+
+        kt's ``NativeMoEWrapper`` keeps its loader in the class slot
+        ``_native_loader_instance``: the first wrapper's ``__init__`` fills it
+        with a plain ``MXFP4SafeTensorLoader``, ``load_weights`` reads the slot
+        (refilling it when empty) and releases it at the end of every layer.
+        That slot is the injection point kt offers, so a ``CompactMXFP4Loader``
+        built for this layer's mask goes in just before the call (kt's own
+        pre-created plain loader, present only before the first layer, is
+        released), and the wrapper is checked to have used it: a plain loader
+        would hand kt all experts under shifted ids and nothing downstream
+        would notice until the sums were wrong.
+        """
+        from kt_kernel.utils.amx import NativeMoEWrapper
+        from kt_kernel.utils.loader import MXFP4SafeTensorLoader
+
+        from sglang.srt.layers.moe.kt_loader import CompactMXFP4Loader
+
+        if not isinstance(wrapper, NativeMoEWrapper) or wrapper.method != "MXFP4":
+            raise KTContractError(
+                f"layer {wrapper.layer_idx}: compact CPU experts need kt's NativeMoEWrapper "
+                f"with method MXFP4, got {type(wrapper).__name__} / {getattr(wrapper, 'method', None)}"
+            )
+        slot = NativeMoEWrapper._native_loader_instance
+        if slot is not None:
+            if isinstance(slot, CompactMXFP4Loader) or not isinstance(slot, MXFP4SafeTensorLoader):
+                raise KTContractError(
+                    f"layer {wrapper.layer_idx}: kt still holds a {type(slot).__name__} from a previous "
+                    "layer; it releases the slot after every load_weights, so this is a kt-kernel change."
+                )
+            NativeMoEWrapper._release_loader()  # kt's constructor-made plain loader
+        loader = CompactMXFP4Loader(wrapper.weight_path, gpu_experts_mask)
+        NativeMoEWrapper._native_loader_instance = loader
+        try:
+            wrapper.load_weights(cpu_ids)
+        finally:
+            if NativeMoEWrapper._native_loader_instance is loader:
+                NativeMoEWrapper._release_loader()
+        if wrapper.loader is not loader:
+            raise KTContractError(
+                f"layer {wrapper.layer_idx}: kt loaded the experts through "
+                f"{type(wrapper.loader).__name__}, not the compact loader it was handed."
+            )
+        if loader.loaded_cpu_experts != int(cpu_ids.numel()):
+            raise KTContractError(
+                f"layer {wrapper.layer_idx}: compact loader produced {loader.loaded_cpu_experts} "
+                f"experts for {int(cpu_ids.numel())} compact ids."
+            )
+
+
+# --------------------------------------------------------------------------- scoped handle
+
+_ACTIVE: Optional[KtRuntime] = None
+
+
+def current() -> Optional[KtRuntime]:
+    """The runtime of the ModelRunner currently inside ``load_model``, else None."""
+    return _ACTIVE
+
+
+@contextlib.contextmanager
+def activate(runtime: Optional[KtRuntime]) -> Iterator[None]:
+    """Make ``runtime`` visible to the layers ``load_model`` is about to build."""
+    global _ACTIVE
+    if _ACTIVE is not None:
+        raise KTContractError("KtRuntime.activate() nested: two ModelRunners loading at once in one process.")
+    _ACTIVE = runtime
+    try:
+        yield
+    finally:
+        _ACTIVE = None
