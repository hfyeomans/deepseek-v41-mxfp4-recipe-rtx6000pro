+def select_candidate_block_ids(
+    logits: torch.Tensor,
+    compress_lens: torch.Tensor | int,
+    topk_blocks: int,
+    block_size: int,
+) -> torch.Tensor:
+    """`select_candidate_block_keep` as an int32 block-ID list
+    `[rows, min(topk_blocks, num_blocks)]`, -1 where the row has fewer reachable
+    blocks than that. Prefill publishes this form: the keep mask is one byte per
+    block of prefix per row (1 GiB for an 8192-row chunk at 1M), the ID list is
+    4 B x topk_blocks per row whatever the prefix (64 MiB at the model's 2048
+    blocks; recipe E34e e-i). `expand_candidate_ids` is the per-position mask."""
+    width = logits.size(-1)
+    scores = F.pad(logits, (0, -width % block_size), value=-torch.inf)
+    scores = scores.unflatten(-1, (-1, block_size)).amax(dim=-1)
+    num_blocks = scores.size(-1)
+
+    last = (compress_lens - 1) // block_size
+    scores = scores.masked_fill(
+        torch.arange(num_blocks, device=logits.device) == last, torch.inf
+    )
+
+    top = scores.topk(min(topk_blocks, num_blocks), dim=-1)
+    return torch.where(top.values > -torch.inf, top.indices, -1).to(torch.int32)
+
+
+def expand_candidate_ids(
+    ids: torch.Tensor, block_size: int, width: int
+) -> torch.Tensor:
+    """Per-position bool mask `[rows, width]` from a block-ID list. The -1 entries
+    land in a spare column past the last block (a clamp to 0 would race a real
+    block-0 pick inside scatter_)."""
+    num_blocks = -(-width // block_size)
+    keep = torch.zeros(
+        (*ids.shape[:-1], num_blocks + 1), dtype=torch.bool, device=ids.device
+    )
+    keep.scatter_(
+        -1, ids.masked_fill(ids < 0, num_blocks).to(torch.int64), True
+    )
+    return expand_candidate_blocks(keep[..., :num_blocks], block_size, width)
+
+
