+    def hash_chunk(self, chunk: EngramNextChunk) -> torch.Tensor:
+        """Hash ids [T, L, cols] of one request's upcoming extend chunk, without
+        touching `self.history` (the chunk's own forward commits). Same kernel
+        and inputs as the extend path, so the ids equal the ones that forward
+        will compute for the same tokens (recipe T3.20 (c))."""
