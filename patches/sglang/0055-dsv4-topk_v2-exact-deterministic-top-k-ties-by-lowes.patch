+ private:
+  /// Cluster-wide counterpart of refine_and_collect (T3.15d). Entered by every
+  /// rank right after bar-3 with rank 0's `count_gt` / `count_eq` final (the
+  /// latter untruncated). Returns without any barrier when the threshold bin
+  /// fits; otherwise all ranks run the same number of rounds, each with two
+  /// cluster barriers (Q: peers publish their histogram slice; S: rank 0
+  /// publishes the match), then one more (C) after the survivors are
+  /// re-collected into rank 0's `tie_values`. Rank 0's `count_gt` / `count_eq`
+  /// are final on return for rank 0; peers must not touch rank 0's smem after
+  /// returning.
+  SGL_DEVICE static void cluster_refine(  //
+      const TopKProblem& problem,
+      Smem* smem,
+      Smem* smem_0,
+      const uint32_t this_rank) {
+    const auto tx = threadIdx.x;
+    const auto topk = problem.topk;
+    const auto total_eq = smem_0->count_eq;
+    const auto total_gt = smem_0->count_gt;
+    if (!(total_eq > kMaxNumTie && total_gt < topk)) [[likely]] return;
+
+    RefineState state{smem_0->v_lo, smem_0->v_hi, 0, 0, total_eq, 56};
+    auto* local_hist = smem->tie_handle.histogram[1];
+    auto* merged_hist = smem_0->tie_handle.histogram[0];  // zeroed by rank 0 before bar-3
+#pragma unroll 1
+    for (uint32_t round = 0; round < kRefineRounds; ++round) {
+      const auto shift = state.shift;
+      if (tx < kRadixSize) local_hist[tx] = 0;
+      __syncthreads();
+      uint64_t t_and = ~0ull, t_or = 0ull;
+      for_each_input<N>(problem.in, problem.seq_len, [&](float val, uint32_t idx) {
+        const auto key = refine_key(val, idx);
+        if (in_range(state, val, key)) {
+          t_and &= key;
+          t_or |= key;
+          hist_add_aggregated(local_hist, (key >> shift) & 0xFFu);
+        }
+      });
+      fold_key_bits(t_and, t_or, &smem_0->tie_handle);  // remote 64-bit atomics for peers
+      __syncthreads();
+      if (tx < kRadixSize) {
+        if (const auto count = local_hist[tx]; count != 0) atomicAdd(&merged_hist[tx], count);
+      }
+      // barrier Q: the merged histogram and key bits are complete on rank 0
+      if (this_rank != 0) {
+        barrier_cluster_arrive_release();
+      } else {
+        barrier_cluster_arrive_relaxed();
+      }
+      barrier_cluster_wait();
+      if (this_rank == 0) {
+        scan_threshold(merged_hist, state.count_eq, topk - smem->count_gt, &smem->tie_handle);
+        // scan_threshold ended on __syncthreads: match is published, the
+        // histogram and key bits are consumed and can be reset for the next
+        // round (the peers' next remote adds follow barrier S).
+        if (tx < kRadixSize) merged_hist[tx] = 0;
+        if (tx == 0) {
+          smem->tie_handle.key_and_pub = smem->tie_handle.key_and;
+          smem->tie_handle.key_or_pub = smem->tie_handle.key_or;
+          smem->tie_handle.key_and = ~0ull;
+          smem->tie_handle.key_or = 0ull;
+          const auto equal_count = smem->tie_handle.match.equal_count;
+          const bool last = equal_count <= kMaxNumTie || round + 1 == kRefineRounds;
+          if (last) smem->count_eq = 0;  // the collect below restarts from 0
+        }
+        __syncthreads();
+      }
+      // barrier S: rank 0 publishes match + key bits (+ reset histogram / count_eq)
+      if (this_rank == 0) {
+        barrier_cluster_arrive_release();
+      } else {
+        barrier_cluster_arrive_relaxed();
+      }
+      barrier_cluster_wait();
+      const auto [threshold_bin, above_count, equal_count] = smem_0->tie_handle.match;
+      const auto key_and = smem_0->tie_handle.key_and_pub;
+      const auto key_or = smem_0->tie_handle.key_or_pub;
+      const bool last = equal_count <= kMaxNumTie || round + 1 == kRefineRounds;
+      // as in refine_and_collect: emit above the matched byte, collect the
+      // survivors into rank 0's buffer on the last round, skip the pass when
+      // neither applies; every rank read `match` before its next arrive, so
+      // rank 0 cannot overwrite it early
+      if (last || above_count != 0) {
+        for_each_input<N>(problem.in, problem.seq_len, [&](float val, uint32_t idx) {
+          const auto key = refine_key(val, idx);
+          if (in_range(state, val, key)) {
+            const auto bin = (key >> shift) & 0xFFu;
+            if (bin > threshold_bin) {
+              const auto pos = atomicAdd(&smem_0->count_gt, 1);
+              if (pos < topk) [[likely]] problem.emit(pos, idx);
+            } else if (last && bin == threshold_bin) {
+              const auto pos = atomicAdd(&smem_0->count_eq, 1);
+              if (pos < kMaxNumTie) [[likely]] smem_0->tie_values[pos] = {val, idx};
+            }
+          }
+        });
+      }
+      advance_state(state, threshold_bin, equal_count, key_and, key_or);
+      if (last) break;
+    }
+    // barrier C: count_gt / count_eq / tie_values complete on rank 0
+    if (this_rank != 0) {
+      barrier_cluster_arrive_release();
+    } else {
+      barrier_cluster_arrive_relaxed();
+    }
+    barrier_cluster_wait();
+    __syncthreads();
+  }
 };
 
 #endif  // !USE_ROCM
