+
+  // -------------------------------------------------------------------------
+  // Overfull threshold bin (recipe T3.15d, sgl-project/sglang #35257).
+  //
+  // The collect pass keeps at most kMaxNumTie candidates of the coarse
+  // threshold bin. Upstream truncates beyond that and hands handle_tie an
+  // arrival-ordered sample, so a bin with more members than the cap (bf16 relu
+  // scores share fp16 bins by the thousands at long context) yields an inexact
+  // top-k whose membership moves between runs. Instead, narrow the bin over
+  // the 64-bit key (exact fp32 value, then ~index so a smaller index ranks
+  // first, matching `is_greater`) with further passes over the input until
+  // the survivors fit, emitting everything that ranks strictly above the
+  // narrowed range on the way. The result is the exact top-k under the
+  // (value desc, index asc) order, independent of scheduling.
+  //
+  // Each round histograms one byte of the key. The common case is a tie of
+  // one exact value (relu zeros), where the value bytes and the high index
+  // bytes are the same for every candidate; every pass therefore also ANDs /
+  // ORs the keys, the bits found constant are folded into the prefix, and the
+  // next round moves to the highest bit still open, so such a tie resolves in
+  // two or three rounds instead of seven. The histogram adds are
+  // warp-aggregated (`__match_any_sync`): a degenerate round puts every
+  // element in one bin, and one shared-memory atomic per warp instead of one
+  // per element keeps that round at the cost of the read.
+  // -------------------------------------------------------------------------
+
+  struct RefineState {
+    float v_lo;
+    float v_hi;
+    uint64_t prefix;
+    uint64_t mask;
+    uint32_t count_eq;  // elements in range
+    uint32_t shift;     // low bit of the byte the current round histograms
+  };
+
+  SGL_DEVICE static uint64_t refine_key(float val, uint32_t idx) {
+    return (static_cast<uint64_t>(extract_exact_bin(val)) << 32) | static_cast<uint64_t>(~idx);
+  }
+
+  SGL_DEVICE static bool in_range(const RefineState& s, float val, uint64_t key) {
+    // NaN padding fails both bounds
+    return val >= s.v_lo && val < s.v_hi && (key & s.mask) == s.prefix;
+  }
+
+  static constexpr uint32_t kRefineRounds = 64;  // bound only; >= 1 new key bit per round
+
+  /// The byte window whose top bit is the highest bit not yet fixed by `mask`.
+  SGL_DEVICE static uint32_t next_shift(uint64_t mask) {
+    const auto open = ~mask;
+    const uint32_t hb = open == 0 ? 0 : 63 - __clzll(static_cast<long long>(open));
+    return hb >= 7 ? hb - 7 : 0;
+  }
+
+  /// One shared-memory histogram add, aggregated when the warp's active lanes
+  /// all hit the same bin (the degenerate round of a one-value tie). Called
+  /// under divergence (only the lanes with an in-range element), hence
+  /// __activemask; two shuffles are far cheaper than __match_any_sync here.
+  SGL_DEVICE static void hist_add_aggregated(uint32_t* histogram, uint32_t bin) {
+#ifndef USE_ROCM
+    const auto active = __activemask();
+    const auto leader = __ffs(active) - 1;
+    const auto leader_bin = __shfl_sync(active, bin, leader);
+    if (__all_sync(active, bin == leader_bin)) {
+      if (threadIdx.x % kWarpSize == leader) atomicAdd(&histogram[bin], __popc(active));
+    } else {
+      atomicAdd(&histogram[bin], 1);
+    }
+#else
+    atomicAdd(&histogram[bin], 1);
+#endif
+  }
+
+  /// Warp-reduce the per-thread key AND / OR and fold them into `smem`.
+  /// All lanes must be converged (call after the pass, outside the lambda).
+  SGL_DEVICE static void fold_key_bits(uint64_t t_and, uint64_t t_or, TieHandleSmem* smem) {
+#pragma unroll
+    for (uint32_t offset = kWarpSize / 2; offset > 0; offset /= 2) {
+#ifndef USE_ROCM
+      t_and &= __shfl_xor_sync(0xFFFFFFFF, t_and, offset);
+      t_or |= __shfl_xor_sync(0xFFFFFFFF, t_or, offset);
+#else
+      t_and &= __shfl_xor(t_and, offset, kWarpThreads);
+      t_or |= __shfl_xor(t_or, offset, kWarpThreads);
+#endif
+    }
+    if (threadIdx.x % kWarpSize == 0) {
+      atomicAnd(&smem->key_and, static_cast<unsigned long long>(t_and));
+      atomicOr(&smem->key_or, static_cast<unsigned long long>(t_or));
+    }
+  }
+
+  /// Fold a round's result into `state`: the matched byte, the bits found
+  /// constant over all candidates (from key_and / key_or), the survivor
+  /// count, and the next window.
+  SGL_DEVICE static void advance_state(
+      RefineState& state,
+      const uint32_t threshold_bin,
+      const uint32_t equal_count,
+      const uint64_t key_and,
+      const uint64_t key_or) {
+    const uint64_t constant = ~(key_and ^ key_or);
+    state.prefix |= static_cast<uint64_t>(threshold_bin) << state.shift;
+    state.mask |= static_cast<uint64_t>(0xFFu) << state.shift;
+    state.prefix |= key_and & constant & ~state.mask;
+    state.mask |= constant;
+    state.count_eq = equal_count;
+    state.shift = next_shift(state.mask);
+  }
+
+  /// Register / streaming paths: narrow `state` until it holds at most
+  /// kMaxNumTie elements (or one exact (value, index)), emitting the elements
+  /// that rank above the narrowed range at `count_gt` positions, then refill
+  /// `tie_values` from the survivors. `for_each(fn)` must call `fn(val, idx)`
+  /// for every input element, identically on every call. On return
+  /// `*count_gt_smem` / `*count_eq_smem` hold the new counts (visible to all
+  /// threads after the trailing __syncthreads).
+  template <typename ForEach>
+  SGL_DEVICE static void refine_and_collect(  //
+      const TopKProblem& problem,
+      RefineState state,
+      uint32_t* count_gt_smem,
+      uint32_t* count_eq_smem,
+      TieValue* tie_values,
+      TieHandleSmem* scratch,
+      ForEach&& for_each) {
+    const auto tx = threadIdx.x;
+    const auto topk = problem.topk;
+    auto* histogram = scratch->histogram[0];
+#pragma unroll 1
+    for (uint32_t round = 0; round < kRefineRounds; ++round) {
+      const auto shift = state.shift;
+      if (tx < kRadixSize) histogram[tx] = 0;
+      if (tx == 0) {
+        scratch->key_and = ~0ull;
+        scratch->key_or = 0ull;
+      }
+      __syncthreads();
+      uint64_t t_and = ~0ull, t_or = 0ull;
+      for_each([&](float val, uint32_t idx) {
+        const auto key = refine_key(val, idx);
+        if (in_range(state, val, key)) {
+          t_and &= key;
+          t_or |= key;
+          hist_add_aggregated(histogram, (key >> shift) & 0xFFu);
+        }
+      });
+      fold_key_bits(t_and, t_or, scratch);
+      __syncthreads();
+      const auto count_gt = *count_gt_smem;
+      if (tx == 0) *count_eq_smem = 0;  // the last pass re-collects from 0
+      scan_threshold(histogram, state.count_eq, topk - count_gt, scratch);
+      const auto [threshold_bin, above_count, equal_count] = scratch->match;
+      const auto key_and = scratch->key_and;
+      const auto key_or = scratch->key_or;
+      const bool last = equal_count <= kMaxNumTie || round + 1 == kRefineRounds;
+      // one pass emits what ranks above the matched byte and, on the last
+      // round, collects the survivors; a non-last round with nothing above
+      // (every candidate shares the byte) needs no pass at all
+      if (last || above_count != 0) {
+        for_each([&](float val, uint32_t idx) {
+          const auto key = refine_key(val, idx);
+          if (in_range(state, val, key)) {
+            const auto bin = (key >> shift) & 0xFFu;
+            if (bin > threshold_bin) {
+              const auto pos = atomicAdd(count_gt_smem, 1);
+              if (pos < topk) [[likely]] problem.emit(pos, idx);
+            } else if (last && bin == threshold_bin) {
+              const auto pos = atomicAdd(count_eq_smem, 1);
+              if (pos < kMaxNumTie) [[likely]] tie_values[pos] = {val, idx};
+            }
+          }
+        });
+      }
+      advance_state(state, threshold_bin, equal_count, key_and, key_or);
+      __syncthreads();  // count_gt / count_eq / tie_values complete
+      if (last) break;
+    }
+  }
 };
 
