+class _FileTable:
+    """`file` layout (recipe overlay, E6-DESIGN 4.3 A-min): the Engram table
+    stays in the checkpoint shard. V4.1-Flash stores each layer's table as one
+    contiguous fp8 tensor plus its e8m0 scale tensor inside a single safetensors
+    shard (layer 1 -> model-00047, layer 14 -> model-00048; 384M rows x 264 B =
+    94.4 GiB each), so a read-only MAP_SHARED mapping of the shard and two
+    views are the whole table. Nothing is copied, nothing is pinned; the page
+    cache is the row cache and its size is whatever DRAM the experts leave.
+
+    Lookups run on the CPU (an eager break in the CUDA graph): the rows' pages
+    are advised with MADV_WILLNEED from a small thread pool so a cold miss
+    costs one NVMe queue-depth-N round trip (~1 ms for 48 rows, ~0.5 s for a
+    4K-token prefill chunk on the 9100 PRO) instead of serialised page faults
+    (6x slower). Every TP rank maps the same file and owns its row range, so
+    the existing sharded all-reduce path reassembles the lookup and the two
+    ranks share one page cache."""
+
+    def __init__(self, model_dir: str, layer_id: int, row_start: int, rows: int):
+        snapshot = envs.SGLANG_DSV41_ENGRAM_FILE_DIR.get() or model_dir
+        index_path = os.path.join(snapshot, "model.safetensors.index.json")
+        if not os.path.exists(index_path):
+            raise FileNotFoundError(
+                f"engram file layout: {index_path} not found; point "
+                "SGLANG_DSV41_ENGRAM_FILE_DIR at the checkpoint snapshot directory"
+            )
+        with open(index_path) as fh:
+            weight_map = json.load(fh)["weight_map"]
+        w_name = f"layers.{layer_id}.engram.embed.weight"
+        s_name = f"layers.{layer_id}.engram.embed.scale"
+        if weight_map[w_name] != weight_map[s_name]:
+            raise RuntimeError("engram file layout: weight and scale live in different shards")
+        self.path = os.path.join(snapshot, weight_map[w_name])
+        with open(self.path, "rb") as fh:
+            n = struct.unpack("<Q", fh.read(8))[0]
+            header = json.loads(fh.read(n))
+        base = 8 + n
+        w, sc = header[w_name], header[s_name]
+        if w["dtype"] != "F8_E4M3" or sc["dtype"] != "F8_E8M0":
+            raise RuntimeError(f"engram file layout: unexpected dtypes {w['dtype']}/{sc['dtype']}")
+        self.total_rows, self.dim = w["shape"]
+        self.row_start, self.rows = row_start, rows
+        self.w_off = base + w["data_offsets"][0]
+        self.s_off = base + sc["data_offsets"][0]
+        self.fd = os.open(self.path, os.O_RDONLY)
+        self.mm = mmap.mmap(self.fd, 0, flags=mmap.MAP_SHARED, prot=mmap.PROT_READ)
+        self.mm.madvise(mmap.MADV_RANDOM)  # 48-row lookups must not pull readahead windows
+        raw = torch.frombuffer(self.mm, dtype=torch.uint8)
+        scale_cols = self.dim // FP8_BLOCK_SIZE
+        w_lo = self.w_off + row_start * self.dim
+        s_lo = self.s_off + row_start * scale_cols
+        self.weight = raw[w_lo : w_lo + rows * self.dim].view(torch.float8_e4m3fn).view(rows, self.dim)
+        self.scale = raw[s_lo : s_lo + rows * scale_cols].view(torch.float8_e8m0fnu).view(rows, scale_cols)
+        self.threads = max(1, envs.SGLANG_DSV41_ENGRAM_FILE_THREADS.get())
+        self.pool = ThreadPoolExecutor(self.threads, thread_name_prefix="engram-willneed")
+        self.stats = {"lookups": 0, "rows": 0, "ms": 0.0}
+
+    def prefetch(self, local_rows: list[int]) -> None:
+        """MADV_WILLNEED every page the rows touch, from `threads` workers."""
+        page = mmap.PAGESIZE
+        scale_cols = self.dim // FP8_BLOCK_SIZE
+        w_base = self.w_off + self.row_start * self.dim
+        s_base = self.s_off + self.row_start * scale_cols
+        mm, dim = self.mm, self.dim
+
+        def advise(lo: int, hi: int) -> None:
+            for r in local_rows[lo:hi]:
+                a = (w_base + r * dim) // page * page
+                mm.madvise(mmap.MADV_WILLNEED, a, page)
+                b = (s_base + r * scale_cols) // page * page
+                mm.madvise(mmap.MADV_WILLNEED, b, page)
+
+        n = len(local_rows)
+        if n == 0:
+            return
+        step = max(1, (n + self.threads - 1) // self.threads)
+        list(self.pool.map(lambda k: advise(k, min(n, k + step)), range(0, n, step)))
+
+    def gather(self, local: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+        """fp8 rows and e8m0 scales for local (0-based, in-range) row ids, on CPU."""
+        t = time.perf_counter()
+        self.prefetch(local.tolist())
+        w = self.weight.index_select(0, local)
+        s = self.scale.index_select(0, local)
+        self.stats["lookups"] += 1
+        self.stats["rows"] += local.numel()
+        self.stats["ms"] += (time.perf_counter() - t) * 1e3
+        return w, s
+
+    def describe(self) -> str:
+        return (
+            f"layout=file, {os.path.basename(self.path)} rows [{self.row_start}, "
+            f"{self.row_start + self.rows}) of {self.total_rows}, "
+            f"{self.rows * (self.dim + self.dim // FP8_BLOCK_SIZE) / 2**30:.1f} GiB mapped read-only, "
+            f"{self.threads} prefetch threads, page cache is the row cache"
+        )
+
+
+def _engram_file_rows(embed: "EngramEmbedding", indices: torch.Tensor) -> torch.Tensor:
+    """The CPU lookup for the file layout, as one graph break. Returns bf16
+    (*indices.shape, dim) on indices.device with unowned rows zeroed, for the
+    sharded all-reduce."""
+    if torch.cuda.is_available() and torch.cuda.is_current_stream_capturing():
+        raise RuntimeError(
+            "engram file layout: lookup reached a live CUDA graph capture. It is a "
+            "CPU lookup and must run as an eager break: use "
+            "--cuda-graph-backend-decode breakable (and tc_piecewise/breakable "
+            "for prefill), or disable CUDA graphs."
+        )
+    tbl = embed.file_table
+    ids = indices.reshape(-1).to("cpu", dtype=torch.int64)
+    local = ids - tbl.row_start
+    owned = (local >= 0) & (local < tbl.rows)
+    local = local.masked_fill(~owned, 0)
+    w, s = tbl.gather(local)
+    dev = indices.device
+    rows = w.to(dev, non_blocking=False).float().unflatten(-1, (-1, FP8_BLOCK_SIZE))
+    values = (rows * s.to(dev, non_blocking=False).float().unsqueeze(-1)).flatten(-2)
+    values = values.to(torch.bfloat16).masked_fill(~owned.to(dev).unsqueeze(-1), 0)
+    return values.view(*indices.shape, embed.dim)
+
+
+bcg_engram_file_rows = eager_on_graph(True)(_engram_file_rows)
+
+
