+class TriggerDump:
+    """Full-row capture of the top-k input and output at one compressed sequence length.
+
+    Every in-graph call tests ``seq_lens[0] == trigger`` on the device and, when it
+    holds, writes the row into the next ring slot; the slot counter advances by the
+    0/1 hit so the graph needs no host decision. ``logits`` rows are truncated or
+    zero-padded to ``width`` columns.
+    """
+
+    SLOTS = 128
+    META = ("step", "layer", "seq_len", "hit")
+
+    def __init__(self, trigger: int, device: torch.device, width: int = 131072, topk: int = 512):
+        self.trigger = trigger
+        self.width = width
+        self.logits = torch.zeros((self.SLOTS, width), dtype=torch.float32, device=device)
+        self.selected = torch.full((self.SLOTS, topk), -2, dtype=torch.int32, device=device)
+        self.meta = torch.zeros((self.SLOTS, len(self.META)), dtype=torch.int64, device=device)
+        self.hits = torch.zeros((), dtype=torch.int64, device=device)
+        self._trigger_t = torch.full((), trigger, dtype=torch.int64, device=device)
+
+    def record(self, step: torch.Tensor, layer_id: int, seq_lens: torch.Tensor,
+               logits: torch.Tensor, selected: torch.Tensor) -> None:
+        hit = (seq_lens[0].to(torch.int64) == self._trigger_t)
+        slot = (self.hits % self.SLOTS).reshape(1)
+        row = logits[0].detach().to(torch.float32).reshape(-1)
+        if row.numel() >= self.width:
+            row = row[: self.width]
+        else:
+            row = torch.nn.functional.pad(row, (0, self.width - row.numel()))
+        self.logits.index_copy_(0, slot, torch.where(hit, row, self.logits.index_select(0, slot)[0]).unsqueeze(0))
+        sel = selected[0].detach().to(torch.int32).reshape(-1)[: self.selected.shape[1]]
+        if sel.numel() < self.selected.shape[1]:
+            sel = torch.nn.functional.pad(sel, (0, self.selected.shape[1] - sel.numel()), value=-2)
+        self.selected.index_copy_(0, slot, torch.where(hit, sel, self.selected.index_select(0, slot)[0]).unsqueeze(0))
+        meta = torch.stack([step, torch.full_like(step, layer_id), seq_lens[0].to(torch.int64), hit.to(torch.int64)])
+        self.meta.index_copy_(0, slot, torch.where(hit, meta, self.meta.index_select(0, slot)[0]).unsqueeze(0))
+        self.hits.add_(hit.to(torch.int64))
+
+    def snapshot(self) -> dict:
+        return {"trigger": self.trigger, "meta_columns": self.META, "hits": int(self.hits.item()),
+                "logits": self.logits.to("cpu", copy=True), "selected": self.selected.to("cpu", copy=True),
+                "meta": self.meta.to("cpu", copy=True)}
+
+
 _FP: Optional[StepFingerprints] = None
