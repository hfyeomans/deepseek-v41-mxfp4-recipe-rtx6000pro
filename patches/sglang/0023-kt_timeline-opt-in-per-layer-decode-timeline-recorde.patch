--- /dev/null
+++ b/python/sglang/srt/layers/moe/kt_timeline.py
@@ -0,0 +1,402 @@
+"""Opt-in per-layer decode timeline and MoE tensor dump (recipe T3.19a).
+
+Off unless ``KT_TIMELINE=1``. Log-only: nothing here changes what the model
+computes. The recorder answers one question per replayed step: where did the
+step's wall time go, per MoE layer and per graph segment / eager break?
+
+How it stays CUDA-graph safe
+----------------------------
+* Inside a capture the only calls are ``torch.cuda.Event.record()`` on events
+  created with ``external=True`` (a ``cudaEventRecordExternal`` node, which
+  records a real timestamp on every replay instead of becoming a capture-time
+  dependency) and ``copy_()`` into private buffers allocated once (memcpy
+  nodes). No host sync, no allocation after the first capture of a key.
+* Outside the capture, the replay loop (``BreakableCUDAGraph.replay``) records
+  ordinary timing events around every segment and break and takes
+  ``time.perf_counter_ns`` stamps. Every ``KT_TIMELINE_SAMPLE``-th replay of a
+  key is *sampled*: the stream is synchronized once at the end and all event
+  offsets are read and written as one JSON line. Non-sampled replays only pay
+  the host stamps (a few microseconds).
+
+Per MoE layer (rank 0; rank 1 has no kt work and shows only GPU experts and
+the all-reduce it waits for in ``combine``), the marks are
+
+    start -> export -> gpu -> sync -> h2d -> end
+
+    export      D2H of x / topk ids / weights into kt's pinned slot and the
+                submit host node (``BaseMoEWrapper.submit_forward``)
+    gpu_experts FlashInfer MXFP4 experts for the resident GPU experts
+    cpu_wait    exposed kt wait: the sync host node released only when the
+                CPU experts finished (``cpu_infer.sync_with_cuda_stream``)
+    h2d         pinned output -> device (``copy_forward_output_to_device``)
+    combine     ``output + cpu_output`` (+ B2 join when active)
+    cpu_total   sync - export: CPU expert compute incl. the part overlapped
+                by gpu_experts (derived, not a bucket)
+
+Sum identity checked by ``scripts/kt-timeline-report.py`` (recipe):
+    gpu_span = sum(segment) + sum(gap)             (one GPU timeline)
+    segment  = sum(MoE layer spans in it) + other  (attention, dense, norms,
+                                                    all-reduce, sampling head)
+    replay host wall >= gpu_span; the difference is host launch overhead.
+
+Env knobs (all read once at import):
+    KT_TIMELINE=1              enable
+    KT_TIMELINE_DIR            output dir inside the container (default
+                               /tmp/kt-timeline); bind-mount it out
+    KT_TIMELINE_SAMPLE=8       sample every N-th replay of a key
+    KT_TIMELINE_MAX_RECORDS    sampled records per key (default 256)
+    KT_TIMELINE_DUMP_LAYERS    MoE layer ids whose tensors are dumped (default
+                               "14,20"; "" disables)
+    KT_TIMELINE_DUMP_MAX=2     dumps per (key, layer)
+    KT_TIMELINE_DUMP_MAX_TOKENS=4  eager (non-graph) dumps only at <= this many
+                               tokens, so prefill chunks are never dumped
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import os
+import time
+from typing import Callable, Dict, List, Optional
+
+import torch
+
+logger = logging.getLogger(__name__)
+
+KT_TIMELINE = os.environ.get("KT_TIMELINE", "0") == "1"
+KT_TIMELINE_DIR = os.environ.get("KT_TIMELINE_DIR", "/tmp/kt-timeline")
+KT_TIMELINE_SAMPLE = max(1, int(os.environ.get("KT_TIMELINE_SAMPLE", "8")))
+KT_TIMELINE_MAX_RECORDS = int(os.environ.get("KT_TIMELINE_MAX_RECORDS", "256"))
+KT_TIMELINE_DUMP_MAX = int(os.environ.get("KT_TIMELINE_DUMP_MAX", "2"))
+KT_TIMELINE_DUMP_MAX_TOKENS = int(os.environ.get("KT_TIMELINE_DUMP_MAX_TOKENS", "4"))
+
+
+def _parse_layers(spec: str) -> frozenset:
+    out = set()
+    for part in spec.split(","):
+        part = part.strip()
+        if part:
+            out.add(int(part))
+    return frozenset(out)
+
+
+KT_TIMELINE_DUMP_LAYERS = _parse_layers(os.environ.get("KT_TIMELINE_DUMP_LAYERS", "14,20"))
+
+LAYER_MARKS = ("start", "export", "gpu", "sync", "h2d", "end")
+# (bucket, from-mark, to-mark)
+LAYER_BUCKETS = (
+    ("export", "start", "export"),
+    ("gpu_experts", "export", "gpu"),
+    ("cpu_wait", "gpu", "sync"),
+    ("h2d", "sync", "h2d"),
+    ("combine", "h2d", "end"),
+)
+
+
+def _new_event(external: bool) -> torch.cuda.Event:
+    return torch.cuda.Event(enable_timing=True, external=external)
+
+
+def _in_capture_mode() -> bool:
+    """SGLang's model_capture_mode() flag: also true for the eager warmup
+    forwards that precede each capture (dummy inputs, not worth dumping)."""
+    try:
+        from sglang.srt.model_executor.runner_utils import get_is_capture_mode
+    except Exception:  # pragma: no cover - layout differences
+        return False
+    return bool(get_is_capture_mode())
+
+
+class _StepRecorder:
+    """One replay of one key. Cheap unless ``sampled``."""
+
+    __slots__ = (
+        "tl", "key", "n", "sampled", "t0", "t_seg", "t_brk", "ev", "break_names",
+    )
+
+    def __init__(self, tl: "StepTimeline", key: str, n: int, sampled: bool, ev: Optional[dict]):
+        self.tl = tl
+        self.key = key
+        self.n = n
+        self.sampled = sampled
+        self.ev = ev
+        self.t0 = time.perf_counter_ns()
+        self.t_seg: List[List[int]] = []
+        self.t_brk: List[List[int]] = []
+        self.break_names: List[str] = []
+
+    def seg_start(self, i: int) -> None:
+        self.t_seg.append([time.perf_counter_ns(), 0])
+        if self.sampled:
+            self.ev["seg_start"][i].record()
+
+    def seg_end(self, i: int) -> None:
+        if self.sampled:
+            self.ev["seg_end"][i].record()
+        self.t_seg[i][1] = time.perf_counter_ns()
+
+    def break_start(self, i: int, name: str) -> None:
+        self.break_names.append(name)
+        self.t_brk.append([time.perf_counter_ns(), 0])
+
+    def break_end(self, i: int) -> None:
+        self.t_brk[i][1] = time.perf_counter_ns()
+
+    def finish(self) -> None:
+        t_end = time.perf_counter_ns()
+        self.tl._tick(self.key, self.n, self.t0, t_end)
+        if not self.sampled:
+            return
+        t_sync0 = time.perf_counter_ns()
+        torch.cuda.current_stream().synchronize()
+        t_sync1 = time.perf_counter_ns()
+        self.tl._write_sample(self, t_end, t_sync1 - t_sync0)
+
+
+class StepTimeline:
+    """Process-wide recorder; one per rank (see :func:`get_timeline`)."""
+
+    def __init__(self, rank: int):
+        self.rank = rank
+        self._capture_key: Optional[str] = None
+        # key -> layer_idx -> {mark: external Event recorded inside the graph}
+        self._layer_events: Dict[str, Dict[int, Dict[str, torch.cuda.Event]]] = {}
+        # key -> [(layer_idx, {name: private device buffer})] copied in-graph
+        self._dump_regs: Dict[str, List] = {}
+        # key -> replay-side events (created at first replay of the key)
+        self._replay_events: Dict[str, dict] = {}
+        self._replays: Dict[str, int] = {}
+        self._written: Dict[str, int] = {}
+        self._dumped: Dict[tuple, int] = {}
+        self._fh = None
+        self._ticks: List[dict] = []
+        os.makedirs(KT_TIMELINE_DIR, exist_ok=True)
+        self._path = os.path.join(KT_TIMELINE_DIR, f"timeline-rank{rank}.jsonl")
+        logger.info(
+            "[kt-timeline] enabled on TP%d: %s (sample every %d replays, dump layers %s)",
+            rank, self._path, KT_TIMELINE_SAMPLE, sorted(KT_TIMELINE_DUMP_LAYERS),
+        )
+
+    # ------------------------------------------------------------ capture side
+    def begin_capture(self, key: str) -> None:
+        assert self._capture_key is None, f"nested capture: {self._capture_key} -> {key}"
+        self._capture_key = key
+        self._layer_events[key] = {}
+        self._dump_regs[key] = []
+
+    def end_capture(self) -> None:
+        key = self._capture_key
+        self._capture_key = None
+        if key is not None:
+            logger.info(
+                "[kt-timeline] TP%d captured %s: %d MoE layers instrumented, %d dump layers",
+                self.rank, key, len(self._layer_events[key]), len(self._dump_regs[key]),
+            )
+
+    def layer_marker(self, layer_idx: int) -> Optional[Callable[[str], None]]:
+        """Callable ``mark(name)`` recording one of LAYER_MARKS for this layer,
+        or None when not capturing (eager forwards are not timed)."""
+        key = self._capture_key
+        if key is None:
+            return None
+        events = self._layer_events[key].get(layer_idx)
+        if events is None:
+            events = {m: _new_event(external=True) for m in LAYER_MARKS}
+            self._layer_events[key][layer_idx] = events
+
+        def mark(name: str) -> None:
+            events[name].record()
+
+        return mark
+
+    def dump_wanted(self, layer_idx: int, num_tokens: int) -> bool:
+        """True when this forward of ``layer_idx`` should be dumped: a capture
+        of a registered key, or an eager forward small enough to be a decode
+        step (never a prefill chunk, never a capture warmup)."""
+        if layer_idx not in KT_TIMELINE_DUMP_LAYERS:
+            return False
+        if self._capture_key is not None:
+            return True
+        if torch.cuda.is_current_stream_capturing() or _in_capture_mode():
+            return False
+        if num_tokens > KT_TIMELINE_DUMP_MAX_TOKENS:
+            return False
+        return self._dumped.get(("eager", layer_idx), 0) < KT_TIMELINE_DUMP_MAX
+
+    def dump_begin(self, layer_idx: int, tensors: Dict[str, torch.Tensor]) -> dict:
+        """Snapshot the layer's inputs (they are masked in place right after).
+        Capture: ``copy_`` into private buffers inside the graph, read back
+        after a sampled replay. Eager: device clones."""
+        return {"layer_idx": layer_idx, "tensors": self._snapshot(tensors)}
+
+    def dump_end(self, handle: dict, tensors: Dict[str, torch.Tensor]) -> None:
+        handle["tensors"].update(self._snapshot(tensors))
+        layer_idx = handle["layer_idx"]
+        key = self._capture_key
+        if key is not None:
+            self._dump_regs[key].append((layer_idx, handle["tensors"]))
+            return
+        x = handle["tensors"].get("hidden_states")
+        self._save_dump("eager", layer_idx, handle["tensors"], x.shape[0] if x is not None else -1)
+
+    @staticmethod
+    def _snapshot(tensors: Dict[str, torch.Tensor]) -> Dict[str, torch.Tensor]:
+        out = {}
+        for name, t in tensors.items():
+            if t is None:
+                continue
+            buf = torch.empty_like(t)
+            buf.copy_(t)
+            out[name] = buf
+        return out
+
+    def _save_dump(self, key: str, layer_idx: int, tensors: Dict[str, torch.Tensor], num_tokens: int) -> None:
+        k = (key, layer_idx)
+        n = self._dumped.get(k, 0)
+        if n >= KT_TIMELINE_DUMP_MAX:
+            return
+        self._dumped[k] = n + 1
+        safe_key = key.replace(":", "-")
+        path = os.path.join(
+            KT_TIMELINE_DIR, f"dump-rank{self.rank}-{safe_key}-layer{layer_idx}-{n}.pt"
+        )
+        payload = {
+            "key": key,
+            "layer_idx": layer_idx,
+            "rank": self.rank,
+            "num_tokens": int(num_tokens),
+            "tensors": {name: t.detach().to("cpu").clone() for name, t in tensors.items() if t is not None},
+        }
+        torch.save(payload, path)
+        logger.info("[kt-timeline] TP%d dumped %s layer %d -> %s", self.rank, key, layer_idx, path)
+
+    # ------------------------------------------------------------- replay side
+    def begin_step(self, key: str, n_segments: int, n_breaks: int) -> _StepRecorder:
+        n = self._replays.get(key, 0)
+        self._replays[key] = n + 1
+        sampled = (
+            n % KT_TIMELINE_SAMPLE == 0
+            and self._written.get(key, 0) < KT_TIMELINE_MAX_RECORDS
+        )
+        ev = None
+        if sampled:
+            ev = self._replay_events.get(key)
+            if ev is None or len(ev["seg_start"]) < n_segments:
+                ev = {
+                    "seg_start": [_new_event(False) for _ in range(n_segments)],
+                    "seg_end": [_new_event(False) for _ in range(n_segments)],
+                }
+                self._replay_events[key] = ev
+        return _StepRecorder(self, key, n, sampled, ev)
+
+    def _tick(self, key: str, n: int, t0: int, t1: int) -> None:
+        self._ticks.append({"t": "tick", "key": key, "n": n, "t0_ns": t0, "t1_ns": t1})
+        if len(self._ticks) >= 64:
+            self._flush_ticks()
+
+    def _flush_ticks(self) -> None:
+        if not self._ticks:
+            return
+        fh = self._file()
+        for rec in self._ticks:
+            fh.write(json.dumps(rec) + "\n")
+        self._ticks.clear()
+        fh.flush()
+
+    def _file(self):
+        if self._fh is None:
+            self._fh = open(self._path, "a")
+        return self._fh
+
+    def _write_sample(self, step: _StepRecorder, t_end_ns: int, sync_ns: int) -> None:
+        key, ev = step.key, step.ev
+        n_seg = len(step.t_seg)
+        origin = ev["seg_start"][0]
+        ms = lambda e: float(origin.elapsed_time(e))  # noqa: E731
+
+        segments = []
+        for i in range(n_seg):
+            s, e = ms(ev["seg_start"][i]), ms(ev["seg_end"][i])
+            segments.append({
+                "i": i, "gpu_start_ms": s, "gpu_end_ms": e, "gpu_ms": e - s,
+                "host_ms": (step.t_seg[i][1] - step.t_seg[i][0]) / 1e6,
+            })
+        gaps = []
+        for i in range(n_seg - 1):
+            gaps.append({
+                "after_segment": i,
+                "gpu_gap_ms": segments[i + 1]["gpu_start_ms"] - segments[i]["gpu_end_ms"],
+            })
+        breaks = []
+        for j, (b0, b1) in enumerate(step.t_brk):
+            breaks.append({
+                "i": j,
+                "name": step.break_names[j] if j < len(step.break_names) else "",
+                "host_ms": (b1 - b0) / 1e6,
+                "host_start_ms": (b0 - step.t0) / 1e6,
+                "gpu_gap_ms": gaps[j]["gpu_gap_ms"] if j < len(gaps) else None,
+            })
+
+        layers = []
+        for layer_idx in sorted(self._layer_events.get(key, {})):
+            evs = self._layer_events[key][layer_idx]
