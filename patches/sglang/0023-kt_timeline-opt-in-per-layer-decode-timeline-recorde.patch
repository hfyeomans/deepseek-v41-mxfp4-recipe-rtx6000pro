+    def _sync_timed(self, x: torch.Tensor, mark) -> Optional[torch.Tensor]:
+        """``sync`` with a timeline mark between the kt wait and the H2D copy.
+
+        Mirrors the CUDA branch of ``BaseMoEWrapper.sync_forward`` (kt-kernel
+        0.7.0.post4: ``cpu_infer.sync_with_cuda_stream(stream, allow_pending)``
+        then ``copy_forward_output_to_device``); the recipe's kt buffer test
+        asserts that order still holds in the installed kt_kernel. Used only
+        while a timeline capture is active (KT_TIMELINE=1), so the plain path
+        above stays byte-for-byte the qualified one. Ranks without kt work
+        (TP1) only record the two marks and return None, like the plain path
+        which never calls sync() there.
+        """
+        if self.tp_rank != 0 or self.wrapper is None:
+            mark("sync")
+            mark("h2d")
+            return None
+        w = self.wrapper
+        stream = torch.cuda.current_stream(x.device).cuda_stream
+        if os.environ.get("KT_FORCE_SYNC_SUBMIT", "") == "1":
+            # kt's synchronous fallback has a different wait; do not mirror it,
+            # time wait+H2D as one "sync" bucket instead.
+            out = w.sync_forward(x, stream)
+            mark("sync")
+            mark("h2d")
+            return out
+        allow_pending = 1 if w._layer_has_pending_deferred.get(w.layer_idx, False) else 0
+        w.cpu_infer.sync_with_cuda_stream(stream, allow_pending)
+        mark("sync")
+        out = w.copy_forward_output_to_device(x)
+        mark("h2d")
+        return out
