+def get_timeline(rank: Optional[int] = None) -> Optional[StepTimeline]:
+    """The rank's recorder, or None when KT_TIMELINE is off. The first call
+    must pass ``rank``; later calls may omit it."""
+    global _TIMELINE, _TIMELINE_RANK
