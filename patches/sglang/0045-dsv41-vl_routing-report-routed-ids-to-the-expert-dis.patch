From 755fe3f0dc2904a61ea1131303026c46c538ac69 Mon Sep 17 00:00:00 2001
From: Hank Yeomans <hank@quorra.ah.local>
Date: Sat, 10 Oct 2026 01:42:46 -0400
Subject: [PATCH 45/53] dsv41 vl_routing: report routed ids to the expert
 distribution recorder

DeepSeek-V4.1 routes through vision_topk (the gate has e_score_correction_bias_vl),
which bypasses select_experts and so never called on_select_experts: every
--expert-distribution-recorder-mode stat dump was all zeros. Report the routed
columns (not the fused shared slots) from both the CUDA and the torch branch.
No-op when the recorder mode is unset (Noop recorder); graph-safe scatter_add
when it is set.

Amp-Thread-ID: https://ampcode.com/threads/T-01a0c10b-a5f8-77fc-b238-7147d12ccf29
Co-authored-by: Amp <amp@ampcode.com>
---
 python/sglang/srt/multimodal/dsv41/vl_routing.py | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/python/sglang/srt/multimodal/dsv41/vl_routing.py b/python/sglang/srt/multimodal/dsv41/vl_routing.py
index abbe98fd..ba6eb5ae 100644
--- a/python/sglang/srt/multimodal/dsv41/vl_routing.py
+++ b/python/sglang/srt/multimodal/dsv41/vl_routing.py
@@ -1,6 +1,7 @@
 import torch
 import torch.nn.functional as F
 
+from sglang.srt.eplb.expert_distribution import get_global_expert_distribution_recorder
 from sglang.srt.layers.moe.topk import (
     _RENORMALIZE_SUM_EPSILON,
     StandardTopKOutput,
@@ -20,6 +21,18 @@ def _scale_fused_shared_weights(weights, num_fused_shared_experts, scaling_facto
     return weights
 
 
+def _record_routed_ids(indices, num_fused_shared_experts):
+    # select_experts() reports every routing decision to the expert
+    # distribution recorder; this path bypasses select_experts, so report here.
+    # Only the routed columns: fused shared slots (appended last) are not
+    # physical experts. Padded rows carry -1 and are masked by the recorder.
+    # No-op recorder when --expert-distribution-recorder-mode is unset.
+    routed = indices.shape[1] - num_fused_shared_experts
+    get_global_expert_distribution_recorder().on_select_experts(
+        topk_ids=indices[:, :routed]
+    )
+
+
 def vision_topk(moe, logits, input_ids, num_token_non_padded=None):
     config = moe.topk.topk_config
     num_fused_shared_experts = config.num_fused_shared_experts
@@ -52,6 +65,7 @@ def vision_topk(moe, logits, input_ids, num_token_non_padded=None):
             num_fused_shared_experts,
             config.fused_shared_experts_scaling_factor,
         )
+        _record_routed_ids(indices, num_fused_shared_experts)
         return StandardTopKOutput(weights, indices, logits)
     scores = F.softplus(logits.float()).sqrt()
     if input_ids is None:
@@ -89,4 +103,5 @@ def vision_topk(moe, logits, input_ids, num_token_non_padded=None):
     if num_token_non_padded is not None:
         _mask_topk_ids_padded_region(indices, num_token_non_padded)
         _zero_topk_weights_padded_region(weights, num_token_non_padded)
+    _record_routed_ids(indices, num_fused_shared_experts)
     return StandardTopKOutput(weights, indices, logits)
