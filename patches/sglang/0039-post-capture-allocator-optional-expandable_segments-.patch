             self.tp_worker.finalize_startup_weight_load()
diff --git a/python/sglang/srt/model_executor/post_capture_allocator.py b/python/sglang/srt/model_executor/post_capture_allocator.py
new file mode 100644
index 00000000..2dd0e346
--- /dev/null
+++ b/python/sglang/srt/model_executor/post_capture_allocator.py
@@ -0,0 +1,57 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Switch the CUDA caching allocator to expandable segments once CUDA graphs exist.
+
+Recipe T3.31 idea 8. Long-context prefill on the hybrid churns chunk-sized
+temporaries (hundreds of MiB each, a different mix per layer); with the
+default allocator the freed pieces end up as split blocks inside segments the
+allocator cannot release, and the next request OOMs with ~1 GiB "reserved but
+unallocated" (262K x 4 at chunk 8192: a 320 MiB request fails with 1.05 GiB
+cached). Expandable segments map physical pages into one growing virtual
+range instead, so freed pages can be unmapped and later requests of any size
+land in the same range.
+
+The setting is applied after graph capture, not at process start: the graph
+pools, weights and the KV pool stay in ordinary segments (cudaIpc-shareable,
+exactly what the captured graphs replay against) and only the segments created
+afterwards -- the prefill transients -- are expandable. `torch.cuda.empty_cache`
+runs first so the non-split cached segments from profiling and capture are
+released rather than reused, which is what makes the change bite.
+"""
+
+from __future__ import annotations
+
+import logging
+
+import torch
+
+from sglang.srt.environ import envs
+
+logger = logging.getLogger(__name__)
+
+
+def _set_allocator_settings(settings: str) -> None:
+    setter = getattr(torch._C, "_accelerator_setAllocatorSettings", None)
+    if setter is None:  # torch < 2.9
+        setter = torch.cuda.memory._set_allocator_settings
+    setter(settings)
+
+
+def maybe_enable_expandable_segments_after_capture(device: str) -> bool:
+    """Enable expandable segments for all future allocations; returns True when applied."""
+    if not envs.SGLANG_DSV41_EXPANDABLE_SEGMENTS_AFTER_CAPTURE.get():
+        return False
+    if not device.startswith("cuda"):
+        return False
+    torch.cuda.synchronize()
+    before = torch.cuda.memory_stats()
+    torch.cuda.empty_cache()
+    _set_allocator_settings("expandable_segments:True")
+    after = torch.cuda.memory_stats()
+    logger.info(
+        "expandable_segments enabled after graph capture (idea 8): reserved "
+        f"{before.get('reserved_bytes.all.current', 0) / 2**20:.0f} -> "
+        f"{after.get('reserved_bytes.all.current', 0) / 2**20:.0f} MiB, allocated "
+        f"{after.get('allocated_bytes.all.current', 0) / 2**20:.0f} MiB; segments "
+        "created from now on are expandable, existing ones are not"
+    )
+    return True
