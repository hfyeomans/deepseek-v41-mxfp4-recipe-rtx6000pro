--- a/python/sglang/srt/environ.py
+++ b/python/sglang/srt/environ.py
@@ -1438,6 +1438,11 @@ class Envs:
     # loading: cached checkpoint pages fragment host memory and starve the 512 MiB
     # huge-page faults. Costs the next restart its warm page cache.
     SGLANG_ENABLE_DSV41_ENGRAM_DROP_PAGE_CACHE = EnvBool(True)
+    # Recipe T3.31 idea 8: after CUDA-graph capture, empty the cache and switch the
+    # caching allocator to expandable segments so chunk-sized prefill temporaries
+    # stop fragmenting into "reserved but unallocated" blocks. Graph pools, weights
