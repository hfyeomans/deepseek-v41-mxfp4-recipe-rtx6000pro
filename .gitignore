# Local deployment state
.env
.cache/
*.log
__pycache__/
*.pyc
.DS_Store
results/
.firecrawl/
kernels/e13/mxf4_grouped_gemm_*
!kernels/e13/mxf4_grouped_gemm.cu

# Owner BIOS photographs (contain device labels / identifiers)
bios-pictures/
bios-pictures-2nd-pass/
bios-pictures-3rd-pass/
# Owner console/boot photographs (show the hostname)
*.heic
*.HEIC

# T3.8 round-2 raw recorder dumps (3.9 GB of per-pass [1000,40,384] int32 tensors; the summed counts are in analysis/counts-and-maps.json)
evidence/t38/round2/*/*.pt
evidence/t38b/histogram-el8-mix/*/*.pt
evidence/t38b/soak-default/*/*.pt
