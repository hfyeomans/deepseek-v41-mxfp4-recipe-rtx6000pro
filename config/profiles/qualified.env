# The qualified serve shape (T3.24a, 2026-10-10): what scripts/serve-hybrid.sh runs with an
# empty environment and what every headline number in docs/BENCHMARKS.md was measured on.
#
# Loaded by scripts/serve_config.py between the registry defaults and the environment:
#   registry default < this file < environment
# Every key must be a knob declared in scripts/serve_config.py (type, doc and evidence live
# there); `python3 scripts/serve_config.py check-profiles` (in ci.sh) fails if a value here
# differs from the registry default, so this file restates the deployment, it does not fork it.
# Override on top of it with the environment (the resolved line and the launch manifest then
# list the knob under overrides=[...]), or copy it to a new name and set PROFILE=<name>.
# `{repo}` expands to the recipe root. Unsafe knobs, EXTRA_* and diagnostics are refused here and
# in the environment under this profile (T3.24b): run those as PROFILE=developer.

# ---- expert placement and CPU tier (T3.28, T3.8b, E21, E26, E22) -----------------------
KT_NUM_GPU_EXPERTS=219
KT_EXPERT_MAP={repo}/config/expert-map-el8-mix-219.json
KT_CPUINFER=16
KT_MAX_DEFERRED=4
KT_GPU_PREFILL_MIN_TOKENS=1024

# ---- speculative decoding: off (E23, T3.40) -------------------------------------------
DSPARK=0
NGRAM=0

# ---- memory, context, prefill (E34, T3.29) --------------------------------------------
MEM_FRACTION_STATIC=0.96
CONTEXT_LENGTH=65536
MAX_RUNNING_REQUESTS=4
CHUNKED_PREFILL_SIZE=8192
SGLANG_LOGPROB_CHUNK_SIZE=512
CUDA_GRAPH_MAX_BS=4
CUDA_GRAPH_BS=1 2 3 4

# ---- Engram tables from the checkpoint shard on NVMe (E18, T3.20) ----------------------
ENGRAM_FILE_PREFETCH=ahead
ENGRAM_CHUNK_AHEAD=1

# ---- overlay levers (T3.31 idea 8, C10) -----------------------------------------------
SGLANG_DSV41_EXPANDABLE_SEGMENTS_AFTER_CAPTURE=1
KT_REJECT_NAN_ROWS=1
