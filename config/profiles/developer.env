# Developer profile (T3.24a/b): the qualified serve shape, and the only profile under which
# the guard bypasses, escape hatches and diagnostics may be set -- in this file or in the
# environment (ALLOW_UNTESTED_FIT, KT_ALLOW_UNSAFE_DEFERRAL, ALLOW_UNKNOWN_KNOBS, EXTRA_SERVER_ARGS,
# EXTRA_DOCKER_ENV, EXTRA_DOCKER_ARGS, KT_NAN_PROBE_MIN_TOKENS, KT_NAN_INJECT, KT_TIMELINE*, the
# SGLANG_BCG_DEBUG_* and KT_FORCE_SYNC_SUBMIT parity switches). It ships with none of them set: `python3 scripts/serve_config.py check-profiles` keeps every value here
# equal to the registry default, so an experiment is still an environment override on top of
# PROFILE=developer (and is listed under overrides=[...] in the resolved line and the manifest).
# Uncomment a line below only in a local copy that keeps the file name (PROFILE=/path/to/developer.env;
# the name is what grants the permission); do not commit it.
#
# Same rules as qualified.env: keys are registry knobs, `{repo}` expands to the recipe root.

# ---- expert placement and CPU tier -----------------------------------------------------
KT_NUM_GPU_EXPERTS=219
KT_EXPERT_MAP={repo}/config/expert-map-el8-mix-219.json
KT_CPUINFER=16
KT_MAX_DEFERRED=4
KT_GPU_PREFILL_MIN_TOKENS=1024

# ---- speculative decoding: off ----------------------------------------------------------
DSPARK=0
NGRAM=0

# ---- memory, context, prefill -----------------------------------------------------------
MEM_FRACTION_STATIC=0.96
CONTEXT_LENGTH=262144
MAX_RUNNING_REQUESTS=4
CHUNKED_PREFILL_SIZE=8192
SGLANG_LOGPROB_CHUNK_SIZE=512
CUDA_GRAPH_MAX_BS=4
CUDA_GRAPH_BS=1 2 3 4

# ---- Engram tables from the checkpoint shard on NVMe ------------------------------------
ENGRAM_FILE_PREFETCH=ahead
ENGRAM_CHUNK_AHEAD=1

# ---- overlay levers ---------------------------------------------------------------------
SGLANG_DSV41_EXPANDABLE_SEGMENTS_AFTER_CAPTURE=1
KT_REJECT_NAN_ROWS=1

# ---- developer-only (refused in every other profile) ------------------------------------
# ALLOW_UNTESTED_FIT=1
# KT_ALLOW_UNSAFE_DEFERRAL=1
# ALLOW_UNKNOWN_KNOBS=1
# EXTRA_SERVER_ARGS=--log-level debug
# EXTRA_DOCKER_ENV=CUDA_LAUNCH_BLOCKING=1
# EXTRA_DOCKER_ARGS=
# KT_NAN_PROBE_MIN_TOKENS=1
# KT_TIMELINE=1
