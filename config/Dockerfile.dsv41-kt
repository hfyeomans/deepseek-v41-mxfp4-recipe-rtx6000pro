# 2-GPU hybrid runtime image (E6 stage 2, T3.6a): upstream SGLang dev-dsv41 plus
# the KTransformers CPU expert kernel. See plan/E6-DESIGN.md §3 (Route 1) and
# PROVENANCE.md for why this pairing and these pins.
#
# Build:  docker build -f config/Dockerfile.dsv41-kt -t dsv41-kt:recipe config/
# Check:  docker run --rm --entrypoint python3 dsv41-kt:recipe /opt/recipe/kt_smoke.py
#
# --no-deps is deliberate. kt-kernel 0.7.0.post4 metadata pins torch==2.9.1, but the
# compiled extension links only gomp/hwloc/mvec/numa/udev (no libtorch, no
# libcudart), so it runs against the image's torch 2.13.0+cu130 unchanged.
# Verified 2026-09-21 in a throwaway container (T3.5b).
#
# The wheel is pruned before install. kt-kernel's wheel vendors a cu12 deep_gemm,
# sgl_kernel 0.3.21, triton_kernels, flash_attn_origin and mscclpp at top level;
# installing it whole overwrote the base image's cu13 deep_gemm and sgl-kernel
# 0.4.6.post1 and the first serve died at decode graph capture with
# "libnvrtc.so.12" (TROUBLESHOOTING.md). kt_kernel itself imports none of them.

ARG BASE=lmsysorg/sglang:dev-dsv41@sha256:4a5d132a06a77c8331e15845f2e925adc788b00105097ad55409afa3f4fa4860

# --- stage 1 (T3.39 window 2, K2): rebuild the one C++ extension variant this host
# uses (avx512_bf16) from the kt-kernel source the wheel was cut from, plus patch
# 0003 (caller-owned weight arena: MOEConfig.weight_arenas, weight_arena_bytes,
# weight_arena_layout). Same toolchain family as the wheel (g++ 13, CMake 3.31)
# and the wheel's own flag set (.github/workflows/release-pypi.yml at the pinned
# commit: CPUINFER_USE_CUDA=1 with static cudart and archs 80;86;89;90;120,
# cpptrace off, AMX/oneDNN off for the avx512_bf16 variant). USE_CUDA=1 only
# links cudart into the extension for the cudaLaunchHostFunc bridge
# (CPUInfer.submit/sync_with_cuda_stream) that decode graphs and layerwise
# prefill submit through; it compiles no device code of its own (kt-kernel/cuda
# is a separate package). The wheel's other five ISA variants stay as shipped.
# PROVENANCE.md has the source pin and checks.
FROM ${BASE} AS ktbuild
ARG KT_SOURCE_TAG=v0.7.0.post4
ARG KT_SOURCE_COMMIT=5632f7197e7a9898f0723755c2fc187a946a85a6
COPY kt-kernel-patches/0003-weight-arena.patch /tmp/0003-weight-arena.patch
RUN git clone --quiet --depth 1 --branch "${KT_SOURCE_TAG}" https://github.com/kvcache-ai/ktransformers /tmp/ktsrc \
 && cd /tmp/ktsrc \
 && test "$(git rev-parse HEAD)" = "${KT_SOURCE_COMMIT}" \
 && git submodule update --init --depth 1 third_party/pybind11 third_party/llama.cpp \
 && git apply --check /tmp/0003-weight-arena.patch && git apply /tmp/0003-weight-arena.patch \
 && cd kt-kernel \
 && CPUINFER_CPU_INSTRUCT=AVX512 CPUINFER_ENABLE_AVX512=ON CPUINFER_ENABLE_AVX512_VNNI=ON \
    CPUINFER_ENABLE_AVX512_BF16=ON CPUINFER_ENABLE_AVX512_VBMI=ON CPUINFER_ENABLE_AMX=OFF \
    CPUINFER_ENABLE_ONEDNN_VNNI=OFF CPUINFER_ENABLE_CPPTRACE=0 \
    CPUINFER_USE_CUDA=1 CPUINFER_CUDA_ARCHS="80;86;89;90;120" CPUINFER_CUDA_STATIC_RUNTIME=1 \
    CUDA_HOME=/usr/local/cuda CPUINFER_NATIVE=OFF CPUINFER_BUILD_TYPE=Release \
    python3 setup.py build_ext --inplace \
 && so="$(find /tmp/ktsrc/kt-kernel/build -name 'kt_kernel_ext.cpython-312-x86_64-linux-gnu.so' | head -1)" \
 && test -n "$so" && cp "$so" /tmp/_kt_kernel_ext_avx512_bf16.cpython-312-x86_64-linux-gnu.so

FROM ${BASE}

ARG KT_KERNEL_VERSION=0.7.0.post4
COPY prune_wheel.py /opt/recipe/prune_wheel.py
RUN pip download --no-cache-dir --no-deps -d /tmp/ktw "kt-kernel==${KT_KERNEL_VERSION}" \
 && python3 /opt/recipe/prune_wheel.py /tmp/ktw/kt_kernel-*.whl /tmp/ktw/pruned kt_kernel \
 && pip install --no-cache-dir --no-deps /tmp/ktw/pruned/kt_kernel-*.whl \
 && rm -rf /tmp/ktw

# kt-kernel source patches (E23 R3, T3.9g). 0001: KExpertsCPUBuffer temp-buffer
# lifetime — promote a temp buffer into the capture cache when its size is in
# capture_bs (else the bs=max verify graph bakes addresses the next eager call
# frees -> host segfault in cuGraphLaunch / Xid 31 CE write fault), and retire
# replaced temp buffers behind a CUDA event. Not upstream (kt issue #1815).
# 0002 (T3.16a, 2026-09-24): capture-time assertions - a size captured must be
# registered and already warmed (no allocation while capturing), a tuple a graph
# holds is never retired, set_capture_batch_sizes merges across graph runners
# instead of replacing. Tested by scripts/tests/run-kt-buffer-tests.sh.
# 0003 (T3.39 window 2) is C++ and is compiled into the extension in stage 1
# above; only the Python patches (0001, 0002) are applied to site-packages here.
COPY kt-kernel-patches /opt/recipe/kt-kernel-patches
RUN cd /opt/sglang/lib/python3.12/site-packages \
 && for p in /opt/recipe/kt-kernel-patches/000[12]-*.patch; do patch -p1 --forward < "$p"; done
COPY --from=ktbuild /tmp/_kt_kernel_ext_avx512_bf16.cpython-312-x86_64-linux-gnu.so \
     /opt/sglang/lib/python3.12/site-packages/kt_kernel/_kt_kernel_ext_avx512_bf16.cpython-312-x86_64-linux-gnu.so

COPY kt_smoke.py /opt/recipe/kt_smoke.py
RUN python3 /opt/recipe/kt_smoke.py

LABEL org.opencontainers.image.title="dsv41-kt" \
      org.opencontainers.image.description="SGLang dev-dsv41 + kt-kernel ${KT_KERNEL_VERSION} for the 2x RTX PRO 6000 hybrid" \
      recipe.kt_kernel.version="${KT_KERNEL_VERSION}"
