# Legacy all-GPU chain only (scripts/serve.sh via scripts/load-env.sh): copy to .env and edit.
# The qualified 2-GPU hybrid (scripts/serve-hybrid.sh) never reads .env - it takes its knobs
# from the environment and config/profiles/<PROFILE>.env (docs/CONFIG.md); GPU_DEVICES, PORT
# 8010 and the container name below do not apply to it. All paths absolute.

# Local snapshot of the pinned checkpoint (see PROVENANCE.md). download-model.sh
# writes RECIPE_PIN.txt here; preflight.sh checks it.
MODEL_DIR=/absolute/path/to/DeepSeek-V4.1-Flash
HF_CACHE_DIR=/absolute/path/to/hf-cache

# Physical GPU indices the container may use. The 4-GPU profile needs four.
GPU_DEVICES=0,1,2,3

# Serving
BIND_ADDRESS=127.0.0.1
PORT=8010
CONTAINER_NAME=dsv41-flash-rtxpro6000
SERVED_MODEL_NAME=deepseek-v4.1-flash-local

# Runtime image. Pin by digest once pulled: lmsysorg/sglang:dev-dsv41@sha256:...
RUNTIME_IMAGE=lmsysorg/sglang:dev-dsv41

# Profile: 4gpu-sglang (Option A, unqualified until P4) or 2gpu-attempt (E5 only)
PROFILE=4gpu-sglang
TP_SIZE=4
MAX_MODEL_LEN=262144
MEM_FRACTION_STATIC=0.90
CHUNKED_PREFILL_SIZE=8192
MAX_RUNNING_REQUESTS=8
DSPARK_K=5
KV_CACHE_DTYPE=auto

# Engram placement: dram (SGLANG_ENABLE_DSV41_ENGRAM_HOST_TABLE=1, needs ~190 GiB
# hugepages) or gpu (tables resident in VRAM; needs 4+ GPUs with headroom).
ENGRAM_PLACEMENT=dram
ENGRAM_HOST_TABLE_LAYOUT=shared

# Memory gate. preflight.sh runs feasibility-calc.py with these and refuses to
# launch when the checkpoint does not fit. Set ALLOW_UNQUALIFIED=1 only for E5.
GPU_RESERVE_GIB=4
HOST_RESERVE_GIB=24
ALLOW_UNQUALIFIED=0

NCCL_DEBUG=WARN
