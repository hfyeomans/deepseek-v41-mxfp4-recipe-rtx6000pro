+    def abandon(self, layer_idx: int, num_tokens: int) -> int:
+        """Close the forward early at ``layer_idx`` because the token count shrank.
+
+        Decoder SWA bounded replay (E35) runs the layers after the last kv_source
+        layer over only the last 128 tokens of each extend, so a streamed forward
+        that began with a chunk's tokens meets a layer with fewer; that layer and
+        the rest take the CPU path. The buffer holding ``layer_idx``'s export is
+        EXPORTING (claimed by the previous ``layer_end``): the coordinator must
+        wait for the export before the buffer is reused; returns that buffer.
+        """
+        self._check_layer(layer_idx)
+        if not self.open or layer_idx != self.expected_layer:
+            raise KTContractError(
+                f"[KT layerwise prefill] abandon({layer_idx}) while expecting "
+                f"{self.expected_layer if self.open else 'no forward'}"
+            )
+        if not 0 < int(num_tokens) < self.forward_tokens:
+            raise KTContractError(
+                f"[KT layerwise prefill] abandon({layer_idx}) with {num_tokens} tokens: only a forward "
+                f"whose token count shrank below its {self.forward_tokens} may close early"
+            )
+        b = self.buffers[self.current_buf]
+        if b.state is not BufferState.EXPORTING or b.layer != layer_idx:
+            raise KTContractError(
+                f"[KT layerwise prefill] abandon({layer_idx}): host buffer {self.current_buf} is "
+                f"{b.state.value} (layer {b.layer}), not exporting layer {layer_idx}"
+            )
+        self.forward_tokens = None
+        self.expected_layer = None
+        self.forwards_completed += 1
+        return self.current_buf
+
+    def export_discarded(self, buf: int) -> None:
+        """Rank 0 synced an abandoned export: the buffer holds nothing anyone will read."""
+        b = self.buffers[buf]
+        if b.state is not BufferState.EXPORTING:
+            raise KTContractError(
+                f"[KT layerwise prefill] export_discarded on host buffer {buf} in state {b.state.value}"
+            )
+        b.state, b.layer = BufferState.FREE, None
+
