# Developer profile: the qualified serve shape, and the ONLY profile under which the guard
# bypasses, escape hatches and diagnostics may be set (in this file or in the environment).
# It ships with none of them set: `python3 scripts/serve_config.py check-profiles` keeps every
# value here equal to the registry default, so an experiment is still an environment override on
# top of PROFILE=developer (and is listed under overrides=[...] in the resolved line and the
# manifest). Uncomment a line below only in a local copy that keeps the file name
# (PROFILE=/path/to/developer.env; the name is what grants the permission); do not commit it.
#
# Same rules as qualified.env: keys are registry knobs, `{repo}` expands to the recipe root.

# ---- identity ----------------------------------------------------------------
MODEL_DIR=/models/<org>/<model>
SNAPSHOT=<40-hex-sha>
SERVED_MODEL_NAME=<model>-local

# ---- memory / context / slots -------------------------------------------------
MEM_FRACTION_STATIC=0.95
CONTEXT_LENGTH=32768
MAX_RUNNING_REQUESTS=4
CHUNKED_PREFILL_SIZE=4096
CUDA_GRAPH_MAX_BS=4
CUDA_GRAPH_BS=1 2 3 4

# ---- speculation: off until gated ---------------------------------------------
SPEC_ENABLE=0
SPEC_DRAFT_TOKENS=5

# ---- host threads --------------------------------------------------------------
HOST_THREAD_CPUS=auto

# ---- developer-only (refused in every other profile) ---------------------------
# ALLOW_UNTESTED_FIT=1
# ALLOW_UNKNOWN_KNOBS=1
# EXTRA_SERVER_ARGS=--log-level debug
# EXTRA_DOCKER_ENV=
# EXTRA_DOCKER_ARGS=
