# The qualified serve shape: what scripts/serve.sh runs with an empty environment and what every
# headline number in docs/BENCHMARKS.md was measured on.
#
# Loaded by scripts/serve_config.py between the registry defaults and the environment:
#   registry default < this file < environment
# Every key must be a knob declared in scripts/serve_config.py (type, doc and evidence live there);
# `python3 scripts/serve_config.py check-profiles` (run by scripts/ci.sh) fails if a value here
# differs from the registry default, so this file restates the deployment, it does not fork it.
# Override on top of it with the environment (the resolved line and the launch manifest then list
# the knob under overrides=[...]), or copy it to a new name and set PROFILE=<name>.
# `{repo}` expands to the recipe root. Unsafe knobs, EXTRA_* and diagnostics are refused here and
# in the environment under this profile: run those as PROFILE=developer.

# ---- identity ----------------------------------------------------------------
MODEL_DIR=/models/<org>/<model>
SNAPSHOT=<40-hex-sha>
SERVED_MODEL_NAME=<model>-local

# ---- memory / context / slots -------------------------------------------------
MEM_FRACTION_STATIC=0.95
CONTEXT_LENGTH=32768
MAX_RUNNING_REQUESTS=4
CHUNKED_PREFILL_SIZE=4096
CUDA_GRAPH_MAX_BS=4
CUDA_GRAPH_BS=1 2 3 4

# ---- speculation: off until gated ---------------------------------------------
SPEC_ENABLE=0
SPEC_DRAFT_TOKENS=5

# ---- host threads --------------------------------------------------------------
HOST_THREAD_CPUS=auto
